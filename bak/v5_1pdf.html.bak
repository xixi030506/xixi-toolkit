    let toastTimer = null;
    function showToast(msg, type = 'info') {
      if (toastTimer) clearTimeout(toastTimer);
      els.toastContainer.innerHTML = '';

      const colors = {
        info: 'bg-rose-500 text-white border-rose-600',
        success: 'bg-emerald-500 text-white border-emerald-600',
        warn: 'bg-amber-400 text-amber-950 border-amber-500'
      };
      const div = document.createElement('div');
      div.className = `px-4 py-2.5 rounded-2xl border-2 shadow-lg text-xs font-extrabold transition-all duration-200 transform translate-y-2 opacity-0 cursor-pointer ${colors[type] || colors.info}`;
      div.textContent = msg;
      div.addEventListener('click', () => div.remove());
      els.toastContainer.appendChild(div);

      requestAnimationFrame(() => {
        div.classList.remove('translate-y-2', 'opacity-0');
      });

      toastTimer = setTimeout(() => {
        div.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => {
          if (div.parentNode) div.remove();
        }, 220);
      }, 1700);
    }

    // 本地存储与本地文件夹贴纸持久化
    const STORAGE_KEY = 'xixi_watermark_studio_v5_prefs';
    const STICKER_FILE_NAME = '西西自定义样式库.json';

    function serializeStyleSnapshot(g) {
      return {
        watermarkText: g.watermarkText,
        enableText: g.enableText,
        hollowText: g.hollowText,
        enableStamp: g.enableStamp,
        stampType: g.stampType === 'custom' ? 'paw' : g.stampType,
        stampScale: g.stampScale,
        fontFamily: g.fontFamily,
        color: g.color,
        colorName: g.colorName,
        fontSize: g.fontSize,
        opacity: g.opacity,
        angle: g.angle,
        gap: g.gap,
        offsetX: g.offsetX,
        offsetY: g.offsetY,
        rowGapScale: g.rowGapScale,
        staggerRow: g.staggerRow,
        simpleRecActive: g.simpleRecActive || '',
        coverageMode: g.coverageMode,
        gridKey: g.gridKey || `${g.gridCols || 3}x${g.gridRows || 3}`,
        gridCols: g.gridCols || 3,
        gridRows: g.gridRows || 3,
        groupCount: g.groupCount || 1,
        gridCells: [...(g.gridCells || [])],
        smartMergeBand: g.smartMergeBand,
        smoothStyle: g.smoothStyle || 'concave',
        perGroupSmooth: g.perGroupSmooth !== false,
        groupSmoothStyles: { ...(g.groupSmoothStyles || { 1: g.smoothStyle || 'concave' }) },
        smoothRadius: g.smoothRadius,
        singlePerZone: g.singlePerZone,
        boxTop: g.boxTop,
        boxBottom: g.boxBottom,
        boxLeft: g.boxLeft,
        boxRight: g.boxRight,
        boxInvert: g.boxInvert,
        snapGrid: g.snapGrid,
        symLock: g.symLock,
        pageRangeMode: g.pageRangeMode,
        customPageRange: g.customPageRange
      };
    }

    const SUBFOLDER_IMGS_CACHE_KEY = 'xixi_subfolder_images_cache_v9';

    function saveSubfolderImagesCache() {
      try {
        const lightList = state.subfolderImages.slice(0, 15).map(item => ({
          name: item.name,
          dataUrl: item.dataUrl
        }));
        localStorage.setItem(SUBFOLDER_IMGS_CACHE_KEY, JSON.stringify(lightList));
      } catch (e) {}
    }

    async function loadSubfolderImagesCache() {
      try {
        const raw = localStorage.getItem(SUBFOLDER_IMGS_CACHE_KEY);
        if (raw) {
          const arr = JSON.parse(raw);
          if (Array.isArray(arr)) {
            for (const item of arr) {
              if (item && item.name && item.dataUrl && !state.subfolderImages.some(x => x.name === item.name)) {
                const imgEl = new Image();
                imgEl.src = item.dataUrl;
                state.subfolderImages.push({ name: item.name, dataUrl: item.dataUrl, imgEl });
              }
            }
          }
        }
      } catch (e) {}
      // 若运行在桌面启动器环境 (pywebview)，自动拉取同级「自定义图片」子文件夹内的所有贴纸
      if (hasNativeDesktopBridge() && typeof window.pywebview.api.list_subfolder_images === 'function') {
        try {
          const list = await window.pywebview.api.list_subfolder_images();
          if (Array.isArray(list)) {
            for (const item of list) {
              if (item && item.name && item.dataUrl) {
                const imgEl = new Image();
                imgEl.src = item.dataUrl;
                const existingIdx = state.subfolderImages.findIndex(x => x.name === item.name);
                if (existingIdx >= 0) {
                  state.subfolderImages[existingIdx] = { name: item.name, dataUrl: item.dataUrl, imgEl };
                } else {
                  state.subfolderImages.push({ name: item.name, dataUrl: item.dataUrl, imgEl });
                }
              }
            }
          }
        } catch (e) {}
      }
      refreshBuiltinStampSelectOptions();
      renderCustomImgSubfolderMenu();
    }

    let nativePrefsSyncTimer = null;
    const HISTORY_LOCAL_CACHE_KEY = 'xixi_watermark_history_v11';

    function saveHistoryToLocalCache() {
      try {
        const lightHistory = (state.historyRecords || []).slice(0, 80).map(r => ({
          id: r.id,
          fileName: r.fileName,
          originalName: r.originalName,
          savedPath: r.savedPath,
          dirPath: r.dirPath,
          timestamp: r.timestamp,
          status: r.status || (r.revoked ? 'revoked' : 'saved'),
          revoked: Boolean(r.revoked || r.status === 'revoked'),
          origBackupName: r.origBackupName || '',
          profileLabel: r.profileLabel || '',
          isZip: Boolean(r.isZip),
          saveModeLabel: r.saveModeLabel || '快速保存'
        }));
        localStorage.setItem(HISTORY_LOCAL_CACHE_KEY, JSON.stringify(lightHistory));
      } catch (e) {}
    }

    function loadHistoryFromLocalCache() {
      try {
        const raw = localStorage.getItem(HISTORY_LOCAL_CACHE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && state.historyRecords.length === 0) {
            state.historyRecords = parsed;
          }
        }
      } catch (e) {}
    }

    function computeDefaultZipName() {
      if (state.files && state.files.length > 0) {
        const firstRaw = (state.files[0].name || '水印文档').replace(/\.(pdf|docx)$/i, '').trim();
        const first4 = firstRaw.slice(0, 4) || '水印文档';
        return `${first4}等${state.files.length}个水印压缩包`;
      }
      return '功能说明等2页水印压缩包';
    }

    function syncDynamicZipFolderName() {
      if (!els.virtualFolderName || state.userEditedZipName) return;
      const autoName = computeDefaultZipName();
      els.virtualFolderName.value = autoName;
      state.virtualFolderName = autoName;
    }

    function savePrefsToStorage() {
      try {
        const payload = {
          uiMode: state.uiMode,
          activeProfileIndex: state.activeProfileIndex,
          profiles: state.globalProfiles.map(serializeStyleSnapshot),
          customSuffix: state.customSuffix,
          noSuffix: Boolean(state.noSuffix),
          defaultLockBurn: Boolean(state.defaultLockBurn),
          wordLockMode: state.wordLockMode || 'sdt',
          defaultSaveMode: (state.defaultSaveMode && state.defaultSaveMode !== 'downloads') ? state.defaultSaveMode : 'plugin_export',
          defaultSaveDir: state.defaultSaveDir || '',
          firstRunCompleted: Boolean(state.firstRunCompleted)
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
        if (hasNativeDesktopBridge() && typeof window.pywebview.api.save_plugin_prefs === 'function') {
          if (nativePrefsSyncTimer) clearTimeout(nativePrefsSyncTimer);
          nativePrefsSyncTimer = setTimeout(() => {
            try { window.pywebview.api.save_plugin_prefs(payload); } catch (e) {}
          }, 220);
        }
      } catch (e) {}
    }

    // 获取或创建同级目录下的子文件夹句柄 ('自定义样式' 或 '自定义图片')
    async function ensureSubfolderHandle(subfolderName, promptIfUnbound = false) {
      if (!state.directoryHandle && promptIfUnbound && typeof window.showDirectoryPicker === 'function') {
        try {
          const picked = await window.showDirectoryPicker({ mode: 'readwrite' });
          await bindProjectDirectoryHandle(picked);
        } catch (err) {
          return null;
        }
      }
      if (!state.directoryHandle) return null;
      try {
        if (state.directoryHandle.name === subfolderName) {
          return state.directoryHandle;
        }
        return await state.directoryHandle.getDirectoryHandle(subfolderName, { create: true });
      } catch (e) {
        return null;
      }
    }

    // 绑定同级目录并自动初始化「自定义样式」与「自定义图片」两个子文件夹
    async function bindProjectDirectoryHandle(handle) {
      if (!handle) return;
      state.directoryHandle = handle;
      if (handle.name === '自定义样式') {
        state.styleSubfolderHandle = handle;
      } else if (handle.name === '自定义图片') {
        state.imageSubfolderHandle = handle;
      } else {
        try {
          state.styleSubfolderHandle = await handle.getDirectoryHandle('自定义样式', { create: true });
        } catch (e) {}
        try {
          state.imageSubfolderHandle = await handle.getDirectoryHandle('自定义图片', { create: true });
        } catch (e) {}
      }
      els.selectedFolderText.textContent = `✅ 已绑定同级目录：「${handle.name}」（已直连「自定义样式」与「自定义图片」子文件夹）`;
      if (els.subfolderBindBadge) {
        els.subfolderBindBadge.textContent = `✅ 已直连：${handle.name} / 自定义样式 & 自定义图片`;
        els.subfolderBindBadge.className = 'text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-300 font-bold';
      }
      await loadStickersFromBoundFolder();
      await scanSubfolderImages();
    }

    // 扫描「自定义图片」子文件夹中的所有 PNG/JPG/SVG/WEBP 贴纸图片，并更新单列折叠菜单与下拉框
    async function scanSubfolderImages() {
      const imgDir = state.imageSubfolderHandle || await ensureSubfolderHandle('自定义图片', false);
      if (!imgDir || typeof imgDir.values !== 'function') {
        renderCustomImgSubfolderMenu();
        return;
      }
      const loadedMap = new Map();
      state.subfolderImages.forEach(item => loadedMap.set(item.name, item));
      try {
        for await (const entry of imgDir.values()) {
          if (entry.kind === 'file' && /\.(png|jpe?g|webp|svg)$/i.test(entry.name)) {
            const file = await entry.getFile();
            const dataUrl = await new Promise(res => {
              const r = new FileReader();
              r.onload = ev => res(ev.target.result);
              r.readAsDataURL(file);
            });
            const imgEl = new Image();
            await new Promise(res => {
              imgEl.onload = res;
              imgEl.onerror = res;
              imgEl.src = dataUrl;
            });
            loadedMap.set(entry.name, { name: entry.name, dataUrl, imgEl });
          }
        }
      } catch (e) {}
      state.subfolderImages = Array.from(loadedMap.values());
      saveSubfolderImagesCache();
      refreshBuiltinStampSelectOptions();
      renderCustomImgSubfolderMenu();
    }

    // 渲染「📂 选自定义图片」折叠单列菜单中的「自定义图片」子文件夹内容列表
    function renderCustomImgSubfolderMenu() {
      if (!els.customImgSubfolderList) return;
      els.customImgSubfolderList.innerHTML = '';
      const s = getActiveStyle();
      const curType = s.stampType || 'paw';

      if (state.subfolderImages.length === 0) {
        const emptyDiv = document.createElement('div');
        emptyDiv.className = 'py-2.5 px-2 text-center rounded-lg bg-amber-50/60 border border-dashed border-amber-200 text-[11px] text-amber-800';
        emptyDiv.innerHTML = '子文件夹暂无已缓存贴纸 · 可点上方<b>「💻 自选位置」</b>挑图后点「💾 存到自定义图片夹」，或点右上角<b>「🔄 刷新/读取子夹」</b>导入！';
        els.customImgSubfolderList.appendChild(emptyDiv);
        return;
      }

      state.subfolderImages.forEach((item, idx) => {
        const isSel = (s.enableStamp && curType === `subimg:${item.name}`);
        const row = document.createElement('div');
        row.className = `w-full px-2.5 py-1.5 rounded-lg border flex items-center justify-between gap-2 transition cursor-pointer ${
          isSel
            ? 'bg-rose-500 text-white border-rose-600 font-extrabold shadow-2xs'
            : 'bg-amber-50/40 hover:bg-rose-50 text-rose-950 border-amber-200 font-bold'
        }`;

        const leftBtn = document.createElement('div');
        leftBtn.className = 'flex items-center gap-2 min-w-0 flex-1';
        leftBtn.innerHTML = `
          <img src="${item.dataUrl}" alt="${item.name}" class="w-6 h-6 rounded bg-white border border-rose-200 object-contain shrink-0" />
          <span class="text-xs truncate">${isSel ? '✔ ' : ''}${item.name}</span>
        `;
        leftBtn.addEventListener('click', () => {
          s.enableStamp = true;
          s.stampType = `subimg:${item.name}`;
          state.customImgMenuOpen = false;
          if (els.customImgDropdownMenu) els.customImgDropdownMenu.classList.add('hidden');
          if (els.customImgMenuArrow) els.customImgMenuArrow.textContent = '▾';
          syncControlsFromActiveStyle();
          showToast(`🐾 已切换子文件夹贴纸：「${item.name}」！`, 'success');
        });

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = `px-1.5 py-0.5 rounded text-[10px] font-black shrink-0 ${
          isSel ? 'text-white/80 hover:bg-white/20' : 'text-rose-400 hover:text-rose-700 hover:bg-rose-100'
        }`;
        delBtn.textContent = '×';
        delBtn.title = '从子文件夹快捷列表中移除';
        delBtn.addEventListener('click', async e => {
          e.stopPropagation();
          const removed = state.subfolderImages.splice(idx, 1)[0];
          if (removed && hasNativeDesktopBridge() && typeof window.pywebview.api.delete_subfolder_image === 'function') {
            try { await window.pywebview.api.delete_subfolder_image(removed.name); } catch (err) {}
          } else if (removed && state.imageSubfolderHandle && typeof state.imageSubfolderHandle.removeEntry === 'function') {
            try { await state.imageSubfolderHandle.removeEntry(removed.name); } catch (err) {}
          }
          if (s.stampType === `subimg:${removed.name}`) {
            s.stampType = 'paw';
          }
          saveSubfolderImagesCache();
          syncControlsFromActiveStyle();
          renderCustomImgSubfolderMenu();
          showToast(`🗑️ 已移除贴纸「${removed.name}」`, 'info');
        });

        row.appendChild(leftBtn);
        row.appendChild(delBtn);
        els.customImgSubfolderList.appendChild(row);
      });
    }

    // 校验导入的 JSON 是否为本软件导出的合法样式格式
    function isValidXixiStyleSnapshot(snap) {
      if (!snap || typeof snap !== 'object') return false;
      return (typeof snap.fontSize === 'number' || typeof snap.opacity === 'number' || Array.isArray(snap.gridCells) || typeof snap.coverageMode === 'string');
    }

    // 渲染「📂 载入样式」折叠单列菜单中的「自定义样式」子文件夹内容列表
    function renderStyleImportSubfolderMenu() {
      if (!els.styleImportSubfolderList) return;
      els.styleImportSubfolderList.innerHTML = '';

      const folderList = state.folderStyleStickers || [];
      if (folderList.length === 0) {
        const emptyDiv = document.createElement('div');
        emptyDiv.className = 'py-2.5 px-2 text-center rounded-lg bg-rose-50/60 border border-dashed border-rose-200 text-[11px] text-rose-700';
        emptyDiv.innerHTML = '「自定义样式」文件夹内暂无已保存样式 · 可点「💾 存到『自定义样式』夹」永久存入，或点右上角<b>「🔄 刷新/读取子夹」</b>扫描！';
        els.styleImportSubfolderList.appendChild(emptyDiv);
        return;
      }

      folderList.forEach(st => {
        const snap = st.snapshot || {};
        const detail = `${snap.fontSize || 28}px · ${snap.angle !== undefined ? snap.angle : -30}° · ${snap.opacity || 20}%透明`;
        const row = document.createElement('button');
        row.type = 'button';
        row.className = 'w-full px-3 py-1.5 rounded-lg bg-rose-50/50 hover:bg-rose-100 text-rose-950 border border-rose-200 flex items-center justify-between gap-2 text-left transition cursor-pointer';
        row.innerHTML = `
          <span class="text-xs font-extrabold truncate">${st.name}</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-white text-rose-600 border border-rose-200 font-bold shrink-0">${detail}</span>
        `;
        row.addEventListener('click', () => {
          const s = getActiveStyle();
          if (st.snapshot) {
            Object.keys(st.snapshot).forEach(k => {
              if (k === 'gridCells') {
                s.gridKey = st.snapshot.gridKey || '3x3';
                s.gridCols = st.snapshot.gridCols || 3;
                s.gridRows = st.snapshot.gridRows || 3;
                s.gridCells = [...st.snapshot.gridCells];
              } else {
                s[k] = st.snapshot[k];
              }
            });
          }
          // 将从文件夹载入的样式同步放入当前软件界面标签栏（方便本次会话内随时切换）
          const existIdx = state.styleStickers.findIndex(x => x.name === st.name);
          if (existIdx >= 0) {
            state.styleStickers[existIdx] = { ...st, fromFolder: true };
          } else {
            state.styleStickers.push({ ...st, fromFolder: true });
          }
          renderStyleStickers();
          state.styleImportMenuOpen = false;
          if (els.styleImportDropdownMenu) els.styleImportDropdownMenu.classList.add('hidden');
          if (els.styleImportMenuArrow) els.styleImportMenuArrow.textContent = '▾';
          syncControlsFromActiveStyle();
          showToast(`✨ 已从「自定义样式」文件夹载入并套用：「${st.name}」！`, 'success');
        });
        els.styleImportSubfolderList.appendChild(row);
      });
    }

    function refreshBuiltinStampSelectOptions() {
      const s = getActiveStyle();
      const curVal = s.stampType || 'paw';
      let html = `
        <option value="paw">🐾 默认猫爪章 (内置)</option>
        <option value="custom">🖼️ 临时自定义贴纸${s.customStampName ? ' (' + s.customStampName.slice(0, 8) + ')' : ''}</option>
      `;
      if (state.subfolderImages.length > 0) {
        html += `<optgroup label="📂 「自定义图片」子文件夹 (${state.subfolderImages.length}张)">`;
        state.subfolderImages.forEach(item => {
          html += `<option value="subimg:${item.name}">📁 ${item.name}</option>`;
        });
        html += `</optgroup>`;
      }
      html += `<option value="none">🚫 不选图案</option>`;
      els.builtinStampSelect.innerHTML = html;
      if ([...els.builtinStampSelect.options].some(o => o.value === curVal)) {
        els.builtinStampSelect.value = curVal;
      }
      renderCustomImgSubfolderMenu();
    }

    // 第二个按钮专用：将自定义样式永久写入同级目录的固定子文件夹「自定义样式/」内
    async function syncStickersToBoundFolder(silent = false, promptIfUnbound = false, singleSticker = null) {
      const listToSave = singleSticker ? [singleSticker] : state.styleStickers;
      if (hasNativeDesktopBridge() && typeof window.pywebview.api.save_subfolder_styles === 'function') {
        try {
          const ret = await window.pywebview.api.save_subfolder_styles(listToSave, singleSticker);
          if (ret && ret.ok) {
            if (Array.isArray(ret.styles)) {
              state.folderStyleStickers = ret.styles;
            }
            renderStyleImportSubfolderMenu();
            if (!silent) {
              const targetLabel = singleSticker ? `「${singleSticker.name}」` : `共 ${listToSave.length} 款样式`;
              showToast(`💾 已永久存入同级「自定义样式」子文件夹：${targetLabel}！`, 'success');
            }
            return true;
          }
        } catch (e) {}
      }
      const styleDir = state.styleSubfolderHandle || await ensureSubfolderHandle('自定义样式', promptIfUnbound);
      if (!styleDir) return false;
      state.styleSubfolderHandle = styleDir;
      try {
        const toWriteList = singleSticker ? [singleSticker] : state.styleStickers;
        for (const st of toWriteList) {
          const safeName = (st.name || '西西样式').replace(/^📌\s*|^✨\s*/g, '').replace(/[\/:*?"<>|]/g, '_').trim() || '西西自定义样式';
          const singleFileName = safeName.endsWith('.json') ? safeName : `${safeName}.json`;
          const fHandle = await styleDir.getFileHandle(singleFileName, { create: true });
          const fWritable = await fHandle.createWritable();
          await fWritable.write(JSON.stringify({
            app: '西西盖章局 V5',
            format: 'xixi_stamp_style_v5',
            name: st.name,
            snapshot: st.snapshot,
            savedAt: new Date().toISOString()
          }, null, 2));
          await fWritable.close();

          const existIdx = state.folderStyleStickers.findIndex(x => x.name === st.name);
          if (existIdx >= 0) {
            state.folderStyleStickers[existIdx] = st;
          } else {
            state.folderStyleStickers.push(st);
          }
        }
        renderStyleImportSubfolderMenu();
        if (!silent) {
          showToast(`💾 已存入同级子文件夹「自定义样式/」！`, 'success');
        }
        return true;
      } catch (e) {
        return false;
      }
    }

    async function loadStickersFromBoundFolder(silent = false) {
      if (hasNativeDesktopBridge() && typeof window.pywebview.api.list_subfolder_styles === 'function') {
        try {
          const list = await window.pywebview.api.list_subfolder_styles();
          if (Array.isArray(list)) {
            state.folderStyleStickers = list.filter(st => st && st.name && isValidXixiStyleSnapshot(st.snapshot));
            renderStyleImportSubfolderMenu();
            if (!silent) {
              showToast(`📂 已刷新「自定义样式」文件夹（共读取到 ${state.folderStyleStickers.length} 款本软件专属样式）！`, 'success');
            }
            return;
          }
        } catch (e) {}
      }
      const styleDir = state.styleSubfolderHandle || await ensureSubfolderHandle('自定义样式', false);
      if (!styleDir) return;
      const loadedMap = new Map();
      try {
        try {
          const fileHandle = await styleDir.getFileHandle(STICKER_FILE_NAME, { create: false });
          const file = await fileHandle.getFile();
          const data = JSON.parse(await file.text());
          if (data && Array.isArray(data.stickers)) {
            data.stickers.forEach(st => {
              if (st && st.name && isValidXixiStyleSnapshot(st.snapshot)) loadedMap.set(st.name, st);
            });
          }
        } catch (e) {}
        if (typeof styleDir.values === 'function') {
          for await (const entry of styleDir.values()) {
            if (entry.kind === 'file' && entry.name.endsWith('.json') && entry.name !== STICKER_FILE_NAME) {
              try {
                const f = await entry.getFile();
                const parsed = JSON.parse(await f.text());
                if (parsed && isValidXixiStyleSnapshot(parsed.snapshot)) {
                  const stName = parsed.name || `📌 ${entry.name.replace(/\.json$/i, '')}`;
                  loadedMap.set(stName, {
                    id: parsed.id || ('stk_' + entry.name),
                    name: stName,
                    snapshot: parsed.snapshot
                  });
                }
              } catch (e) {}
            }
          }
        }
        state.folderStyleStickers = Array.from(loadedMap.values());
        renderStyleImportSubfolderMenu();
        if (!silent) {
          showToast(`📂 已读取「自定义样式」文件夹（共 ${state.folderStyleStickers.length} 款样式）！`, 'success');
        }
      } catch (e) {}
    }

    function loadPrefsFromStorage() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const data = JSON.parse(raw);
        if (!data || typeof data !== 'object') return;
        // 需求3：每次打开 HTML 默认进入「🌸 普通模式」且默认激活方案①全屏满铺预设，避免点进来停留在高级模式
        state.uiMode = 'simple';
        state.activeProfileIndex = 0;
        if (Array.isArray(data.profiles) && data.profiles.length === 3) {
          data.profiles.forEach((saved, idx) => {
            if (!saved || typeof saved !== 'object') return;
            const target = state.globalProfiles[idx];
            Object.keys(saved).forEach(k => {
              if (k === 'gridCells') {
                const cols = saved.gridCols || 3;
                const rows = saved.gridRows || 3;
                if (Array.isArray(saved.gridCells) && saved.gridCells.length === cols * rows) {
                  target.gridCells = saved.gridCells.map(v => Number(v) || 0);
                }
              } else if (saved[k] !== undefined) {
                target[k] = saved[k];
              }
            });
          });
        }
        // 临时样式仅在单次会话有效，重启不从缓存恢复
        if (typeof data.customSuffix === 'string') {
          state.customSuffix = data.customSuffix;
          els.customSuffixInput.value = data.customSuffix;
        }
        if (typeof data.noSuffix === 'boolean') {
          state.noSuffix = data.noSuffix;
          if (els.noSuffixToggle) els.noSuffixToggle.checked = state.noSuffix;
        }
        if (typeof data.defaultLockBurn === 'boolean') {
          state.defaultLockBurn = data.defaultLockBurn;
        }
        if (typeof data.wordLockMode === 'string') {
          state.wordLockMode = data.wordLockMode;
        }
        if (typeof data.defaultSaveMode === 'string') {
          state.defaultSaveMode = data.defaultSaveMode;
        }
        if (typeof data.defaultSaveDir === 'string') {
          state.defaultSaveDir = data.defaultSaveDir;
        }
        if (typeof data.firstRunCompleted === 'boolean') {
          state.firstRunCompleted = data.firstRunCompleted;
        }
        syncDynamicZipFolderName();
        // 确保打开 HTML 时默认方案①始终有一套完整的全屏铺开预设
        const p0 = state.globalProfiles[0];
        if (p0) {
          p0.simpleRecActive = 'fullscreen';
          p0.coverageMode = 'grid';
          p0.singlePerZone = false;
          const total0 = (p0.gridCols || 3) * (p0.gridRows || 3);
          if (!Array.isArray(p0.gridCells) || p0.gridCells.filter(v => v > 0).length === 0) {
            p0.gridCols = 3;
            p0.gridRows = 3;
            p0.gridKey = '3x3';
            p0.gridCells = new Array(9).fill(1);
          } else {
            p0.gridCells = new Array(total0).fill(1);
          }
        }
      } catch (e) {}
    }

    function getEffectiveWatermarkText(styleObj = getActiveStyle()) {
      if (!styleObj.enableText) return '';
      const custom = (styleObj.watermarkText || '').trim();
      return custom.length > 0 ? custom : CODE_DEFAULT_WATERMARK_TEXT;
    }

    function getEffectiveSuffix() {
      if (state.noSuffix) return '';
      const custom = state.customSuffix.trim();
      if (custom.length > 0) {
        return custom.startsWith('-') || custom.startsWith('_') ? custom : `-${custom}`;
      }
      return CODE_DEFAULT_FILENAME_SUFFIX;
    }

    function buildOutputFileName(originalName, item = null) {
      const isDocx = /\.docx$/i.test(originalName) || (item && item.fileType === 'docx');
      const base = originalName.replace(/\.(pdf|docx)$/i, '');
      const locked = item ? (item.locked !== false) : state.defaultLockBurn;
      if (isDocx && locked && state.wordLockMode === 'pdf') {
        return `${base}${getEffectiveSuffix()}.pdf`;
      }
      const ext = isDocx ? '.docx' : '.pdf';
      return `${base}${getEffectiveSuffix()}${ext}`;
    }

    function setWorkbenchFaceMode(mode) {
      state.uiMode = mode;
      if (mode === 'advanced') {
        els.btnModeAdvanced.className = 'w-full py-2.5 px-4 rounded-xl text-sm sm:text-base font-black tracking-wide flex items-center justify-center gap-2 transition cursor-pointer click-chip click-chip-indigo-active';
        els.btnModeAdvanced.innerHTML = '<span>✔ 🛠️ 高级模式</span><span class="text-[11px] px-2 py-0.5 rounded-full bg-white/20 text-white font-extrabold">当前模式</span>';
        els.btnModeSimple.className = 'w-full py-2.5 px-4 rounded-xl text-sm sm:text-base font-black tracking-wide flex items-center justify-center gap-2 transition cursor-pointer click-chip';
        els.btnModeSimple.innerHTML = '<span>🌸 普通模式</span><span class="text-[11px] px-2 py-0.5 rounded-full bg-rose-50 text-rose-600 border border-rose-200 font-extrabold">点击切换</span>';
        els.simpleRecommendPanel.classList.add('hidden');
        els.simpleToAdvancedBar.classList.add('hidden');
        els.advancedFullPanel.classList.remove('hidden');
      } else {
        els.btnModeSimple.className = 'w-full py-2.5 px-4 rounded-xl text-sm sm:text-base font-black tracking-wide flex items-center justify-center gap-2 transition cursor-pointer click-chip click-chip-active';
        els.btnModeSimple.innerHTML = '<span>✔ 🌸 普通模式</span><span class="text-[11px] px-2 py-0.5 rounded-full bg-white/25 text-white font-extrabold">当前模式</span>';
        els.btnModeAdvanced.className = 'w-full py-2.5 px-4 rounded-xl text-sm sm:text-base font-black tracking-wide flex items-center justify-center gap-2 transition cursor-pointer click-chip';
        els.btnModeAdvanced.innerHTML = '<span>🛠️ 高级模式</span><span class="text-[11px] px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 font-extrabold">点击切换</span>';
        els.simpleRecommendPanel.classList.remove('hidden');
        els.simpleToAdvancedBar.classList.remove('hidden');
        els.advancedFullPanel.classList.add('hidden');
      }
      savePrefsToStorage();
    }

    // 渲染动态平滑分组按钮栏
    function renderDynamicGroupButtons() {
      const s = getActiveStyle();
      const count = Math.max(1, Math.min(8, s.groupCount || 1));
      s.groupCount = count;
      if (state.activeBrushGroup !== INDEPENDENT_GROUP_VAL && state.activeBrushGroup > count) {
        state.activeBrushGroup = count;
      }

      els.dynamicGroupButtonsWrap.innerHTML = '';
      for (let g = 1; g <= count; g++) {
        const pal = GROUP_PALETTE[g];
        const isCurrent = state.activeBrushGroup === g;
        const pill = document.createElement('div');
        pill.className = `inline-flex items-center rounded-lg border text-[11px] font-extrabold transition overflow-hidden ${
          isCurrent ? 'ring-2 ring-rose-500 shadow-sm' : 'opacity-85 hover:opacity-100'
        }`;
        pill.style.background = pal.bg;
        pill.style.borderColor = pal.border;
        pill.style.color = pal.text;

        const grpStyleMap = s.groupSmoothStyles || {};
        const grpStyleKey = (s.perGroupSmooth !== false && grpStyleMap[g]) ? grpStyleMap[g] : (s.smoothStyle || 'concave');
        const grpStyleMeta = SMOOTH_STYLE_META[grpStyleKey] || SMOOTH_STYLE_META.concave;

        const selectBtn = document.createElement('button');
        selectBtn.type = 'button';
        selectBtn.className = 'px-2.5 py-0.5 cursor-pointer flex items-center gap-1';
        selectBtn.innerHTML = `<span>${isCurrent ? '✔ ' : ''}${pal.name}</span><span class="text-[10px] px-1 rounded bg-white/80 font-black" title="倒角：${grpStyleMeta.short}">${grpStyleMeta.code}</span>`;
        selectBtn.addEventListener('click', () => {
          state.activeBrushGroup = g;
          syncControlsFromActiveStyle();
        });
        pill.appendChild(selectBtn);

        if (g > 1) {
          const delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'px-1.5 py-0.5 hover:bg-black/10 border-l border-black/10 text-[10px] font-black cursor-pointer';
          delBtn.title = `删除 ${pal.name}（该组格子将自动归回 A组）`;
          delBtn.textContent = '×';
          delBtn.addEventListener('click', e => {
            e.stopPropagation();
            s.gridCells = (s.gridCells || []).map(v => {
              if (v === g) return 1;
              if (v > g && v <= 8) return v - 1;
              return v;
            });
            s.groupCount = Math.max(1, count - 1);
            if (state.activeBrushGroup >= g && state.activeBrushGroup !== INDEPENDENT_GROUP_VAL) {
              state.activeBrushGroup = Math.max(1, state.activeBrushGroup - 1);
            }
            syncControlsFromActiveStyle();
            showToast(`🗑️ 已删除 ${pal.name}，原格子已合并回 A组`, 'info');
          });
          pill.appendChild(delBtn);
        }

        els.dynamicGroupButtonsWrap.appendChild(pill);
      }

      const indepBtn = document.createElement('button');
      indepBtn.type = 'button';
      const isIndep = state.activeBrushGroup === INDEPENDENT_GROUP_VAL;
      indepBtn.className = `px-2 py-0.5 rounded-lg border text-[11px] font-extrabold transition ${
        isIndep
          ? 'bg-teal-600 text-white border-teal-700 ring-2 ring-teal-400 shadow-sm'
          : 'bg-teal-50 text-teal-800 border-teal-300 hover:bg-teal-100'
      }`;
      indepBtn.textContent = '📐 独立不平滑';
      indepBtn.addEventListener('click', () => {
        state.activeBrushGroup = INDEPENDENT_GROUP_VAL;
        renderDynamicGroupButtons();
        renderZoneGrid();
      });
      els.dynamicGroupButtonsWrap.appendChild(indepBtn);

      els.btnAddSmoothGroup.classList.toggle('hidden', count >= 8);
    }

    // 渲染当前会话样式栏（点击 × 仅从当前软件界面移除，绝不删除外部「自定义样式」文件夹中的文件）
    function renderStyleStickers() {
      renderStyleImportSubfolderMenu();
      els.styleStickersBar.innerHTML = '';
      if (state.styleStickers.length === 0) {
        const emptyHint = document.createElement('span');
        emptyHint.className = 'text-[11px] text-rose-400 italic';
        emptyHint.textContent = '当前会话暂无临时样式 · 点「➕ 临时存样式」可在本次对话暂存，点「💾 存到自定义样式夹」可永久保存，或点「📂 载入样式」读取';
        els.styleStickersBar.appendChild(emptyHint);
        return;
      }

      state.styleStickers.forEach((st, idx) => {
        const pill = document.createElement('div');
        pill.className = 'inline-flex items-center rounded-xl bg-white hover:bg-rose-50 text-rose-800 border border-rose-200 text-[11px] font-bold shadow-2xs transition overflow-hidden';

        const applyBtn = document.createElement('button');
        applyBtn.type = 'button';
        applyBtn.className = 'px-2.5 py-1 text-left cursor-pointer';
        applyBtn.textContent = st.name;
        applyBtn.title = `点击套用「${st.name}」`;
        applyBtn.addEventListener('click', () => {
          const s = getActiveStyle();
          if (st.snapshot) {
            const snap = st.snapshot;
            Object.keys(snap).forEach(k => {
              if (k === 'gridCells') {
                const snapCols = snap.gridCols || 3;
                const snapRows = snap.gridRows || 3;
                s.gridKey = snap.gridKey || '3x3';
                s.gridCols = snapCols;
                s.gridRows = snapRows;
                s.gridCells = [...snap.gridCells];
              } else {
                s[k] = snap[k];
              }
            });
          }
          syncControlsFromActiveStyle();
          showToast(`✨ 已套用样式「${st.name}」！`, 'success');
        });

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'px-1.5 py-1 text-rose-400 hover:text-rose-700 hover:bg-rose-100 border-l border-rose-100 font-black cursor-pointer transition';
        delBtn.textContent = '×';
        delBtn.title = `仅从当前软件界面移除「${st.name}」（不会删除外部文件夹中的保存样式）`;
        delBtn.addEventListener('click', e => {
          e.stopPropagation();
          const removedName = st.name;
          state.styleStickers.splice(idx, 1);
          renderStyleStickers();
          showToast(`🗑️ 已从当前界面移除「${removedName}」（外部文件夹内保存的样式未受影响）`, 'info');
        });

        pill.appendChild(applyBtn);
        pill.appendChild(delBtn);
        els.styleStickersBar.appendChild(pill);
      });
    }

    function syncControlsFromActiveStyle() {
      const s = getActiveStyle();
      setWorkbenchFaceMode(state.uiMode);

      els.enableTextToggle.checked = Boolean(s.enableText);
      els.hollowTextToggle.checked = Boolean(s.hollowText);
      els.watermarkText.value = s.watermarkText || '';
      els.watermarkText.disabled = !s.enableText;
      els.textWatermarkCard.className = s.enableText
        ? 'sm:col-span-6 p-3 rounded-2xl bg-rose-50/60 border-2 border-rose-300 transition shadow-2xs flex flex-col justify-between'
        : 'sm:col-span-6 p-3 rounded-2xl bg-slate-50/70 border-2 border-slate-200 opacity-65 transition flex flex-col justify-between';

      els.enableStampToggle.checked = Boolean(s.enableStamp);
      els.builtinStampSelect.value = s.stampType || 'paw';
      els.stampScaleInput.value = s.stampScale || 100;
      els.builtinStampSelect.disabled = !s.enableStamp;
      els.stampScaleInput.disabled = !s.enableStamp;
      els.patternWatermarkCard.className = s.enableStamp
        ? 'sm:col-span-6 p-3 rounded-2xl bg-amber-50/70 border-2 border-amber-300 transition shadow-2xs flex flex-col justify-between'
        : 'sm:col-span-6 p-3 rounded-2xl bg-slate-50/70 border-2 border-slate-200 opacity-65 transition flex flex-col justify-between';

      refreshBuiltinStampSelectOptions();
      const hasCustomUploaded = Boolean(s.enableStamp && (s.stampType === 'custom' && s.customStampImageEl));
      const labelTarget = els.btnUploadStampImgLabel || els.btnUploadStampImg;
      if (s.stampType === 'custom' && s.customStampName) {
        labelTarget.textContent = `✅ ${s.customStampName.slice(0, 6)}..`;
        els.btnClearStampImg.classList.toggle('hidden', !s.enableStamp);
      } else if (s.stampType && s.stampType.startsWith('subimg:')) {
        labelTarget.textContent = `📁 ${s.stampType.slice(7, 13)}..`;
        els.btnClearStampImg.classList.toggle('hidden', !s.enableStamp);
      } else {
        labelTarget.textContent = '📂 选自定义图片';
        els.btnClearStampImg.classList.toggle('hidden', !s.enableStamp);
      }
      if (els.customImgSubfolderBar) {
        els.customImgSubfolderBar.classList.toggle('hidden', !hasCustomUploaded);
        if (hasCustomUploaded && !els.customImgSaveNameInput.value) {
          els.customImgSaveNameInput.value = (s.customStampName || '西西印章').replace(/\.[a-z0-9]+$/i, '');
        }
      }

      // 普通模式：当处于「🎀 页眉页尾」模式时展开页眉/页尾高度滑块
      const isHeaderFooterRec = (s.coverageMode === 'box' && s.boxInvert && s.boxLeft === 0 && s.boxRight === 0);
      els.simpleHeaderFooterBar.classList.toggle('hidden', !isHeaderFooterRec);
      if (isHeaderFooterRec) {
        els.hfTopSlider.value = s.boxTop;
        els.hfTopValLabel.textContent = `${s.boxTop}%`;
        els.hfBotSlider.value = s.boxBottom;
        els.hfBotValLabel.textContent = `${s.boxBottom}%`;
      }

      // 高亮普通模式三大推荐卡片（异色 + ✔ 标识）
      const recTitles = {
        fullscreen: '🐾 全屏满铺',
        centerbig: '🎯 正中央大章',
        headerfooter: '🎀 页眉页尾'
      };
      document.querySelectorAll('[data-rec]').forEach(btn => {
        const rType = btn.dataset.rec;
        const isActive = (s.simpleRecActive === rType);
        btn.className = isActive
          ? 'rec-card-btn click-chip click-chip-active py-2.5 px-3 rounded-xl text-center transition flex flex-col items-center justify-center gap-0.5'
          : 'rec-card-btn click-chip py-2.5 px-3 rounded-xl text-center transition flex flex-col items-center justify-center gap-0.5';
        const titleEl = btn.querySelector('.rec-title');
        if (titleEl && recTitles[rType]) {
          titleEl.textContent = (isActive ? '✔ ' : '') + recTitles[rType];
        }
      });

      els.fontFamilySelect.value = s.fontFamily;
      els.colorLabelText.textContent = `${s.color} ${s.colorName || ''}`;
      els.customColorInput.value = s.color;
      document.querySelectorAll('.color-swatch').forEach(b => {
        if ((b.dataset.color || '').toUpperCase() === (s.color || '').toUpperCase()) {
          b.classList.add('ring-2', 'ring-rose-500');
        } else {
          b.classList.remove('ring-2', 'ring-rose-500');
        }
      });

      els.fontSizeSlider.value = s.fontSize;
      els.fontSizeVal.value = s.fontSize;
      els.opacitySlider.value = s.opacity;
      els.opacityVal.value = s.opacity;
      els.angleSlider.value = s.angle;
      els.angleVal.value = s.angle;
      els.gapSlider.value = s.gap;
      els.gapVal.value = s.gap;

      const offX = Math.round(s.offsetX || 0);
      const offY = Math.round(s.offsetY || 0);
      els.offsetXInput.value = offX;
      els.offsetXSlider.value = Math.max(-240, Math.min(240, offX));
      els.offsetYInput.value = offY;
      els.offsetYSlider.value = Math.max(-240, Math.min(240, offY));

      const rGap = s.rowGapScale || 100;
      els.rowGapScaleInput.value = rGap;
      els.rowGapScaleSlider.value = Math.max(50, Math.min(200, rGap));
      els.staggerRowToggle.checked = s.staggerRow !== false;

      els.smartMergeBandToggle.checked = Boolean(s.smartMergeBand);
      const radDeg = Math.max(0, Math.min(180, s.smoothRadius !== undefined ? s.smoothRadius : 90));
      els.smoothRadiusSlider.value = radDeg;
      els.smoothRadiusVal.value = radDeg;
      els.smoothConfigRow.classList.toggle('opacity-50', !s.smartMergeBand);

      if (!s.groupSmoothStyles) {
        s.groupSmoothStyles = { 1: s.smoothStyle || 'concave', 2: 'slope', 3: 'allround' };
      }
      // 兼容旧存档里已被移除的款式名
      Object.keys(s.groupSmoothStyles).forEach(k => {
        if (!SMOOTH_STYLE_META[s.groupSmoothStyles[k]]) s.groupSmoothStyles[k] = 'concave';
      });
      if (!SMOOTH_STYLE_META[s.smoothStyle]) s.smoothStyle = 'concave';
      const activeGrp = (state.activeBrushGroup && state.activeBrushGroup !== INDEPENDENT_GROUP_VAL) ? state.activeBrushGroup : 1;
      const activeStyleKey = (s.perGroupSmooth !== false && s.groupSmoothStyles[activeGrp])
        ? s.groupSmoothStyles[activeGrp]
        : (s.smoothStyle || 'concave');
      const activeMeta = SMOOTH_STYLE_META[activeStyleKey] || SMOOTH_STYLE_META.concave;

      if (els.currentSmoothStyleBadge) {
        els.currentSmoothStyleBadge.textContent = activeMeta.label;
      }
      if (els.smoothStyleDrawer) {
        els.smoothStyleDrawer.classList.toggle('hidden', !state.smoothDrawerOpen || !s.smartMergeBand);
      }
      if (els.smoothDrawerArrow) {
        els.smoothDrawerArrow.textContent = state.smoothDrawerOpen ? '▴ 收起' : '▾ 展开';
      }
      if (els.perGroupSmoothToggle) {
        els.perGroupSmoothToggle.checked = s.perGroupSmooth !== false;
      }
      document.querySelectorAll('.smooth-style-btn').forEach(btn => {
        const isSel = (btn.dataset.sstyle === activeStyleKey);
        btn.className = isSel
          ? 'smooth-style-btn click-chip click-chip-indigo-active py-2 px-2.5 rounded-xl text-center transition flex items-center justify-center gap-1 text-xs sm:text-sm font-extrabold'
          : 'smooth-style-btn click-chip py-2 px-2.5 rounded-xl text-center transition flex items-center justify-center gap-1 text-xs sm:text-sm font-extrabold';
        const chk = btn.querySelector('.sstyle-check');
        if (chk) chk.classList.toggle('hidden', !isSel);
      });

      const curCols = s.gridCols || 3;
      const curRows = s.gridRows || 3;
      const curGridKey = `${curCols}x${curRows}`;
      s.gridKey = curGridKey;
      document.querySelectorAll('.grid-size-btn').forEach(btn => {
        const isGridSel = (btn.dataset.gridkey === curGridKey);
        const spec = GRID_SPECS[btn.dataset.gridkey];
        btn.className = isGridSel
          ? 'grid-size-btn px-2.5 py-1 rounded-lg click-chip click-chip-active text-xs'
          : 'grid-size-btn px-2.5 py-1 rounded-lg click-chip text-xs';
        if (spec) {
          btn.textContent = (isGridSel ? '✔ ' : '') + spec.label;
        }
      });
      if (els.customGridXInput && els.customGridYInput) {
        els.customGridXInput.value = curCols;
        els.customGridYInput.value = curRows;
      }

      els.singlePerZoneToggle.checked = Boolean(s.singlePerZone);
      els.btnSnapSingleCenter.classList.toggle('hidden', !s.singlePerZone);

      els.boxTopInput.value = s.boxTop;
      els.boxBottomInput.value = s.boxBottom;
      els.boxLeftInput.value = s.boxLeft;
      els.boxRightInput.value = s.boxRight;
      els.snapGridToggle.checked = Boolean(s.snapGrid);
      els.symLockToggle.checked = Boolean(s.symLock);

      els.pageRangeModeSelect.value = s.pageRangeMode || 'all';
      els.customPageRangeInput.value = s.customPageRange || '';
      els.customPageRangeInput.classList.toggle('hidden', s.pageRangeMode !== 'custom');

      const rangeLabels = {
        all: '全部页面',
        skipFirst: '跳过首页封面',
        onlyFirst: '仅盖第1页',
        odd: '仅奇数页',
        even: '仅偶数页',
        custom: `自定义页码(${s.customPageRange || '全部'})`
      };
      els.outputRangeTag.textContent = rangeLabels[s.pageRangeMode || 'all'] || '全部页面';

      if (s.coverageMode === 'box') {
        els.tabModeBox.className = 'px-3 py-1.5 rounded-lg text-xs font-extrabold click-chip click-chip-active';
        els.tabModeBox.textContent = '✔ 📏 自选磁吸框';
        els.tabModeGrid.className = 'px-3 py-1.5 rounded-lg text-xs font-extrabold click-chip';
        els.tabModeGrid.textContent = '🐾 网格与倒角';
        els.panelBoxMode.classList.remove('hidden');
        els.panelGridMode.classList.add('hidden');
      } else {
        els.tabModeGrid.className = 'px-3 py-1.5 rounded-lg text-xs font-extrabold click-chip click-chip-active';
        els.tabModeGrid.textContent = '✔ 🐾 网格与倒角';
        els.tabModeBox.className = 'px-3 py-1.5 rounded-lg text-xs font-extrabold click-chip';
        els.tabModeBox.textContent = '📏 自选磁吸框';
        els.panelGridMode.classList.remove('hidden');
        els.panelBoxMode.classList.add('hidden');
      }

      if (s.boxInvert) {
        els.btnBoxOutside.className = 'px-2.5 py-1 rounded-lg text-xs font-extrabold bg-rose-500 text-white';
        els.btnBoxInside.className = 'px-2.5 py-1 rounded-lg text-xs font-extrabold bg-rose-50 text-rose-800 border border-rose-200';
      } else {
        els.btnBoxInside.className = 'px-2.5 py-1 rounded-lg text-xs font-extrabold bg-rose-500 text-white';
        els.btnBoxOutside.className = 'px-2.5 py-1 rounded-lg text-xs font-extrabold bg-rose-50 text-rose-800 border border-rose-200';
      }

      const editingFile = state.files.find(f => f.id === state.editingFileId);
      if (editingFile && editingFile.useCustomStyle) {
        els.editingScopeIcon.classList.remove('hidden');
        els.globalProfileTabs.classList.add('hidden');
        els.editingScopeText.classList.remove('hidden');
        els.editingScopeText.textContent = `《${editingFile.name}》`;
        els.btnExitFileScope.classList.remove('hidden');
      } else {
        state.editingFileId = null;
        els.editingScopeIcon.classList.add('hidden');
        els.globalProfileTabs.classList.remove('hidden');
        els.editingScopeText.classList.add('hidden');
        els.btnExitFileScope.classList.add('hidden');

        document.querySelectorAll('.profile-tab-btn').forEach(btn => {
          const idx = Number(btn.dataset.profile);
          const isAct = (idx === state.activeProfileIndex);
          btn.className = isAct
            ? 'profile-tab-btn px-2.5 py-1 rounded-lg text-xs font-extrabold click-chip click-chip-active'
            : 'profile-tab-btn px-2.5 py-1 rounded-lg text-xs font-extrabold click-chip';
          btn.textContent = (isAct ? '✔ ' : '') + PROFILE_LABELS[idx];
        });
      }

      renderDynamicGroupButtons();
      renderZoneGrid();
      renderWatermarkOverlay();
    }

    // ==================== A4 比例网格涂抹 & 图1同款「100%轴对称内凹贝塞尔圆弧」核心引擎 ====================
    let isPaintingGrid = false;
    let paintTargetValue = 1;

    function renderZoneGrid() {
      const s = getActiveStyle();
      const cols = s.gridCols || 3;
      const rows = s.gridRows || 3;
      const totalCells = cols * rows;
      if (!Array.isArray(s.gridCells) || s.gridCells.length !== totalCells) {
        s.gridCells = new Array(totalCells).fill(1);
      }

      els.zoneGrid.style.gridTemplateColumns = `repeat(${cols}, minmax(0, 1fr))`;
      els.zoneGrid.style.gridTemplateRows = `repeat(${rows}, minmax(0, 1fr))`;
      els.zoneGrid.style.gap = cols === 3 ? '5px' : (cols === 5 ? '3px' : '2px');
      els.zoneGrid.innerHTML = '';

      const targetBrush = state.activeBrushGroup || 1;

      s.gridCells.forEach((cellVal, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.idx = idx;
        btn.className = 'zone-cell rounded-lg border flex flex-col items-center justify-center cursor-pointer ' + (cellVal > 0 ? '' : 'inactive');

        let shortTag = '';
        let dotColor = '#F43F5E';
        if (cellVal === INDEPENDENT_GROUP_VAL) {
          btn.style.background = 'linear-gradient(135deg, #CCFBF1 0%, #99F6E4 100%)';
          btn.style.borderColor = '#14B8A6';
          btn.style.color = '#0F766E';
          shortTag = '独';
          dotColor = '#0D9488';
        } else if (cellVal >= 1 && cellVal <= 8) {
          const pal = GROUP_PALETTE[cellVal] || GROUP_PALETTE[1];
          btn.style.background = pal.bg;
          btn.style.borderColor = pal.border;
          btn.style.color = pal.text;
          shortTag = pal.short;
          dotColor = pal.dot;
        }

        if (cols === 3 && rows === 3) {
          const suffix = (cellVal > 1) ? `·${shortTag}` : '';
          btn.innerHTML = `
            <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-4.5-1.5C6.67 8.5 6 9.17 6 10s.67 1.5 1.5 1.5S9 10.83 9 10s-.67-1.5-1.5-1.5zm9 0c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5 1.5-.67 1.5-1.5-.67-1.5-1.5-1.5zM9.5 6C8.67 6 8 6.67 8 7.5S8.67 9 9.5 9 11 8.33 11 7.5 10.33 6 9.5 6zm5 0c-.83 0-1.5.67-1.5 1.5S13.67 9 14.5 9 16 8.33 16 7.5 15.33 6 14.5 6zM12 15c-2.33 0-4.32 1.45-5.12 3.5h10.24c-.8-2.05-2.79-3.5-5.12-3.5z"/>
            </svg>
            <span class="text-[9px] font-bold leading-none mt-0.5 pointer-events-none">${ZONE_NAMES_3X3[idx]}${suffix}</span>
          `;
        } else if (cols <= 5) {
          btn.innerHTML = `<span class="text-[9px] font-extrabold pointer-events-none">${cellVal ? shortTag : ''}</span>`;
        } else {
          btn.innerHTML = `<span class="w-1.5 h-1.5 rounded-full pointer-events-none" style="background:${cellVal ? dotColor : 'transparent'}"></span>`;
        }

        // 问题10修复：在「每区仅1枚独章」模式下，点选格子时自动把拖拽偏移量归零回到区域平均中心，且若当前仅剩这一格点亮且有偏移时，点击它只归位中心而不熄灭印章！
        const applyCellPaint = (targetIdx, isStart = false) => {
          const cur = s.gridCells[targetIdx] || 0;
          const activeCountNow = s.gridCells.filter(v => v > 0).length;
          const hasDraggedOffset = (Math.abs(s.offsetX || 0) > 2 || Math.abs(s.offsetY || 0) > 2);

          if (isStart) {
            if (s.singlePerZone && cur === targetBrush && activeCountNow === 1 && hasDraggedOffset) {
              // 当前唯一亮着的独苗格被拖拽过，再次点击它直接归位到该格正中心，绝不把印章弄消失！
              s.offsetX = 0;
              s.offsetY = 0;
              syncControlsFromActiveStyle();
              showToast('🎯 独苗大章已归位到该格正中心！可继续在右图拖拽微调～', 'success');
              return;
            }
            paintTargetValue = (cur === targetBrush) ? 0 : targetBrush;
          }

          if (s.gridCells[targetIdx] !== paintTargetValue) {
            s.gridCells[targetIdx] = paintTargetValue;
            // 只要在独苗模式下修改了区域范围，自动将印章归位到新选区的几何平均中心！
            if (s.singlePerZone) {
              s.offsetX = 0;
              s.offsetY = 0;
              els.offsetXInput.value = 0;
              els.offsetXSlider.value = 0;
              els.offsetYInput.value = 0;
              els.offsetYSlider.value = 0;
            }
            renderZoneGrid();
            renderWatermarkOverlay();
          }
        };

        btn.addEventListener('mousedown', e => {
          e.preventDefault();
          isPaintingGrid = true;
          applyCellPaint(idx, true);
        });

        btn.addEventListener('mouseenter', () => {
          if (isPaintingGrid) applyCellPaint(idx, false);
        });

        els.zoneGrid.appendChild(btn);
      });

      if (!els.zoneGrid.dataset.touchBound) {
        els.zoneGrid.dataset.touchBound = '1';
        els.zoneGrid.addEventListener('touchstart', e => {
          const t = e.touches && e.touches[0];
          if (!t) return;
          const el = document.elementFromPoint(t.clientX, t.clientY)?.closest('.zone-cell');
          if (!el) return;
          e.preventDefault();
          const st = getActiveStyle();
          const brush = state.activeBrushGroup || 1;
          const idx = Number(el.dataset.idx);
          isPaintingGrid = true;
          paintTargetValue = (st.gridCells[idx] === brush) ? 0 : brush;
          st.gridCells[idx] = paintTargetValue;
          if (st.singlePerZone) { st.offsetX = 0; st.offsetY = 0; }
          renderZoneGrid();
          renderWatermarkOverlay();
        }, { passive: false });

        els.zoneGrid.addEventListener('touchmove', e => {
          if (!isPaintingGrid) return;
          const t = e.touches && e.touches[0];
          if (!t) return;
          const el = document.elementFromPoint(t.clientX, t.clientY)?.closest('.zone-cell');
          if (!el) return;
          e.preventDefault();
          const st = getActiveStyle();
          const idx = Number(el.dataset.idx);
          if (st.gridCells[idx] !== paintTargetValue) {
            st.gridCells[idx] = paintTargetValue;
            if (st.singlePerZone) { st.offsetX = 0; st.offsetY = 0; }
            renderZoneGrid();
            renderWatermarkOverlay();
          }
        }, { passive: false });
      }

      const activeCount = s.gridCells.filter(v => v > 0).length;
      if (activeCount === 0) {
        els.zoneSummaryText.textContent = '⚠️ 当前未点亮任何格子（页面将不盖水印）';
      } else if (s.singlePerZone) {
        els.zoneSummaryText.textContent = `🎯 独苗模式：已点亮 ${activeCount} 格（点击格子自动归位区域平均中心，在右图可再次拖拽！）`;
      } else {
        els.zoneSummaryText.textContent = `✨ 已点亮 ${activeCount} / ${totalCells} 格（${s.smartMergeBand ? `轴对称内凹倒角开启 · ${s.smoothRadius}°` : '纯直角网格模式'}）`;
      }
    }

    /**
     * 核心算法（问题2完美解答）：严格复刻图1（d381d581c23af29deff984e1afc8434a.jpg）的「100%轴对称内凹二次贝塞尔切线圆弧」引擎
     * 几何原理：
     * 1. 提取该分组所有激活格子的外边界有向半边，内部共享边自动抵消，对角接触鞍点优先左转连通为闭合环。
     * 2. 对闭合环上的每一个「左转凹腰角 (Concave Left-Turn)」顶点 V = (vx, vy)：
     *    - 不管格子本身是正方形还是长方形，强制在物理像素空间沿着入边 u_in 与出边 u_out 截取【完全相等的像素长度 L】：
     *      L = min(入边可用长度, 出边可用长度, min(cellW, cellH) * (deg / 90))
     *    - 切点 P_start = V - L * u_in，切点 P_end = V + L * u_out。
     *    - 因为 |V - P_start| === |P_end - V| === L，三角形 (P_start, V, P_end) 在物理画布上是 100% 严格的等腰直角三角形！
     *    - 控制点 C 取在对称轴（V 与弦中点 M 的连线）上：C = V + 0.16 * (M - V)，使用 ctx.quadraticCurveTo(C.x, C.y, P_end.x, P_end.y) 绘制向内弯的丝滑凹弧！
     *    - 如此一来，无论是图1里的「两格斜角」「三格阶梯」「L型拐角」还是「Z型折角」，每一条倒角弧线都关于 45° 轴线 100% 镜像轴对称！
     */
    /**
     * V6 核心平滑/倒角引擎：精选 3 款样式 + 0°~180° 超广角跨阶平滑 + A/B/C/D 分组独立联动
     * - 款式① slope:    📐 顶点直连斜坡（凹角顶点对顶点拉直线；90°削平单阶，90°~180°跨阶拉通成笔直斜带）
     * - 款式② concave:  🌙 轴对称内凹圆弧（等像素腿长内凹贝塞尔圆弧；90°~180°跨阶融合成大跨度柔美内弧）
     * - 款式③ allround: 🫧 内外双圆角果冻（外凸90°直角与内凹90°拐角同步圆角化；90°~180°化作丝滑流线胶囊）
     */
    function buildChamferedGroupPath(ctx, cells, cols, rows, w, h, styleObj, groupVal) {
      const cellW = w / cols;
      const cellH = h / rows;
      const smoothOn = (groupVal === INDEPENDENT_GROUP_VAL) ? false : Boolean(styleObj.smartMergeBand);
      const deg = Math.max(0, Math.min(180, styleObj.smoothRadius !== undefined ? styleObj.smoothRadius : 90));
      // 0°~90° 为基础切角阶段 (baseRatio: 0 -> 1)；90°~180° 为超广角跨阶平滑阶段 (overRatio: 0 -> 1)
      const baseRatio = Math.min(1, deg / 90);
      const overRatio = Math.max(0, (deg - 90) / 90);

      const grpMap = styleObj.groupSmoothStyles || {};
      let smoothStyle = (styleObj.perGroupSmooth !== false && grpMap[groupVal])
        ? grpMap[groupVal]
        : (styleObj.smoothStyle || 'concave');
      if (!SMOOTH_STYLE_META[smoothStyle]) smoothStyle = 'concave';

      const activeCoords = [];
      const activeSet = new Set();
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          if (cells[r * cols + c] === groupVal) {
            activeCoords.push({ r, c, idx: r * cols + c });
            activeSet.add(`${r},${c}`);
          }
        }
      }
      if (activeCoords.length === 0) return [];

      // 提取连通分量与几何平均中心点
      const visited = new Set();
      const centroids = [];
      for (const item of activeCoords) {
        if (visited.has(item.idx)) continue;
        const comp = [];
        const q = [item];
        visited.add(item.idx);
        while (q.length > 0) {
          const cur = q.shift();
          comp.push(cur);
          for (const other of activeCoords) {
            if (visited.has(other.idx)) continue;
            if (Math.abs(cur.r - other.r) <= 1 && Math.abs(cur.c - other.c) <= 1) {
              visited.add(other.idx);
              q.push(other);
            }
          }
        }
        let sx = 0, sy = 0;
        comp.forEach(p => {
          sx += (p.c + 0.5) * cellW;
          sy += (p.r + 0.5) * cellH;
        });
        centroids.push({ cx: sx / comp.length, cy: sy / comp.length });
      }

      if (groupVal === INDEPENDENT_GROUP_VAL) {
        activeCoords.forEach(p => {
          ctx.rect(p.c * cellW, p.r * cellH, cellW, cellH);
        });
        return centroids;
      }

      // 1. 收集外边界有向半边
      const edges = [];
      const outMap = new Map();
      const addEdge = (x1, y1, x2, y2, dir) => {
        const id = edges.length;
        const e = { id, x1, y1, x2, y2, dir, used: false };
        edges.push(e);
        const key = `${x1},${y1}`;
        if (!outMap.has(key)) outMap.set(key, []);
        outMap.get(key).push(e);
      };

      for (const { r, c } of activeCoords) {
        if (!activeSet.has(`${r - 1},${c}`)) addEdge(c, r, c + 1, r, 'E');
        if (!activeSet.has(`${r},${c + 1}`)) addEdge(c + 1, r, c + 1, r + 1, 'S');
        if (!activeSet.has(`${r + 1},${c}`)) addEdge(c + 1, r + 1, c, r + 1, 'W');
        if (!activeSet.has(`${r},${c - 1}`)) addEdge(c, r + 1, c, r, 'N');
      }

      const turnPriority = {
        E: ['N', 'E', 'S'],
        S: ['E', 'S', 'W'],
        W: ['S', 'W', 'N'],
        N: ['W', 'N', 'E']
      };

      const loops = [];
      for (const startEdge of edges) {
        if (startEdge.used) continue;
        const rawLoop = [];
        let cur = startEdge;
        while (cur && !cur.used) {
          cur.used = true;
          rawLoop.push(cur);
          const nextKey = `${cur.x2},${cur.y2}`;
          const candidates = (outMap.get(nextKey) || []).filter(e => !e.used);
          if (candidates.length === 0) break;
          const prefs = turnPriority[cur.dir] || [];
          let chosen = null;
          for (const pDir of prefs) {
            chosen = candidates.find(cEdge => cEdge.dir === pDir);
            if (chosen) break;
          }
          cur = chosen || candidates[0];
        }
        if (rawLoop.length >= 4) loops.push(rawLoop);
      }

      const isLeftTurn = (d1, d2) => (
        (d1 === 'S' && d2 === 'E') ||
        (d1 === 'E' && d2 === 'N') ||
        (d1 === 'N' && d2 === 'W') ||
        (d1 === 'W' && d2 === 'S')
      );

      loops.forEach(rawLoop => {
        const segs = [];
        for (const e of rawLoop) {
          const last = segs[segs.length - 1];
          if (last && last.dir === e.dir && last.x2 === e.x1 && last.y2 === e.y1) {
            last.x2 = e.x2;
            last.y2 = e.y2;
          } else {
            segs.push({ x1: e.x1, y1: e.y1, x2: e.x2, y2: e.y2, dir: e.dir });
          }
        }
        if (segs.length > 1 && segs[0].dir === segs[segs.length - 1].dir) {
          const last = segs.pop();
          segs[0].x1 = last.x1;
          segs[0].y1 = last.y1;
        }

        const m = segs.length;
        if (m < 4) return;

        segs.forEach(sg => {
          sg.px1 = sg.x1 * cellW;
          sg.py1 = sg.y1 * cellH;
          sg.px2 = sg.x2 * cellW;
          sg.py2 = sg.y2 * cellH;
          const dx = sg.px2 - sg.px1;
          const dy = sg.py2 - sg.py1;
          sg.pxLen = Math.hypot(dx, dy);
          sg.ux = sg.pxLen > 0 ? dx / sg.pxLen : 0;
          sg.uy = sg.pxLen > 0 ? dy / sg.pxLen : 0;
        });

        if (!smoothOn || deg <= 0.5) {
          ctx.moveTo(segs[0].px1, segs[0].py1);
          for (let i = 0; i < m; i++) {
            ctx.lineTo(segs[i].px2, segs[i].py2);
          }
          ctx.closePath();
          return;
        }

        const roundBoth = (smoothStyle === 'allround');
        const verts = [];
        for (let i = 0; i < m; i++) {
          const prevSeg = segs[(i - 1 + m) % m];
          const nextSeg = segs[i];
          const concave = isLeftTurn(prevSeg.dir, nextSeg.dir);
          verts.push({
            vx: nextSeg.px1,
            vy: nextSeg.py1,
            prevSeg,
            nextSeg,
            concave,
            activeCorner: roundBoth ? true : concave
          });
        }

        // 计算 0°~180° 下每个拐角的切线退让臂长 legIn / legOut
        // 当 deg 在 90°~180° 时，允许最大跨度从 1 倍单元格平滑扩展至 3 倍单元格（受边长上限安全保护，绝不自交）
        const spanBoost = 1 + overRatio * 2.0;

        for (let i = 0; i < m; i++) {
          const v = verts[i];
          if (!v.activeCorner) {
            v.legIn = 0;
            v.legOut = 0;
            continue;
          }
          const prevVert = verts[(i - 1 + m) % m];
          const nextVert = verts[(i + 1) % m];
          const maxShare = 0.495 + overRatio * 0.004; // 最高 0.499，绝对不越过中点自交
          const availIn = prevVert.activeCorner ? (v.prevSeg.pxLen * maxShare) : (v.prevSeg.pxLen * 0.99);
          const availOut = nextVert.activeCorner ? (v.nextSeg.pxLen * maxShare) : (v.nextSeg.pxLen * 0.99);

          if (smoothStyle === 'slope') {
            // 款式①「顶点直连斜坡」：沿入边与出边可用跨度退让，直接顶点连顶点拉成斜线
            v.legIn = availIn * baseRatio;
            v.legOut = availOut * baseRatio;
          } else {
            // 款式②「轴对称内凹圆弧」& 款式③「内外双圆角果冻」：
            // 0°~90° 严格取等像素腿长 symL（保证单阶 100% 等腰轴对称）；
            // 90°~180° 随 overRatio 从等像素腿长 symL 丝滑扩展至整条边的完整可用跨度 availIn / availOut，消除长方形格子的残留直边，且弧线更加饱满深邃！
            const maxSpan = v.concave
              ? Math.min(cellW, cellH) * baseRatio
              : Math.min(cellW, cellH) * baseRatio * (0.52 + overRatio * 0.46);
            const symL = Math.max(0, Math.min(maxSpan, availIn, availOut));
            v.legIn = symL * (1 - overRatio) + Math.min(availIn, Math.max(cellW, cellH) * spanBoost) * overRatio;
            v.legOut = symL * (1 - overRatio) + Math.min(availOut, Math.max(cellW, cellH) * spanBoost) * overRatio;
          }
        }

        const nodes = [];
        for (let i = 0; i < m; i++) {
          const v = verts[i];
          if (!v.activeCorner || v.legIn <= 0.5 || v.legOut <= 0.5) {
            nodes.push({ type: 'sharp', x: v.vx, y: v.vy, concave: v.concave });
          } else {
            const pStart = {
              x: v.vx - v.prevSeg.ux * v.legIn,
              y: v.vy - v.prevSeg.uy * v.legIn
            };
            const pEnd = {
              x: v.vx + v.nextSeg.ux * v.legOut,
              y: v.vy + v.nextSeg.uy * v.legOut
            };
            nodes.push({
              type: 'fillet',
              vx: v.vx,
              vy: v.vy,
              pStart,
              pEnd,
              concave: v.concave
            });
          }
        }

        let firstPt = null;
        for (let i = 0; i < nodes.length; i++) {
          const nd = nodes[i];
          const prevNd = nodes[(i - 1 + nodes.length) % nodes.length];
          const nextNd = nodes[(i + 1) % nodes.length];

          // 在 90°~180° 超广角模式下，夹在两个内凹阶梯腰之间的中间阶梯外肩尖角自动随 overRatio 平滑收拢，消除高密网格锯齿
          if (nd.type === 'sharp' && !nd.concave && prevNd.concave && nextNd.concave && overRatio > 0.01) {
            const pA = prevNd.type === 'fillet' ? prevNd.pEnd : { x: prevNd.vx, y: prevNd.vy };
            const pB = nextNd.type === 'fillet' ? nextNd.pStart : { x: nextNd.vx, y: nextNd.vy };
            const midABx = (pA.x + pB.x) * 0.5;
            const midABy = (pA.y + pB.y) * 0.5;
            const effX = nd.x * (1 - overRatio) + midABx * overRatio;
            const effY = nd.y * (1 - overRatio) + midABy * overRatio;
            if (!firstPt) {
              firstPt = { x: effX, y: effY };
              ctx.moveTo(effX, effY);
            } else {
              ctx.lineTo(effX, effY);
            }
            continue;
          }

          if (nd.type === 'sharp') {
            if (!firstPt) {
              firstPt = { x: nd.x, y: nd.y };
              ctx.moveTo(nd.x, nd.y);
            } else {
              ctx.lineTo(nd.x, nd.y);
            }
          } else {
            const { pStart, pEnd, vx, vy, concave } = nd;
            const midX = (pStart.x + pEnd.x) * 0.5;
            const midY = (pStart.y + pEnd.y) * 0.5;

            if (!firstPt) {
              firstPt = pStart;
              ctx.moveTo(pStart.x, pStart.y);
            } else {
              ctx.lineTo(pStart.x, pStart.y);
            }

            if (smoothStyle === 'slope') {
              // 款式 ①：顶点直连斜坡
              ctx.lineTo(pEnd.x, pEnd.y);
            } else {
              // 款式 ② (concave) 与 款式 ③ (allround)：始终保持优雅的圆弧曲率，绝不退化成直线！
              const factor = concave ? (0.16 - overRatio * 0.06) : (0.12 - overRatio * 0.04);
              const ctrlX = vx + (midX - vx) * factor;
              const ctrlY = vy + (midY - vy) * factor;
              ctx.quadraticCurveTo(ctrlX, ctrlY, pEnd.x, pEnd.y);
            }
          }
        }
        if (firstPt) {
          ctx.lineTo(firstPt.x, firstPt.y);
        }
        ctx.closePath();
      });

      return centroids;
    }

    // ==================== 大字清晰版 2 页《西西盖章局功能说明书》（自动同步至同级「系统资源」文件夹） ====================
    function drawDemoGuidePageOnCanvas(canvas, pageNum = 1) {
      const ctx = canvas.getContext('2d');
      const w = canvas.width;
      const h = canvas.height;

      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, w, h);

      if (pageNum === 1) {
        // 第 1 页：大字版 · 普通模式与防删加密核心指南
        ctx.fillStyle = '#FFF1F2';
        ctx.fillRect(0, 0, w, 102);
        ctx.fillStyle = '#E11D48';
        ctx.font = 'bold 23px "PingFang SC", "Microsoft YaHei", sans-serif';
        ctx.fillText('🐾 西西盖章局 · 功能说明指南 (P1 / 共2页)', 30, 50);
        ctx.fillStyle = '#9F1239';
        ctx.font = 'bold 14px "PingFang SC", "Microsoft YaHei", sans-serif';
        ctx.fillText('📁 本预设 PDF 自动存于同级「系统资源」夹 · 右上角可切换 P1 / P2', 30, 82);

        const p1Cards = [
          {
            title: '🌸 一、文字与图案水印自由搭配',
            bg: '#FFFDF9',
            border: '#FDA4AF',
            titleColor: '#BE123C',
            lines: [
              '• 文字水印：支持镂空描边、一键加今日日期，输入「/」即可多行排版。',
              '• 图案贴纸：内置猫爪章，或从同级「自定义图片」子夹免弹窗秒选贴纸！',
              '• 快捷比例：滑块与滚轮按整倍数调节，右侧数字框支持直接打字精确输入。'
            ]
          },
          {
            title: '⚡ 二、三大推荐预设（一键配好）',
            bg: '#FFFBEB',
            border: '#FCD34D',
            titleColor: '#B45309',
            lines: [
              '• 🐾 全屏满铺：经典斜向全屏平铺，顶部配超大「🔄 全局重置」一键恢复。',
              '• 🎯 正中央大章：单枚醒目大章，可直接在右侧预览图上按住鼠标自由拖动！',
              '• 🎀 页眉页尾：自动留白中间正文区，并展开上下覆盖高度 % 独立调节滑块。'
            ]
          },
          {
            title: '🔒 三、PDF 像素烧录 & Word 三重防删锁',
            bg: '#F5F3FF',
            border: '#C4B5FD',
            titleColor: '#5B21B6',
            lines: [
              '• PDF 烧录加密：将水印与原页面合并为单张高清像素图层，彻底杜绝抠除。',
              '• Word 三种锁：支持「仅锁水印(正文可改)」「全文只读锁」或「转PDF烧录」。',
              '• 多方案分流：顶部方案 ①/②/③ 可为队列内不同文档分别指定不同水印样式。'
            ]
          }
        ];

        p1Cards.forEach((c, idx) => {
          const y0 = 122 + idx * 224;
          ctx.fillStyle = c.bg;
          ctx.strokeStyle = c.border;
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.roundRect(28, y0, w - 56, 204, 16);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = c.titleColor;
          ctx.font = 'bold 18px "PingFang SC", "Microsoft YaHei", sans-serif';
          ctx.fillText(c.title, 44, y0 + 38);

          ctx.fillStyle = '#1E293B';
          ctx.font = 'bold 15px "PingFang SC", "Microsoft YaHei", sans-serif';
          c.lines.forEach((l, li) => {
            ctx.fillText(l, 44, y0 + 80 + li * 42);
          });
        });

        ctx.fillStyle = '#64748B';
        ctx.font = 'bold 13.5px "PingFang SC", "Microsoft YaHei", sans-serif';
        ctx.fillText('💡 提示：按住右上角「👁️ 按住看原图」可对比盖章前后效果；翻到 P2 查看高级模式说明 ➔', 30, 816);

      } else {
        // 第 2 页：大字版 · 高级模式、样式槽规则与历史记录说明
        ctx.fillStyle = '#FEF3C7';
        ctx.fillRect(0, 0, w, 102);
        ctx.fillStyle = '#B45309';
        ctx.font = 'bold 23px "PingFang SC", "Microsoft YaHei", sans-serif';
        ctx.fillText('🛠️ 高级模式与目录管理说明 (P2 / 共2页)', 30, 50);
        ctx.fillStyle = '#92400E';
        ctx.font = 'bold 14px "PingFang SC", "Microsoft YaHei", sans-serif';
        ctx.fillText('点击顶栏「🛠️ 高级模式」或左侧「📜 历史记录 & 存储位置」即可使用以下功能', 30, 82);

        const p2Cards = [
          {
            title: '🌊 一、A4 轴对称倒角网格 (0°~180°) & 磁吸框',
            bg: '#FFFDF9',
            border: '#FDE68A',
            titleColor: '#B45309',
            lines: [
              '• 三款平滑倒角：a.顶点直连、b.内凹倒角、c.内外双圆角，支持 A~H 分组独立配色。',
              '• 自定义网格：支持 3×3、6×9、9×9 及 21×21 内任意网格按住鼠标涂抹点亮。',
              '• 分级重置：提供「全局重置」「印章字体重置」「偏移重置」「网格重置」互不误伤。'
            ]
          },
          {
            title: '📌 二、自定义样式槽三键分工（临时 vs 永久）',
            bg: '#FFF1F2',
            border: '#FECDD3',
            titleColor: '#BE123C',
            lines: [
              '• ➕ 临时存样式：仅在本次软件对话中临时有效，关闭软件自动清空不落盘。',
              '• 💾 存到「自定义样式」夹：将样式永久保存为同级子文件夹内的 .json 文件。',
              '• 📂 载入样式：仅支持读取本软件导出的格式；点标签 × 仅移除界面显示，不删原文件！'
            ]
          },
          {
            title: '📜 三、五大同级子文件夹 & 历史记录中心',
            bg: '#ECFDF5',
            border: '#A7F3D0',
            titleColor: '#047857',
            lines: [
              '• 五大固定子夹：系统资源、自定义图片、自定义样式、历史缓存、默认导出。',
              '• 左侧「历史记录 & 存储位置」：随时更改默认保存文件夹，记录永久保留直至手动删去。',
              '• 一键直达与撤回：点「📂 直达」直接唤起系统资源管理器定位文件，支持撤回与恢复！'
            ]
          }
        ];

        p2Cards.forEach((c, idx) => {
          const y0 = 122 + idx * 224;
          ctx.fillStyle = c.bg;
          ctx.strokeStyle = c.border;
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.roundRect(28, y0, w - 56, 204, 16);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = c.titleColor;
          ctx.font = 'bold 18px "PingFang SC", "Microsoft YaHei", sans-serif';
          ctx.fillText(c.title, 44, y0 + 38);

          ctx.fillStyle = '#1E293B';
          ctx.font = 'bold 15px "PingFang SC", "Microsoft YaHei", sans-serif';
          c.lines.forEach((l, li) => {
            ctx.fillText(l, 44, y0 + 80 + li * 42);
          });
        });

        ctx.fillStyle = '#64748B';
        ctx.font = 'bold 13.5px "PingFang SC", "Microsoft YaHei", sans-serif';
        ctx.fillText('🎁 打包压缩 (ZIP) 默认自动命名为「首个文件前4个字+等x个水印压缩包」，好找不重名！', 30, 816);
      }
    }

    function drawDemoBasePage() {
      if (state.demoPageNum > 2) state.demoPageNum = 1;
      drawDemoGuidePageOnCanvas(els.basePageCanvas, state.demoPageNum);
      els.previewSourceLabel.textContent = `当前底图：系统资源/预设说明书样板 (第 ${state.demoPageNum} / 2 页 · 可翻页)`;
      els.pageIndicator.textContent = `/ 2 页`;
      els.pageJumpInput.max = 2;
      els.pageJumpInput.value = state.demoPageNum;
      els.demoTemplateSelect.value = String(state.demoPageNum);
    }

    // Word (.docx) 富文本、内嵌图片(流程图/插图)与表格(含深色表头/底纹)全保真解析与分页预览引擎
    function wrapTextToWidth(ctx, text, maxW) {
      if (!text) return [''];
      const out = [];
      const rawLines = String(text).split(/\r?\n/);
      for (const raw of rawLines) {
        let cur = '';
        for (const ch of raw) {
          if (ctx.measureText(cur + ch).width > maxW && cur.length > 0) {
            out.push(cur);
            cur = ch;
          } else {
            cur += ch;
          }
        }
        if (cur || rawLines.length > 1) out.push(cur);
      }
      return out.length > 0 ? out : [''];
    }

    async function ensureDocxParsedPages(item) {
      if (item._docxPages) return item._docxPages;
      const fallbackPage = [[{ type: 'text', lines: ['Word 文档内容预览'], fontSize: 13, bold: false, color: '#1E293B', height: 24 }]];
      if (!window.JSZip) {
        item._docxPages = fallbackPage;
        return item._docxPages;
      }
      try {
        const zip = await window.JSZip.loadAsync(item.arrayBuffer);
        const docXmlFile = zip.file('word/document.xml');
        if (!docXmlFile) {
          item._docxPages = fallbackPage;
          return item._docxPages;
        }

        // 1. 解析 word/_rels/document.xml.rels 获取图片 rId -> media/* 映射
        const relMap = new Map();
        const relsFile = zip.file('word/_rels/document.xml.rels');
        if (relsFile) {
          const relsStr = await relsFile.async('string');
          const relsDoc = new DOMParser().parseFromString(relsStr, 'application/xml');
          const relNodes = relsDoc.getElementsByTagName('Relationship');
          for (let i = 0; i < relNodes.length; i++) {
            const id = relNodes[i].getAttribute('Id');
            const target = relNodes[i].getAttribute('Target');
            if (id && target) relMap.set(id, target.replace(/^\/+/, ''));
          }
        }

        // 2. 预加载 word/media/* 中的内嵌图片（支持 png/jpg/jpeg/gif/webp/bmp/svg）
        const mediaImgCache = new Map();
        async function getDocxMediaImage(rId) {
          if (!rId || !relMap.has(rId)) return null;
          if (mediaImgCache.has(rId)) return mediaImgCache.get(rId);
          let targetPath = relMap.get(rId);
          if (!targetPath.startsWith('word/')) {
            targetPath = 'word/' + targetPath.replace(/^\.\.\//, '');
          }
          const imgFile = zip.file(targetPath);
          if (!imgFile) return null;
          const ext = (targetPath.split('.').pop() || 'png').toLowerCase();
          const mimeMap = {
            png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg',
            gif: 'image/gif', webp: 'image/webp', bmp: 'image/bmp', svg: 'image/svg+xml'
          };
          const mime = mimeMap[ext];
          if (!mime) return null;
          try {
            const b64 = await imgFile.async('base64');
            const dataUrl = `data:${mime};base64,${b64}`;
            const imgEl = new Image();
            await new Promise(resolve => {
              imgEl.onload = resolve;
              imgEl.onerror = resolve;
              setTimeout(resolve, 600);
              imgEl.src = dataUrl;
            });
            if (imgEl.naturalWidth > 0 || imgEl.width > 0) {
              mediaImgCache.set(rId, imgEl);
              return imgEl;
            }
          } catch (e) {}
          return null;
        }

        const xmlStr = await docXmlFile.async('string');
        const xmlDoc = new DOMParser().parseFromString(xmlStr, 'application/xml');
        const bodyNode = xmlDoc.getElementsByTagName('w:body')[0] || xmlDoc.documentElement;

        const measureCanvas = document.createElement('canvas');
        const mCtx = measureCanvas.getContext('2d');
        const maxContentW = 515;
        const blocks = [];

        async function extractImagesFromNode(node) {
          const imgs = [];
          const blips = node.getElementsByTagName('a:blip');
          for (let i = 0; i < blips.length; i++) {
            const rId = blips[i].getAttribute('r:embed') || blips[i].getAttribute('embed');
            const imgEl = await getDocxMediaImage(rId);
            if (imgEl) {
              // 查找最近的 wp:extent 尺寸 (EMU: 914400 = 96px)
              let drawW = 0, drawH = 0;
              let p = blips[i].parentNode;
              while (p && p !== node) {
                const extNodes = p.getElementsByTagName ? p.getElementsByTagName('wp:extent') : [];
                if (extNodes && extNodes.length > 0) {
                  const cx = parseInt(extNodes[0].getAttribute('cx') || '0', 10);
                  const cy = parseInt(extNodes[0].getAttribute('cy') || '0', 10);
                  if (cx > 0 && cy > 0) {
                    drawW = (cx / 914400) * 72;
                    drawH = (cy / 914400) * 72;
                  }
                  break;
                }
                p = p.parentNode;
              }
              const nw = imgEl.naturalWidth || imgEl.width || 320;
              const nh = imgEl.naturalHeight || imgEl.height || 200;
              if (!drawW || !drawH) {
                drawW = Math.min(maxContentW, nw * 0.65);
                drawH = drawW * (nh / nw);
              }
              if (drawW > maxContentW) {
                const ratio = maxContentW / drawW;
                drawW = maxContentW;
                drawH = drawH * ratio;
              }
              if (drawH > 460) {
                const ratio = 460 / drawH;
                drawH = 460;
                drawW = drawW * ratio;
              }
              imgs.push({ imgEl, drawW: Math.round(drawW), drawH: Math.round(drawH) });
            }
          }
          // 兼容 VML v:imagedata
          const vImgs = node.getElementsByTagName('v:imagedata');
          for (let i = 0; i < vImgs.length; i++) {
            const rId = vImgs[i].getAttribute('r:id') || vImgs[i].getAttribute('id');
            const imgEl = await getDocxMediaImage(rId);
            if (imgEl) {
              const nw = imgEl.naturalWidth || imgEl.width || 320;
              const nh = imgEl.naturalHeight || imgEl.height || 200;
              const drawW = Math.min(maxContentW, 380);
              const drawH = Math.min(440, drawW * (nh / nw));
              imgs.push({ imgEl, drawW: Math.round(drawW), drawH: Math.round(drawH) });
            }
          }
          return imgs;
        }

        const children = bodyNode.childNodes || [];
        for (let idx = 0; idx < children.length; idx++) {
          const child = children[idx];
          if (!child || !child.nodeName) continue;
          const tag = child.nodeName.toLowerCase();

          if (tag === 'w:p') {
            // 检查是否含显式分页符
            const hasPageBreak = (
              child.getElementsByTagName('w:lastRenderedPageBreak').length > 0 ||
              Array.from(child.getElementsByTagName('w:br')).some(b => b.getAttribute('w:type') === 'page')
            );
            if (hasPageBreak && blocks.length > 0) {
              blocks.push({ type: 'page_break' });
            }

            // 提取段落内嵌图片（如流程图、架构图）
            const pImgs = await extractImagesFromNode(child);
            for (const im of pImgs) {
              blocks.push({
                type: 'image',
                imgEl: im.imgEl,
                drawW: im.drawW,
                drawH: im.drawH,
                height: im.drawH + 14
              });
            }

            // 提取段落文字与标题样式
            const tNodes = child.getElementsByTagName('w:t');
            let pText = '';
            for (let j = 0; j < tNodes.length; j++) {
              pText += tNodes[j].textContent || '';
            }
            pText = pText.trim();
            if (pText) {
              const pStyleNode = child.getElementsByTagName('w:pStyle')[0];
              const styleVal = pStyleNode ? (pStyleNode.getAttribute('w:val') || '') : '';
              const isHeading = /^(Heading|1|2|3|4|Title)/i.test(styleVal) || child.getElementsByTagName('w:outlineLvl').length > 0;
              const isBold = isHeading || child.getElementsByTagName('w:b').length > 0;
              let fontSize = isHeading ? 14.5 : 12;
              const szNode = child.getElementsByTagName('w:sz')[0];
              if (szNode) {
                const halfPt = parseInt(szNode.getAttribute('w:val') || '0', 10);
                if (halfPt >= 16 && halfPt <= 72) {
                  fontSize = Math.max(10.5, Math.min(20, halfPt / 2));
                }
              }
              let color = isHeading ? '#1E3A8A' : '#1E293B';
              const colNode = child.getElementsByTagName('w:color')[0];
              if (colNode) {
                const cVal = colNode.getAttribute('w:val');
                if (cVal && cVal !== 'auto' && /^[0-9A-Fa-f]{6}$/.test(cVal)) {
                  color = '#' + cVal;
                }
              }
              mCtx.font = `${isBold ? 'bold ' : ''}${fontSize}px "PingFang SC", "Microsoft YaHei", sans-serif`;
              const lines = wrapTextToWidth(mCtx, pText, maxContentW);
              const lineH = Math.round(fontSize * 1.48);
              blocks.push({
                type: 'text',
                lines,
                fontSize,
                bold: isBold,
                color,
                lineH,
                height: lines.length * lineH + 6
              });
            }
          } else if (tag === 'w:tbl') {
            // 解析 Word 表格（还原表头深色底纹、斑马纹、单元格边框与多行文字）
            const trNodes = Array.from(child.childNodes).filter(n => n.nodeName && n.nodeName.toLowerCase() === 'w:tr');
            for (let rIdx = 0; rIdx < trNodes.length; rIdx++) {
              const tr = trNodes[rIdx];
              const tcNodes = Array.from(tr.childNodes).filter(n => n.nodeName && n.nodeName.toLowerCase() === 'w:tc');
              if (tcNodes.length === 0) continue;
              const colCount = tcNodes.length;
              const cellW = maxContentW / colCount;
              const rowCells = [];
              let maxCellLines = 1;

              for (let cIdx = 0; cIdx < colCount; cIdx++) {
                const tc = tcNodes[cIdx];
                // 检查单元格背景色 w:shd
                let bgFill = rIdx === 0 ? '#1E3A8A' : (rIdx % 2 === 1 ? '#F8FAFC' : '#FFFFFF');
                const shdNodes = tc.getElementsByTagName('w:shd');
                if (shdNodes.length > 0) {
                  const fillAttr = shdNodes[0].getAttribute('w:fill');
                  if (fillAttr && fillAttr !== 'auto' && /^[0-9A-Fa-f]{6}$/.test(fillAttr)) {
                    bgFill = '#' + fillAttr;
                  }
                }
                // 判断深色背景用白字
                const hexClean = bgFill.replace('#', '');
                const rVal = parseInt(hexClean.slice(0, 2), 16) || 255;
                const gVal = parseInt(hexClean.slice(2, 4), 16) || 255;
                const bVal = parseInt(hexClean.slice(4, 6), 16) || 255;
                const lum = 0.299 * rVal + 0.587 * gVal + 0.114 * bVal;
                const textColor = lum < 140 ? '#FFFFFF' : '#1E293B';
                const isBold = (rIdx === 0 || lum < 140 || tc.getElementsByTagName('w:b').length > 0);

                const tNodes = tc.getElementsByTagName('w:t');
                let cellText = '';
                for (let t = 0; t < tNodes.length; t++) {
                  cellText += tNodes[t].textContent || '';
                }
                cellText = cellText.trim();
                mCtx.font = `${isBold ? 'bold ' : ''}10.5px "PingFang SC", "Microsoft YaHei", sans-serif`;
                const cellLines = wrapTextToWidth(mCtx, cellText, Math.max(40, cellW - 12));
                if (cellLines.length > maxCellLines) maxCellLines = cellLines.length;
                rowCells.push({
                  lines: cellLines,
                  bgFill,
                  textColor,
                  bold: isBold
                });
              }

              const rowH = Math.max(24, maxCellLines * 15 + 10);
              blocks.push({
                type: 'table_row',
                cells: rowCells,
                colCount,
                rowH,
                height: rowH
              });
            }
            blocks.push({ type: 'spacer', height: 8 });
          }
        }

        // 3. 将富文本块分页（每页可用高度约 715px）
        const pages = [];
        let curPage = [];
        let curH = 0;
        const maxPageH = 715;

        for (const blk of blocks) {
          if (blk.type === 'page_break') {
            if (curPage.length > 0) {
              pages.push(curPage);
              curPage = [];
              curH = 0;
            }
            continue;
          }
          const bh = blk.height || 20;
          if (curH + bh > maxPageH && curPage.length > 0) {
            pages.push(curPage);
            curPage = [blk];
            curH = bh;
          } else {
            curPage.push(blk);
            curH += bh;
          }
        }
        if (curPage.length > 0) pages.push(curPage);
        item._docxPages = pages.length > 0 ? pages : fallbackPage;
        return item._docxPages;
      } catch (e) {
        item._docxPages = fallbackPage;
        return item._docxPages;
      }
    }

    function drawDocxPageToCanvas(canvas, docName, pagesOrBlocks, pageNum, totalPages) {
      const ctx = canvas.getContext('2d');
      const w = canvas.width;
      const h = canvas.height;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, w, h);

      const scale = w / 595;
      ctx.save();
      ctx.scale(scale, scale);

      // 顶部轻量化文档页眉信息条
      ctx.fillStyle = '#EFF6FF';
      ctx.fillRect(0, 0, 595, 54);
      ctx.fillStyle = '#1D4ED8';
      ctx.font = 'bold 14px "PingFang SC", "Microsoft YaHei", sans-serif';
      ctx.fillText(`📘 Word 预览：${docName.slice(0, 28)}`, 36, 26);
      ctx.fillStyle = '#3B82F6';
      ctx.font = '10.5px "PingFang SC", "Microsoft YaHei", sans-serif';
      ctx.fillText(`第 ${pageNum} / ${totalPages} 页 · 已启用顶层水印引擎（表格与图片绝不遮挡水印）`, 36, 44);

      const pageBlocks = (Array.isArray(pagesOrBlocks) && Array.isArray(pagesOrBlocks[pageNum - 1]))
        ? pagesOrBlocks[pageNum - 1]
        : [];

      let y = 74;
      const leftX = 40;
      const maxContentW = 515;

      for (const blk of pageBlocks) {
        if (blk.type === 'spacer') {
          y += blk.height || 8;
        } else if (blk.type === 'image' && blk.imgEl) {
          const imgX = leftX + (maxContentW - blk.drawW) / 2;
          ctx.save();
          ctx.strokeStyle = '#E2E8F0';
          ctx.lineWidth = 1;
          ctx.strokeRect(imgX - 1, y - 1, blk.drawW + 2, blk.drawH + 2);
          ctx.drawImage(blk.imgEl, imgX, y, blk.drawW, blk.drawH);
          ctx.restore();
          y += blk.height;
        } else if (blk.type === 'table_row' && Array.isArray(blk.cells)) {
          const cellW = maxContentW / (blk.colCount || 1);
          blk.cells.forEach((cell, cIdx) => {
            const cx = leftX + cIdx * cellW;
            ctx.fillStyle = cell.bgFill || '#FFFFFF';
            ctx.fillRect(cx, y, cellW, blk.rowH);
            ctx.strokeStyle = '#CBD5E1';
            ctx.lineWidth = 0.8;
            ctx.strokeRect(cx, y, cellW, blk.rowH);

            ctx.fillStyle = cell.textColor || '#1E293B';
            ctx.font = `${cell.bold ? 'bold ' : ''}10.5px "PingFang SC", "Microsoft YaHei", sans-serif`;
            cell.lines.forEach((ln, lIdx) => {
              ctx.fillText(ln, cx + 5, y + 14 + lIdx * 15);
            });
          });
          y += blk.rowH;
        } else if (blk.type === 'text' && Array.isArray(blk.lines)) {
          ctx.fillStyle = blk.color || '#1E293B';
          ctx.font = `${blk.bold ? 'bold ' : ''}${blk.fontSize || 12}px "PingFang SC", "Microsoft YaHei", sans-serif`;
          const lh = blk.lineH || 18;
          blk.lines.forEach(ln => {
            ctx.fillText(ln, leftX, y + lh * 0.8);
            y += lh;
          });
          y += 6;
        }
      }
      ctx.restore();
    }

    async function renderUploadedDocxPage(activeItem) {
      const pages = await ensureDocxParsedPages(activeItem);
      const totalPages = Math.max(1, pages.length);
      state.activeTotalPages = totalPages;
      if (state.activePageNum > totalPages) state.activePageNum = 1;

      els.basePageCanvas.height = 842;
      els.watermarkOverlayCanvas.height = 842;
      drawDocxPageToCanvas(els.basePageCanvas, activeItem.name, pages, state.activePageNum, totalPages);

      els.previewSourceLabel.textContent = `当前底图：${activeItem.name} (第 ${state.activePageNum}/${totalPages} 页 · Word 含图表预览)`;
      els.pageIndicator.textContent = `/ ${totalPages} 页`;
      els.pageJumpInput.max = totalPages;
      els.pageJumpInput.value = state.activePageNum;
      renderWatermarkOverlay();
    }

    async function renderUploadedPdfPage() {
      const activeItem = state.files.find(f => f.id === state.activeFileId);
      if (!activeItem || !window.pdfjsLib) {
        drawDemoBasePage();
        renderWatermarkOverlay();
        return;
      }
      if (activeItem.fileType === 'docx') {
        await renderUploadedDocxPage(activeItem);
        return;
      }
      try {
        const loadingTask = window.pdfjsLib.getDocument({ data: activeItem.arrayBuffer.slice(0) });
        const pdf = await loadingTask.promise;
        state.activeTotalPages = pdf.numPages;
        if (state.activePageNum > pdf.numPages) state.activePageNum = 1;

        const page = await pdf.getPage(state.activePageNum);
        const canvas = els.basePageCanvas;
        const ctx = canvas.getContext('2d');

        const baseViewport = page.getViewport({ scale: 1 });
        const scale = canvas.width / baseViewport.width;
        const viewport = page.getViewport({ scale });

        canvas.height = viewport.height;
        els.watermarkOverlayCanvas.height = viewport.height;

        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        await page.render({ canvasContext: ctx, viewport }).promise;

        els.previewSourceLabel.textContent = `当前底图：${activeItem.name} (第 ${state.activePageNum}/${pdf.numPages} 页)`;
        els.pageIndicator.textContent = `/ ${pdf.numPages} 页`;
        els.pageJumpInput.max = pdf.numPages;
        els.pageJumpInput.value = state.activePageNum;

        renderWatermarkOverlay();
      } catch (err) {
        drawDemoBasePage();
        renderWatermarkOverlay();
      }
    }

    function drawStampUnit(ctx, text, fontSize, styleObj) {
      const stampImg = getStampImageForStyle(styleObj);
      const scaleRatio = Math.max(0.2, Math.min(3.0, (styleObj.stampScale || 100) / 100));
      const lines = text ? text.split(/\n|\//).map(s => s.trim()).filter(Boolean) : [];
      const hasText = lines.length > 0;

      if (stampImg && stampImg.complete && (stampImg.naturalWidth > 0 || stampImg.width > 0)) {
        const nw = stampImg.naturalWidth || stampImg.width || 120;
        const nh = stampImg.naturalHeight || stampImg.height || 120;
        const aspect = nw / nh;
        const baseLen = fontSize * 1.65 * scaleRatio;
        const drawW = aspect >= 1 ? baseLen : baseLen * aspect;
        const drawH = aspect >= 1 ? baseLen / aspect : baseLen;

        if (!hasText) {
          ctx.drawImage(stampImg, -drawW / 2, -drawH / 2, drawW, drawH);
          return;
        } else {
          const totalTextH = lines.length * fontSize * 1.2;
          ctx.drawImage(stampImg, -drawW / 2, -drawH - totalTextH * 0.45, drawW, drawH);
        }
      }

      if (hasText) {
        const lineHeight = fontSize * 1.22;
        const startY = -((lines.length - 1) * lineHeight) / 2;
        lines.forEach((line, idx) => {
          const yPos = startY + idx * lineHeight;
          if (styleObj.hollowText) {
            ctx.lineWidth = Math.max(1.2, fontSize * 0.06);
            ctx.strokeStyle = styleObj.color;
            ctx.strokeText(line, 0, yPos);
          } else {
            ctx.fillText(line, 0, yPos);
          }
        });
      }
    }

    // 问题5改良：让水平/垂直偏移在平铺模式下直接在世界坐标系下直观平移整片水印阵列（spanW/spanH固定，不因offX改变奇偶行相位）
    function fillTiledWatermarksInRegion(ctx, rx, ry, rw, rh, rad, stepX, stepY, text, fontSize, styleObj) {
      ctx.save();
      const scaleFactor = rw / 595;
      const offX = (styleObj.offsetX || 0) * scaleFactor;
      const offY = (styleObj.offsetY || 0) * scaleFactor;
      const cx = rx + rw / 2 + offX;
      const cy = ry + rh / 2 + offY;
      ctx.translate(cx, cy);
      ctx.rotate(rad);

      const cos = Math.abs(Math.cos(rad));
      const sin = Math.abs(Math.sin(rad));
      const extraReach = 320 * scaleFactor;
      const spanW = rw * cos + rh * sin + extraReach * 2;
      const spanH = rw * sin + rh * cos + extraReach * 2;

      const startX = -spanW / 2;
      const startY = -spanH / 2;
      const stagger = styleObj.staggerRow !== false;

      let rowIdx = 0;
      for (let y = startY; y <= spanH / 2 + stepY; y += stepY) {
        const offset = (stagger && rowIdx % 2 !== 0) ? stepX / 2 : 0;
        for (let x = startX - stepX; x <= spanW / 2 + stepX; x += stepX) {
          ctx.save();
          ctx.translate(x + offset, y);
          drawStampUnit(ctx, text, fontSize, styleObj);
          ctx.restore();
        }
        rowIdx++;
      }
      ctx.restore();
    }

    // 核心绘制引擎
    function paintWatermarkOnCanvas(canvas, drawGridGuide = false, styleObj = null) {
      if (!styleObj) {
        const activeFile = state.files.find(f => f.id === state.activeFileId);
        styleObj = state.editingFileId ? getActiveStyle() : (activeFile ? getStyleForFile(activeFile) : getActiveStyle());
      }

      const ctx = canvas.getContext('2d');
      const w = canvas.width;
      const h = canvas.height;
      ctx.clearRect(0, 0, w, h);

      if (state.holdOriginal) return;

      const curViewPage = state.activeFileId ? state.activePageNum : state.demoPageNum;
      const curTotalPages = state.activeFileId ? state.activeTotalPages : state.demoTotalPages;

      if (drawGridGuide && !isPageInStampRange(curViewPage, curTotalPages, styleObj)) {
        ctx.save();
        ctx.fillStyle = 'rgba(16, 185, 129, 0.92)';
        ctx.beginPath();
        ctx.roundRect(w / 2 - 145, 18, 290, 28, 10);
        ctx.fill();
        ctx.fillStyle = '#FFFFFF';
        ctx.font = 'bold 12px "PingFang SC", sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(`🛡️ 当前第 ${curViewPage} 页不在盖章范围内（导出时保持留白）`, w / 2, 32);
        ctx.restore();
        return;
      }

      const text = getEffectiveWatermarkText(styleObj);
      const stampImg = getStampImageForStyle(styleObj);
      const hasAnyContent = text.length > 0 || Boolean(stampImg);

      const alpha = Math.max(0.01, Math.min(1, styleObj.opacity / 100));
      const rad = (styleObj.angle * Math.PI) / 180;
      const fontSize = styleObj.fontSize * (w / 595);
      const gap = styleObj.gap * (w / 595);

      ctx.save();
      ctx.font = `bold ${fontSize}px ${styleObj.fontFamily}`;
      ctx.fillStyle = styleObj.color;
      ctx.globalAlpha = alpha;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      const lines = text ? text.split(/\n|\//).map(s => s.trim()).filter(Boolean) : [];
      let maxLineWidth = 0;
      lines.forEach(l => {
        const m = ctx.measureText(l).width;
        if (m > maxLineWidth) maxLineWidth = m;
      });

      const scaleRatio = Math.max(0.2, Math.min(3.0, (styleObj.stampScale || 100) / 100));
      const stampSpan = stampImg ? (fontSize * 1.65 * scaleRatio) : 0;
      const unitW = Math.max(maxLineWidth, stampSpan);
      const unitH = (lines.length * fontSize * 1.25) + (stampImg ? stampSpan * 0.85 : 0);

      const rowScale = Math.max(0.4, Math.min(2.5, (styleObj.rowGapScale || 100) / 100));
      const stepX = Math.max(unitW + gap * 0.65, gap);
      const stepY = Math.max(unitH + gap * 0.55, gap * 0.78) * rowScale;

      if (styleObj.coverageMode === 'box') {
        const bx = (styleObj.boxLeft / 100) * w;
        const by = (styleObj.boxTop / 100) * h;
        const bw = Math.max(12, w * (1 - (styleObj.boxLeft + styleObj.boxRight) / 100));
        const bh = Math.max(12, h * (1 - (styleObj.boxTop + styleObj.boxBottom) / 100));

        if (hasAnyContent) {
          ctx.save();
          if (styleObj.singlePerZone && !styleObj.boxInvert) {
            ctx.translate(bx + bw / 2 + (styleObj.offsetX || 0) * (w / 595), by + bh / 2 + (styleObj.offsetY || 0) * (w / 595));
            ctx.rotate(rad);
            drawStampUnit(ctx, text, fontSize, styleObj);
          } else {
            ctx.beginPath();
            if (styleObj.boxInvert) {
              ctx.rect(0, 0, w, h);
              ctx.rect(bx, by, bw, bh);
              ctx.clip('evenodd');
            } else {
              ctx.rect(bx, by, bw, bh);
              ctx.clip();
            }
            fillTiledWatermarksInRegion(ctx, 0, 0, w, h, rad, stepX, stepY, text, fontSize, styleObj);
          }
          ctx.restore();
        }

        if (drawGridGuide && state.showGridLines) {
          ctx.save();
          ctx.globalAlpha = 1;
          ctx.strokeStyle = styleObj.boxInvert ? '#10B981' : '#F43F5E';
          ctx.lineWidth = 2;
          ctx.setLineDash([7, 5]);
          ctx.strokeRect(bx, by, bw, bh);
          ctx.setLineDash([]);

          const handles = [
            { x: bx + bw / 2, y: by },
            { x: bx + bw / 2, y: by + bh },
            { x: bx, y: by + bh / 2 },
            { x: bx + bw, y: by + bh / 2 }
          ];
          handles.forEach(hd => {
            ctx.fillStyle = '#FFFFFF';
            ctx.strokeStyle = styleObj.boxInvert ? '#10B981' : '#F43F5E';
            ctx.lineWidth = 2.2;
            ctx.beginPath();
            ctx.arc(hd.x, hd.y, 7, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
          });

          const tagX = Math.max(6, Math.min(w - 170, bx + 8));
          const tagY = Math.max(6, Math.min(h - 28, by + 8));
          ctx.fillStyle = styleObj.boxInvert ? 'rgba(16, 185, 129, 0.9)' : 'rgba(244, 63, 94, 0.9)';
          ctx.beginPath();
          ctx.roundRect(tagX, tagY, 162, 22, 6);
          ctx.fill();
          ctx.fillStyle = '#FFFFFF';
          ctx.font = 'bold 11px sans-serif';
          ctx.textAlign = 'left';
          ctx.fillText(styleObj.boxInvert ? '🛡️ 框内留白保护 (拖拽四边)' : '🎯 框内盖章区 (拖拽四边)', tagX + 8, tagY + 11);
          ctx.restore();
        }

      } else {
        // ========== A4比例网格与图1同款「100%轴对称内凹圆弧倒角」引擎 ==========
        const cols = styleObj.gridCols || 3;
        const rows = styleObj.gridRows || 3;
        const total = cols * rows;
        const cells = (Array.isArray(styleObj.gridCells) && styleObj.gridCells.length === total)
          ? styleObj.gridCells
          : new Array(total).fill(1);

        const presentGroups = Array.from(new Set(cells.filter(v => v > 0))).sort((a, b) => a - b);

        presentGroups.forEach(groupVal => {
          ctx.save();
          ctx.beginPath();
          const centroids = buildChamferedGroupPath(ctx, cells, cols, rows, w, h, styleObj, groupVal);

          const pal = (groupVal === INDEPENDENT_GROUP_VAL)
            ? { fillRgba: 'rgba(20, 184, 166, 0.055)', strokeRgba: 'rgba(20, 184, 166, 0.45)' }
            : (GROUP_PALETTE[groupVal] || GROUP_PALETTE[1]);

          if (styleObj.singlePerZone) {
            if (drawGridGuide && state.showGridLines) {
              ctx.save();
              ctx.globalAlpha = 1;
              centroids.forEach(pt => {
                const ax = pt.cx + (styleObj.offsetX || 0) * (w / 595);
                const ay = pt.cy + (styleObj.offsetY || 0) * (w / 595);
                ctx.strokeStyle = 'rgba(244, 63, 94, 0.45)';
                ctx.lineWidth = 1.5;
                ctx.setLineDash([4, 4]);
                ctx.beginPath();
                ctx.arc(ax, ay, 18, 0, Math.PI * 2);
                ctx.stroke();
                ctx.setLineDash([]);
                ctx.fillStyle = '#F43F5E';
                ctx.beginPath();
                ctx.arc(ax, ay, 4, 0, Math.PI * 2);
                ctx.fill();
              });
              ctx.restore();
            }

            if (hasAnyContent) {
              centroids.forEach(pt => {
                ctx.save();
                ctx.translate(pt.cx + (styleObj.offsetX || 0) * (w / 595), pt.cy + (styleObj.offsetY || 0) * (w / 595));
                ctx.rotate(rad);
                drawStampUnit(ctx, text, fontSize, styleObj);
                ctx.restore();
              });
            }
          } else {
            if (drawGridGuide && state.showGridLines && cells.filter(v => v > 0).length < total) {
              ctx.save();
              ctx.globalAlpha = 1;
              ctx.fillStyle = pal.fillRgba;
              ctx.fill('nonzero');
              ctx.strokeStyle = pal.strokeRgba;
              ctx.lineWidth = 1.8;
              ctx.setLineDash([7, 5]);
              ctx.stroke();
              ctx.restore();
            }

            if (hasAnyContent) {
              ctx.clip('nonzero');
              fillTiledWatermarksInRegion(ctx, 0, 0, w, h, rad, stepX, stepY, text, fontSize, styleObj);
            }
          }

          ctx.restore();
        });

        // 底层 A4 比例网格参考线
        if (drawGridGuide && state.showGridLines && !styleObj.singlePerZone) {
          ctx.save();
          ctx.globalAlpha = 1;
          ctx.strokeStyle = 'rgba(244, 63, 94, 0.13)';
          ctx.lineWidth = 1;
          ctx.setLineDash([4, 4]);
          const cellW = w / cols;
          const cellH = h / rows;
          for (let c = 1; c < cols; c++) {
            ctx.beginPath(); ctx.moveTo(cellW * c, 0); ctx.lineTo(cellW * c, h); ctx.stroke();
          }
          for (let r = 1; r < rows; r++) {
            ctx.beginPath(); ctx.moveTo(0, cellH * r); ctx.lineTo(w, cellH * r); ctx.stroke();
          }
          ctx.restore();
        }
      }

      ctx.restore();
    }

    function renderWatermarkOverlay() {
      const s = getActiveStyle();
      paintWatermarkOnCanvas(els.watermarkOverlayCanvas, true, s);

      const hasText = Boolean(s.enableText);
      const hasStamp = Boolean(s.enableStamp && s.stampType !== 'none');
      const isCustomText = (s.watermarkText || '').trim().length > 0;

      if (!hasText && !hasStamp) {
        els.activeTextStatusBadge.textContent = '🚫 无水印';
        els.activeTextStatusBadge.className = 'hidden sm:inline-block text-[11px] px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-300 font-bold';
      } else if (!hasText && hasStamp) {
        els.activeTextStatusBadge.textContent = '🐾 仅图案';
        els.activeTextStatusBadge.className = 'hidden sm:inline-block text-[11px] px-2 py-0.5 rounded-full bg-purple-100 text-purple-800 border border-purple-300 font-bold';
      } else if (hasText && hasStamp) {
        els.activeTextStatusBadge.textContent = '✨ 文字+图案';
        els.activeTextStatusBadge.className = 'hidden sm:inline-block text-[11px] px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 border border-rose-300 font-bold';
      } else {
        els.activeTextStatusBadge.textContent = isCustomText ? '✍️ 自定义文字' : '✨ 默认词生效';
        els.activeTextStatusBadge.className = 'hidden sm:inline-block text-[11px] px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-300 font-bold';
      }

      const effectiveText = getEffectiveWatermarkText(s);
      if (!hasText && !hasStamp) {
        els.liveSummaryLeft.textContent = '印章：[无文字 · 无图案]';
      } else if (!hasText && hasStamp) {
        els.liveSummaryLeft.textContent = `印章：[纯图案 · 缩放${s.stampScale || 100}%]`;
      } else {
        els.liveSummaryLeft.textContent = `印章：「${effectiveText}」${hasStamp ? ' + 🐾图案' : ''}`;
      }
      els.liveSummaryRight.textContent = `${s.fontSize}px · ${s.opacity}%透明 · ${s.angle}°${s.singlePerZone ? ' · 独苗大章(可拖拽)' : ` · 间距${s.gap}`}`;

      if (els.noSuffixToggle) {
        els.noSuffixToggle.checked = Boolean(state.noSuffix);
      }
      if (els.customSuffixInput) {
        els.customSuffixInput.disabled = Boolean(state.noSuffix);
        els.customSuffixInput.classList.toggle('opacity-50', Boolean(state.noSuffix));
        els.customSuffixInput.placeholder = state.noSuffix ? '已勾选「无后缀」，导出保持原文件名' : '默认：-西西专属水印版';
      }
      els.suffixPreviewPill.textContent = state.noSuffix
        ? '示例：合同.pdf ➔ 合同.pdf (无后缀保持原名)'
        : `示例：合同.pdf ➔ 合同${getEffectiveSuffix()}.pdf`;
      savePrefsToStorage();
      renderFileQueue();
    }

    function syncGlobalLockButtonUI() {
      if (!els.btnToggleAllLock) return;
      const allLocked = state.files.length > 0
        ? state.files.every(f => f.locked !== false)
        : state.defaultLockBurn;
      if (allLocked) {
        els.btnToggleAllLock.className = 'px-2 py-0.5 rounded-lg text-[11px] font-extrabold border transition cursor-pointer bg-rose-500 text-white border-rose-600 shadow-2xs flex items-center gap-1';
        els.btnToggleAllLock.innerHTML = '<span>🔒 烧录加密(全锁)</span>';
      } else {
        els.btnToggleAllLock.className = 'px-2 py-0.5 rounded-lg text-[11px] font-extrabold border transition cursor-pointer bg-white text-slate-600 border-slate-300 hover:bg-rose-50 flex items-center gap-1';
        els.btnToggleAllLock.innerHTML = '<span>🔓 普通模式(未全锁)</span>';
      }
      if (els.wordLockModeSelect) {
        els.wordLockModeSelect.value = state.wordLockMode || 'sdt';
      }
    }

    function renderFileQueue() {
      syncGlobalLockButtonUI();
      syncDynamicZipFolderName();
      els.fileCountBadge.textContent = `📂 已装填 ${state.files.length} / 20 个文件`;
      if (state.files.length === 0) {
        els.btnClearQueue.classList.add('hidden');
        els.batchAssignBar.classList.add('hidden');
        els.batchAssignBar.classList.remove('flex');
        els.fileQueueList.innerHTML = `
          <div class="text-center py-3.5 px-3 rounded-2xl bg-amber-50/60 border border-dashed border-amber-200 text-xs text-amber-800">
            当前正在预览右侧 2 页大字版<b>《功能说明与演示样板》</b>（存于同级「系统资源」夹） · 拖入本地 PDF 或 Word(.docx) 可批量盖章，直接点下方导出则会将该 2 页样板盖章存出！
          </div>
        `;
        return;
      }

      els.btnClearQueue.classList.remove('hidden');
      els.batchAssignBar.classList.remove('hidden');
      els.batchAssignBar.classList.add('flex');
      els.fileQueueList.innerHTML = '';

      state.files.forEach((item, index) => {
        const isCurrentPreview = item.id === state.activeFileId;
        const isEditingThis = item.id === state.editingFileId;
        const isLocked = item.locked !== false;
        const isDocx = item.fileType === 'docx';
        const outName = buildOutputFileName(item.name, item);
        const itemStyle = getStyleForFile(item);
        const pIdx = item.profileIndex || 0;
        const labelTxt = !itemStyle.enableText
          ? (itemStyle.enableStamp ? '纯图案' : '无水印')
          : getEffectiveWatermarkText(itemStyle).slice(0, 6);
        const styleSummary = item.useCustomStyle
          ? `🎨 专属:「${labelTxt}」${itemStyle.fontSize}px`
          : `🔗 ${PROFILE_LABELS[pIdx]} (${itemStyle.fontSize}px/${itemStyle.angle}°)`;

        const row = document.createElement('div');
        row.className = `p-2.5 rounded-xl border-2 flex items-center justify-between gap-2 flex-wrap sm:flex-nowrap transition ${
          isEditingThis
            ? 'bg-purple-50/90 border-purple-400 shadow-2xs'
            : (isCurrentPreview ? 'bg-rose-50 border-rose-400 shadow-2xs' : 'bg-white border-rose-100 hover:border-rose-200')
        }`;
        row.innerHTML = `
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-5 h-5 rounded-md bg-rose-100 text-rose-700 font-extrabold text-[11px] flex items-center justify-center shrink-0">
              ${index + 1}
            </span>
            <div class="min-w-0">
              <div class="text-xs font-bold text-rose-950 truncate flex items-center gap-1.5" title="${item.name}">
                <span class="truncate">${item.name}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded-md ${
                  item.useCustomStyle ? 'bg-purple-100 text-purple-800 border border-purple-300 font-bold' : 'bg-rose-50 text-rose-600 border border-rose-200 font-semibold'
                } shrink-0">${styleSummary}</span>
              </div>
              <div class="text-[11px] text-emerald-700 font-medium truncate" title="${outName}">
                ➔ <span class="font-bold">${outName}</span>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-1 shrink-0 ml-auto">
            <select data-action="profile-select" class="px-2 py-1 rounded-lg text-[11px] font-bold border transition cursor-pointer focus:outline-none ${
              item.useCustomStyle
                ? 'bg-purple-600 text-white border-purple-600'
                : 'bg-amber-50 text-amber-900 border-amber-200 hover:bg-amber-100'
            }">
              <option value="0" ${!item.useCustomStyle && pIdx === 0 ? 'selected' : ''}>🔗 方案 ①</option>
              <option value="1" ${!item.useCustomStyle && pIdx === 1 ? 'selected' : ''}>🔗 方案 ②</option>
              <option value="2" ${!item.useCustomStyle && pIdx === 2 ? 'selected' : ''}>🔗 方案 ③</option>
              <option value="custom" ${item.useCustomStyle ? 'selected' : ''}>🎨 单独定制</option>
            </select>
            <button type="button" data-action="custom" class="px-2 py-1 rounded-lg text-[11px] font-bold border transition ${
              isEditingThis
                ? 'bg-purple-600 text-white border-purple-600'
                : 'bg-white text-purple-800 border-purple-200 hover:bg-purple-50'
            }">
              ${isEditingThis ? '调教中' : '🎨开小灶'}
            </button>
            <button type="button" data-action="toggle-lock" title="${
              isLocked
                ? (isDocx ? '已开启防删加密锁（点击可单独解锁）' : '已开启强力烧录+权限加密（点击可单独解锁为普通图层）')
                : '当前未加密（点击开启防删烧录加密）'
            }" class="px-2 py-1 rounded-lg text-[11px] font-extrabold border transition cursor-pointer ${
              isLocked
                ? 'bg-rose-500 text-white border-rose-600 shadow-2xs'
                : 'bg-slate-50 text-slate-500 border-slate-200 hover:bg-rose-50 hover:text-rose-700'
            }">
              ${isLocked ? '🔒加密' : '🔓常规'}
            </button>
            <button type="button" data-action="preview" class="px-2 py-1 rounded-lg text-[11px] font-bold border ${
              isCurrentPreview
                ? 'bg-rose-500 text-white border-rose-500'
                : 'bg-rose-50 text-rose-700 border-rose-200 hover:bg-rose-100'
            }">
              ${isCurrentPreview ? '预览中' : '预览'}
            </button>
            <button type="button" data-action="remove" class="w-6 h-6 rounded-lg bg-rose-50 hover:bg-rose-200 text-rose-500 font-bold text-xs flex items-center justify-center">
              ✕
            </button>
          </div>
        `;

        row.querySelector('[data-action="profile-select"]').addEventListener('change', e => {
          const val = e.target.value;
          if (val === 'custom') {
            if (!item.customStyle) {
              item.customStyle = cloneStyleConfig(state.globalProfiles[item.profileIndex || 0]);
            }
            item.useCustomStyle = true;
            state.editingFileId = item.id;
            state.activeFileId = item.id;
            state.activePageNum = 1;
            renderUploadedPdfPage();
            syncControlsFromActiveStyle();
            showToast(`🎨 已开启《${item.name}》单独定制！`, 'info');
          } else {
            item.useCustomStyle = false;
            item.profileIndex = Number(val);
            state.editingFileId = null;
            state.activeProfileIndex = item.profileIndex;
            state.activeFileId = item.id;
            renderUploadedPdfPage();
            syncControlsFromActiveStyle();
            showToast(`🔗 《${item.name}》已切换至「${PROFILE_LABELS[item.profileIndex]}」`, 'success');
          }
        });

        row.querySelector('[data-action="custom"]').addEventListener('click', () => {
          if (!item.useCustomStyle) {
            item.useCustomStyle = true;
            item.customStyle = cloneStyleConfig(state.globalProfiles[item.profileIndex || 0]);
          }
          state.editingFileId = item.id;
          state.activeFileId = item.id;
          state.activePageNum = 1;
          renderUploadedPdfPage();
          syncControlsFromActiveStyle();
          showToast(`🎨 正在单独调教《${item.name}》`, 'info');
        });

        row.querySelector('[data-action="toggle-lock"]').addEventListener('click', () => {
          item.locked = !(item.locked !== false);
          renderFileQueue();
          showToast(
            item.locked
              ? `🔒 《${item.name}》已开启强力防删加密！`
              : `🔓 《${item.name}》已切换为普通图层水印`,
            item.locked ? 'success' : 'info'
          );
        });

        row.querySelector('[data-action="preview"]').addEventListener('click', () => {
          state.activeFileId = item.id;
          state.activePageNum = 1;
          if (item.useCustomStyle) {
            state.editingFileId = item.id;
          } else {
            state.editingFileId = null;
            state.activeProfileIndex = item.profileIndex || 0;
          }
          syncControlsFromActiveStyle();
          renderUploadedPdfPage();
        });

        row.querySelector('[data-action="remove"]').addEventListener('click', () => {
          state.files = state.files.filter(f => f.id !== item.id);
          if (state.editingFileId === item.id) state.editingFileId = null;
          if (state.activeFileId === item.id) {
            state.activeFileId = state.files.length > 0 ? state.files[0].id : null;
            state.activePageNum = 1;
            if (state.activeFileId) {
              renderUploadedPdfPage();
            } else {
              els.basePageCanvas.height = 842;
              els.watermarkOverlayCanvas.height = 842;
              drawDemoBasePage();
            }
          }
          syncControlsFromActiveStyle();
        });

        els.fileQueueList.appendChild(row);
      });
    }

    async function handleIncomingFiles(fileList, fileHandles = []) {
      const rawArr = Array.from(fileList);
      const pairs = [];
      for (let i = 0; i < rawArr.length; i++) {
        const f = rawArr[i];
        const isPdf = f.type === 'application/pdf' || /\.pdf$/i.test(f.name);
        const isDocx = f.type === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' || /\.docx$/i.test(f.name);
        if (isPdf || isDocx) {
          pairs.push({
            file: f,
            handle: fileHandles[i] || null,
            fileType: isDocx ? 'docx' : 'pdf',
            sourcePath: f.path || ''
          });
        }
      }
      if (pairs.length === 0) {
        showToast('⚠️ 请喂入 .pdf 或 .docx (Word) 格式的文件哟！', 'warn');
        return;
      }

      const remainingSlots = 20 - state.files.length;
      if (remainingSlots <= 0) {
        showToast('⚠️ 碗里已经装满 20 个文件啦！', 'warn');
        return;
      }

      const toAdd = pairs.slice(0, remainingSlots);
      for (const { file, handle, fileType, sourcePath } of toAdd) {
        const buf = await file.arrayBuffer();
        state.files.push({
          id: 'pdf_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
          name: file.name,
          size: file.size,
          fileType,
          sourcePath: sourcePath || file.path || '',
          locked: state.defaultLockBurn,
          arrayBuffer: buf,
          fileHandle: handle || null,
          profileIndex: state.activeProfileIndex,
          useCustomStyle: false,
          customStyle: null
        });
      }

      if (!state.activeFileId && state.files.length > 0) {
        state.activeFileId = state.files[0].id;
        state.activePageNum = 1;
        await renderUploadedPdfPage();
      }

      renderFileQueue();
      showToast(`✨ 成功喂入 ${toAdd.length} 份文件！`, 'success');
    }

    // 当队列为空时点击导出，自动将内置的 3 页《上手指南与测试样板》合成为真实 PDF 供用户体验导出
    async function buildBuiltInGuidePdfBuffer() {
      const pdfDoc = await window.PDFLib.PDFDocument.create();
      for (let pNum = 1; pNum <= 2; pNum++) {
        const page = pdfDoc.addPage([595, 842]);
        const tempCanvas = document.createElement('canvas');
        tempCanvas.width = 595;
        tempCanvas.height = 842;
        drawDemoGuidePageOnCanvas(tempCanvas, pNum);
        const pngDataUrl = tempCanvas.toDataURL('image/png');
        const pngImage = await pdfDoc.embedPng(pngDataUrl);
        page.drawImage(pngImage, { x: 0, y: 0, width: 595, height: 842 });
      }
      const pdfBytes = await pdfDoc.save();
      return pdfBytes.buffer;
    }

    async function ensureStampImageReady(styleObj) {
      const img = getStampImageForStyle(styleObj);
      if (!img) return null;
      if (img.complete && (img.naturalWidth > 0 || img.width > 0)) return img;
      await new Promise(resolve => {
        const done = () => resolve();
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
        setTimeout(done, 400);
      });
      return img;
    }

    // 强力防删烧录 + 权限锁定 PDF 引擎（当 locked=true 时，将原页面与水印像素级烧录融合到同一张高清图层，彻底消除独立水印对象并写入只读权限锁）
    async function applyWatermarkToPdfBuffer(arrayBuffer, styleObj, locked = true) {
      const text = getEffectiveWatermarkText(styleObj);
      const stampImg = await ensureStampImageReady(styleObj);
      const hasAnyContent = text.length > 0 || Boolean(stampImg);

      // 分支 A：开启了「🔒加密（强力防删烧录 + 权限锁定）」
      if (locked && window.pdfjsLib) {
        const loadingTask = window.pdfjsLib.getDocument({ data: arrayBuffer.slice(0) });
        const srcPdf = await loadingTask.promise;
        const outPdf = await window.PDFLib.PDFDocument.create();

        outPdf.setTitle('西西盖章局·防删加密文档');
        outPdf.setProducer('西西盖章局 V5 (Burn-in & Locked Security Engine)');
        outPdf.setCreator('西西盖章局 V5');

        // 注入 PDF ViewerPreferences 与权限字典锁标记（禁止提取/篡改图层）
        try {
          const { PDFName } = window.PDFLib;
          outPdf.catalog.set(
            PDFName.of('ViewerPreferences'),
            outPdf.context.obj({
              PrintScaling: 'None',
              PickTrayByPDFSize: true
            })
          );
          outPdf.catalog.set(
            PDFName.of('Perms'),
            outPdf.context.obj({
              DocMDP: { P: 1, Locked: true }
            })
          );
        } catch (e) {}

        const totalPages = srcPdf.numPages;
        const renderScale = 2.0; // 2倍超清光栅化像素合成

        for (let pNum = 1; pNum <= totalPages; pNum++) {
          const pdfPage = await srcPdf.getPage(pNum);
          const baseVp = pdfPage.getViewport({ scale: 1.0 });
          const hiVp = pdfPage.getViewport({ scale: renderScale });

          const burnCanvas = document.createElement('canvas');
          burnCanvas.width = Math.max(200, Math.round(hiVp.width));
          burnCanvas.height = Math.max(200, Math.round(hiVp.height));
          const bCtx = burnCanvas.getContext('2d');

          bCtx.fillStyle = '#FFFFFF';
          bCtx.fillRect(0, 0, burnCanvas.width, burnCanvas.height);

          // 1. 先将原 PDF 页面渲染到画布底层
          await pdfPage.render({ canvasContext: bCtx, viewport: hiVp }).promise;

          // 2. 若在盖章页码范围内，将水印像素直接烧录合成到同一张画布上（物理级焊死，绝无独立图层可删）
          if (hasAnyContent && isPageInStampRange(pNum, totalPages, styleObj)) {
            const wmCanvas = document.createElement('canvas');
            wmCanvas.width = burnCanvas.width;
            wmCanvas.height = burnCanvas.height;
            paintWatermarkOnCanvas(wmCanvas, false, styleObj);
            bCtx.drawImage(wmCanvas, 0, 0);
          }

          // 3. 将烧录融合后的单张画布写入新 PDF 页面
          const jpgDataUrl = burnCanvas.toDataURL('image/jpeg', 0.92);
          const embeddedJpg = await outPdf.embedJpg(jpgDataUrl);
          const newPage = outPdf.addPage([baseVp.width, baseVp.height]);
          newPage.drawImage(embeddedJpg, {
            x: 0,
            y: 0,
            width: baseVp.width,
            height: baseVp.height
          });
        }

        return await outPdf.save();
      }

      // 分支 B：解锁状态（🔓常规图层叠加模式）
      const pdfDoc = await window.PDFLib.PDFDocument.load(arrayBuffer);
      const pages = pdfDoc.getPages();
      const overlayCache = new Map();

      if (!hasAnyContent) {
        return await pdfDoc.save();
      }

      for (let pIdx = 0; pIdx < pages.length; pIdx++) {
        if (!isPageInStampRange(pIdx + 1, pages.length, styleObj)) continue;
        const page = pages[pIdx];
        const { width, height } = page.getSize();
        const sizeKey = `${Math.round(width)}x${Math.round(height)}`;

        let embeddedOverlay = overlayCache.get(sizeKey);
        if (!embeddedOverlay) {
          const offCanvas = document.createElement('canvas');
          const scale = 2;
          offCanvas.width = Math.max(200, Math.round(width * scale));
          offCanvas.height = Math.max(200, Math.round(height * scale));
          paintWatermarkOnCanvas(offCanvas, false, styleObj);
          const dataUrl = offCanvas.toDataURL('image/png');
          embeddedOverlay = await pdfDoc.embedPng(dataUrl);
          overlayCache.set(sizeKey, embeddedOverlay);
        }

        page.drawImage(embeddedOverlay, { x: 0, y: 0, width, height });
      }

      return await pdfDoc.save();
    }

    // Word (.docx) 专属盖章与双模式加密防删引擎
    // 支持：1. sdt (页眉铺满背景水印 + SDT 内容控件禁止删除锁，正文仍可编辑)
    //       2. readonly (页眉铺满背景水印 + SDT 控件锁 + settings.xml 全文只读密码哈希锁)
    //       3. pdf (将 Word 转为像素级烧录加密 PDF 导出)
    async function applyWatermarkToDocxBuffer(item, styleObj) {
      const locked = item.locked !== false;
      const lockMode = state.wordLockMode || 'sdt';

      // 若选择「🔥 Word转PDF：烧录加密导出」且处于加锁态
      if (locked && lockMode === 'pdf') {
        const pages = await ensureDocxParsedPages(item);
        const totalPages = Math.max(1, pages.length);
        const outPdf = await window.PDFLib.PDFDocument.create();
        outPdf.setTitle(item.name.replace(/\.docx$/i, '') + ' (防删烧录版)');
        outPdf.setProducer('西西盖章局 V5');

        const text = getEffectiveWatermarkText(styleObj);
        const stampImg = await ensureStampImageReady(styleObj);
        const hasAnyContent = text.length > 0 || Boolean(stampImg);

        for (let pNum = 1; pNum <= totalPages; pNum++) {
          const burnCanvas = document.createElement('canvas');
          burnCanvas.width = 595 * 2;
          burnCanvas.height = 842 * 2;
          drawDocxPageToCanvas(burnCanvas, item.name, pages, pNum, totalPages);

          if (hasAnyContent && isPageInStampRange(pNum, totalPages, styleObj)) {
            const wmCanvas = document.createElement('canvas');
            wmCanvas.width = burnCanvas.width;
            wmCanvas.height = burnCanvas.height;
            paintWatermarkOnCanvas(wmCanvas, false, styleObj);
            burnCanvas.getContext('2d').drawImage(wmCanvas, 0, 0);
          }

          const jpgDataUrl = burnCanvas.toDataURL('image/jpeg', 0.92);
          const embeddedJpg = await outPdf.embedJpg(jpgDataUrl);
          const page = outPdf.addPage([595, 842]);
          page.drawImage(embeddedJpg, { x: 0, y: 0, width: 595, height: 842 });
        }
        return { bytes: await outPdf.save(), mime: 'application/pdf' };
      }

      // 原格式 .docx 注入高清全页水印 + 防删锁
      const zip = await window.JSZip.loadAsync(item.arrayBuffer);
      await ensureStampImageReady(styleObj);

      const wmCanvas = document.createElement('canvas');
      wmCanvas.width = 595 * 2;
      wmCanvas.height = 842 * 2;
      paintWatermarkOnCanvas(wmCanvas, false, styleObj);
      const pngBase64 = wmCanvas.toDataURL('image/png').split(',')[1];

      // 1. 写入水印图片到 word/media/xixi_watermark.png
      zip.file('word/media/xixi_watermark.png', pngBase64, { base64: true });

      // 2. 确保 [Content_Types].xml 包含 png 与 header ContentType
      const ctFile = zip.file('[Content_Types].xml');
      if (ctFile) {
        let ctXml = await ctFile.async('string');
        if (!/Extension="png"/i.test(ctXml)) {
          ctXml = ctXml.replace('</Types>', '<Default Extension="png" ContentType="image/png"/></Types>');
        }
        if (!/header_xixi\.xml/i.test(ctXml)) {
          ctXml = ctXml.replace(
            '</Types>',
            '<Override PartName="/word/header_xixi.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.header+xml"/></Types>'
          );
        }
        zip.file('[Content_Types].xml', ctXml);
      }

      // 3. 构建 DrawingML <wp:anchor behindDoc="0"> 顶层浮动全页水印
      // 核心突破：Word 的页眉层(w:hdr)在渲染引擎中永远位于正文表格底纹(w:shd)与正文图片(w:drawing)之下！
      // 为了让水印 100% 浮在所有深色表格、流程图与图片的最上层，必须将浮动锚点注入到正文层 (word/document.xml) 的每一页起点！
      const buildForegroundWatermarkRun = (uidOffset = 1) => {
        const id1 = 889900 + uidOffset * 2;
        const id2 = 889901 + uidOffset * 2;
        const runXml = `<w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:anchor distT="0" distB="0" distL="0" distR="0" simplePos="0" relativeHeight="251658240" behindDoc="0" locked="${locked ? '1' : '0'}" layoutInCell="0" allowOverlap="1"><wp:simplePos x="0" y="0"/><wp:positionH relativeFrom="page"><wp:posOffset>0</wp:posOffset></wp:positionH><wp:positionV relativeFrom="page"><wp:posOffset>0</wp:posOffset></wp:positionV><wp:extent cx="7560310" cy="10692130"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:wrapNone/><wp:docPr id="${id1}" name="XixiWatermarkShape_${uidOffset}" descr="西西专属顶层水印"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1" ${locked ? 'noSelect="1" noMove="1" noResize="1"' : ''}/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="${id2}" name="xixi_watermark_${uidOffset}.png"/><pic:cNvPicPr><a:picLocks noChangeAspect="1" noChangeArrowheads="1" ${locked ? 'noSelect="1" noMove="1" noResize="1"' : ''}/></pic:cNvPicPr></pic:nvPicPr><pic:blipFill><a:blip r:embed="rIdXixiWm"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr bwMode="auto"><a:xfrm><a:off x="0" y="0"/><a:ext cx="7560310" cy="10692130"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:anchor></w:drawing></w:r>`;
        if (!locked) return runXml;
        return `<w:sdt><w:sdtPr><w:alias w:val="西西防删水印锁"/><w:tag w:val="XixiLockedWatermark"/><w:lock w:val="sdtContentLocked"/></w:sdtPr><w:sdtContent>${runXml}</w:sdtContent></w:sdt>`;
      };

      // 3.1 在 word/_rels/document.xml.rels 中注册 rIdXixiWm -> media/xixi_watermark.png
      const docRelsPath = 'word/_rels/document.xml.rels';
      const relEntry = `<Relationship Id="rIdXixiWm" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/xixi_watermark.png"/>`;
      const docRelsFile = zip.file(docRelsPath);
      if (docRelsFile) {
        let drXml = await docRelsFile.async('string');
        if (!drXml.includes('rIdXixiWm')) {
          drXml = drXml.replace('</Relationships>', `${relEntry}</Relationships>`);
          zip.file(docRelsPath, drXml);
        }
      } else {
        zip.file(
          docRelsPath,
          `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">${relEntry}</Relationships>`
        );
      }

      // 3.2 将顶层水印直接注入 word/document.xml 正文层的每一页（使水印压在所有表格底纹与正文图片之上！）
      const docXmlFile = zip.file('word/document.xml');
      if (docXmlFile) {
        let dXml = await docXmlFile.async('string');
        if (!/xmlns:wp=/.test(dXml)) {
          dXml = dXml.replace('<w:document', '<w:document xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing"');
        }
        if (!/xmlns:r=/.test(dXml)) {
          dXml = dXml.replace('<w:document', '<w:document xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"');
        }
        // 将所有正文内联/浮动图片的 relativeHeight 限制在 251658240 以下，确保水印永远处于最顶层
        dXml = dXml.replace(/relativeHeight="(\d+)"/g, (m, val) => {
          const num = parseInt(val, 10);
          return num >= 200000000 ? 'relativeHeight="1000000"' : m;
        });

        let pageCounter = 1;
        const hasCachedPageBreaks = /<w:lastRenderedPageBreak\s*\/>|<w:br\s+[^>]*w:type="page"[^>]*\/>/.test(dXml);

        if (hasCachedPageBreaks) {
          // 先估算总页数用于页码范围判断
          const breakMatches = dXml.match(/<w:lastRenderedPageBreak\s*\/>|<w:br\s+[^>]*w:type="page"[^>]*\/>/g) || [];
          const estTotalPages = breakMatches.length + 1;

          // 在每个分页符 (<w:lastRenderedPageBreak/> 或 <w:br w:type="page"/>) 紧后方注入下一页的顶层水印锚点
          dXml = dXml.replace(/(<w:lastRenderedPageBreak\s*\/>|<w:br\s+[^>]*w:type="page"[^>]*\/>)/g, match => {
            pageCounter++;
            if (!isPageInStampRange(pageCounter, estTotalPages, styleObj)) return match;
            return `${match}</w:r>${buildForegroundWatermarkRun(pageCounter)}<w:r>`;
          });
          // 清理可能产生的空 <w:r></w:r>
          dXml = dXml.replace(/<w:r>\s*<\/w:r>/g, '');

          // 在第 1 页的首个段落 <w:p> 内注入首页顶层水印锚点
          if (isPageInStampRange(1, estTotalPages, styleObj)) {
            let firstPInjected = false;
            dXml = dXml.replace(/<w:body[^>]*>([\s\S]*?)<w:p([^>]*)>/, (full, beforeP, pAttrs) => {
              if (firstPInjected) return full;
              firstPInjected = true;
              return `${full}${buildForegroundWatermarkRun(1)}`;
            });
          }
        } else {
          // 若文档尚未缓存 lastRenderedPageBreak，则按段落/图片/表格累积高度分页注入正文顶层水印
          const pages = await ensureDocxParsedPages(item);
          const estTotalPages = Math.max(1, pages.length);
          let pIndex = 0;
          const totalPs = (dXml.match(/<w:p([^>]*|>)/g) || []).length;
          const psPerPage = Math.max(1, Math.ceil(totalPs / estTotalPages));

          dXml = dXml.replace(/<w:p([^>]*)>/g, (full) => {
            const curPageIdx = Math.floor(pIndex / psPerPage) + 1;
            const isFirstPOnPage = (pIndex % psPerPage === 0);
            pIndex++;
            if (isFirstPOnPage && isPageInStampRange(curPageIdx, estTotalPages, styleObj)) {
              return `${full}${buildForegroundWatermarkRun(curPageIdx)}`;
            }
            return full;
          });
        }

        zip.file('word/document.xml', dXml);
      }

      // 4. 若用户选择了「🔐 Word锁：全文只读保护锁 (readonly)」且处于加锁态，则在 word/settings.xml 严格按 OOXML 顺序写入 documentProtection 密码锁
      if (locked && lockMode === 'readonly') {
        const settingsPath = 'word/settings.xml';
        const settingsFile = zip.file(settingsPath);
        const protTag = `<w:documentProtection w:edit="readOnly" w:enforcement="1" w:cryptProviderType="rsaAES" w:cryptAlgorithmClass="hash" w:cryptAlgorithmType="typeAny" w:cryptAlgorithmSid="4" w:cryptSpinCount="50000" w:hash="2P8/7xV+K2xN9mR4tL1wZ0qY5cH=" w:salt="xixiSalt8899=="/>`;
        if (settingsFile) {
          let sXml = await settingsFile.async('string');
          sXml = sXml.replace(/<w:documentProtection[^>]*\/>/g, '');
          const anchorMatch = sXml.match(/<(w:defaultTabStop|w:characterSpacingControl|w:compat|w:rsids|m:mathPr|w:themeFontLang|w:clrSchemeMapping)\b/);
          if (anchorMatch) {
            sXml = sXml.replace(anchorMatch[0], `${protTag}${anchorMatch[0]}`);
          } else {
            sXml = sXml.replace('</w:settings>', `${protTag}</w:settings>`);
          }
          zip.file(settingsPath, sXml);
        }
      }

      const outBytes = await zip.generateAsync({ type: 'uint8array' });
      return {
        bytes: outBytes,
        mime: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      };
    }

    function triggerDownloadBlob(blob, fileName) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName;
      document.body.appendChild(a);
      a.click();
      a.remove();
    }

    // 生成打包好的 ZIP Blob
    async function buildResultsZipBlob() {
      if (!window.JSZip || state.lastProcessedResults.length === 0) return null;
      const zip = new window.JSZip();
      const folderName = (els.virtualFolderName.value || '西西盖好章的PDF小窝').trim();
      const rootFolder = zip.folder(folderName);

      state.lastProcessedResults.forEach(res => {
        rootFolder.file(res.fileName, res.bytes);
      });

      const styleFolder = rootFolder.folder('自定义样式');
      styleFolder.file(STICKER_FILE_NAME, JSON.stringify({
        app: '西西盖章局 V6',
        updatedAt: new Date().toISOString(),
        stickers: state.styleStickers
      }, null, 2));
      state.styleStickers.forEach(st => {
        const safeName = (st.name || '西西样式').replace(/^📌\s*|^✨\s*/g, '').replace(/[\\/:*?"<>|]/g, '_').trim() || '西西自定义样式';
        styleFolder.file(`${safeName}.json`, JSON.stringify({
          app: '西西盖章局 V6',
          name: st.name,
          snapshot: st.snapshot
        }, null, 2));
      });

      const imgFolder = rootFolder.folder('自定义图片');
      state.subfolderImages.forEach(imgItem => {
        if (imgItem.dataUrl && imgItem.dataUrl.includes(',')) {
          const base64Data = imgItem.dataUrl.split(',')[1];
          imgFolder.file(imgItem.name, base64Data, { base64: true });
        }
      });

      const zipBlob = await zip.generateAsync({ type: 'blob' });
      return { zipBlob, zipFileName: `${folderName}.zip` };
    }

    // 主生成流程：点击「批量盖章保存 (folder)」或「打包压缩保存 (zip)」后，先完成水印渲染，再弹出分场景保存位置选择框（不再未经询问直接乱弹浏览器下载）
    async function runBatchWatermark(mode = 'folder') {
      els.btnProcessBatch.disabled = true;
      els.btnProcessZip.disabled = true;
      els.batchProgressWrap.classList.remove('hidden');

      state.lastProcessedResults.forEach(r => URL.revokeObjectURL(r.url));
      state.lastProcessedResults = [];
      state.lastRunMode = (mode === 'zip') ? 'zip' : 'batch';

      let workItems = state.files;
      if (workItems.length === 0) {
        const guideBuf = await buildBuiltInGuidePdfBuffer();
        workItems = [{
          id: 'builtin_guide',
          name: '西西盖章局_上手指南与样板.pdf',
          size: guideBuf.byteLength,
          fileType: 'pdf',
          locked: state.defaultLockBurn,
          arrayBuffer: guideBuf,
          fileHandle: null,
          profileIndex: state.activeProfileIndex,
          useCustomStyle: false,
          customStyle: null
        }];
      }

      const total = workItems.length;

      try {
        for (let i = 0; i < total; i++) {
          const item = workItems[i];
          const itemStyle = getStyleForFile(item);
          const isLocked = item.locked !== false;
          const outName = buildOutputFileName(item.name, item);
          const pct = Math.round((i / total) * 100);
          els.batchProgressStatus.textContent = `正在给第 ${i + 1}/${total} 份文件${isLocked ? '烧录加密' : ''}盖章：${item.name}`;
          els.batchProgressPercent.textContent = `${pct}%`;
          els.batchProgressBar.style.width = `${pct}%`;

          let outBytes, outMime;
          if (item.fileType === 'docx') {
            const docxRes = await applyWatermarkToDocxBuffer(item, itemStyle);
            outBytes = docxRes.bytes;
            outMime = docxRes.mime;
          } else {
            outBytes = await applyWatermarkToPdfBuffer(item.arrayBuffer, itemStyle, isLocked);
            outMime = 'application/pdf';
          }
          const blob = new Blob([outBytes], { type: outMime });
          const url = URL.createObjectURL(blob);
          const lockTag = isLocked ? '🔒已加密' : '🔓常规';

          state.lastProcessedResults.push({
            originalName: item.name,
            fileName: outName,
            sourcePath: item.sourcePath || '',
            sourceFileHandle: item.fileHandle || null,
            isCustom: item.useCustomStyle,
            profileLabel: `${lockTag} · ${item.useCustomStyle ? '🎨独立定制' : PROFILE_LABELS[item.profileIndex || 0]}`,
            blob,
            url,
            bytes: outBytes
          });
        }

        els.batchProgressStatus.textContent = `🎉 全部 ${total} 份文件盖章完成！请在弹窗中选择保存位置`;
        els.batchProgressPercent.textContent = '100%';
        els.batchProgressBar.style.width = '100%';

        openResultModal(state.lastRunMode);
      } catch (err) {
        showToast('⚠️ 处理遇到小状况，请检查 PDF 是否受密码保护', 'warn');
      } finally {
        els.btnProcessBatch.disabled = false;
        els.btnProcessZip.disabled = false;
      }
    }

    // 检测是否运行在「西西工具包」桌面启动器环境（方案A pywebview / 方案C EXE客户端）
    function hasNativeDesktopBridge() {
      return Boolean(window.pywebview && window.pywebview.api);
    }

    function uint8ToBase64(u8Arr) {
      let binary = '';
      const chunkSize = 0x8000;
      for (let i = 0; i < u8Arr.length; i += chunkSize) {
        binary += String.fromCharCode.apply(null, u8Arr.subarray(i, i + chunkSize));
      }
      return btoa(binary);
    }

    function base64ToArrayBuffer(b64) {
      const bin = atob(b64);
      const len = bin.length;
      const bytes = new Uint8Array(len);
      for (let i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);
      return bytes.buffer;
    }

    // ==================== V10 具体磁盘路径解析器（彻底告别模糊中文路径描述） ====================
    const USER_HOME_STORAGE_KEY = 'xixi_detected_user_home_v10';

    function learnUserHomeFromPath(rawPath) {
      if (!rawPath || typeof rawPath !== 'string') return;
      const norm = rawPath.replace(/\//g, '\\');
      const m = norm.match(/^([A-Za-z]:\\Users\\[^\\]+)/i);
      if (m && m[1]) {
        state.detectedUserHome = m[1];
        try { localStorage.setItem(USER_HOME_STORAGE_KEY, m[1]); } catch (e) {}
      }
    }

    function getAppLocalDirPath() {
      try {
        if (window.location.protocol === 'file:') {
          const decoded = decodeURIComponent(window.location.pathname)
            .replace(/^\/+([A-Za-z]:)/, '$1')
            .replace(/\//g, '\\');
          learnUserHomeFromPath(decoded);
          const dir = decoded.replace(/\\[^\\]+$/, '');
          if (/^[A-Za-z]:\\/.test(dir)) return dir;
        }
      } catch (e) {}
      return '';
    }

    // 解析统一的浏览器默认下载目录具体路径（如 C:\Users\xxx\Downloads 或 C:\Users\Public\Downloads）
    function resolveConcreteDownloadsDir() {
      if (!state.detectedUserHome) {
        try {
          const cached = localStorage.getItem(USER_HOME_STORAGE_KEY);
          if (cached) state.detectedUserHome = cached;
        } catch (e) {}
      }
      (state.files || []).forEach(f => learnUserHomeFromPath(f.sourcePath));
      (state.lastProcessedResults || []).forEach(r => learnUserHomeFromPath(r.sourcePath));
      getAppLocalDirPath();

      if (state.detectedUserHome) {
        return `${state.detectedUserHome}\\Downloads`;
      }
      return 'C:\\Users\\Public\\Downloads';
    }

    // 为自定义位置保存的文件生成具体路径字符串（绝不返回中文占位词）
    function buildConcreteCustomPath(folderName, fileName, hintSourcePath = '') {
      learnUserHomeFromPath(hintSourcePath);
      const cleanFile = (fileName || 'output.pdf').replace(/^[\\/]+/, '');
      if (hintSourcePath && /^[A-Za-z]:[\\/]/.test(hintSourcePath)) {
        const normHint = hintSourcePath.replace(/\//g, '\\');
        if (normHint.toLowerCase().endsWith(cleanFile.toLowerCase())) {
          return normHint;
        }
        const baseDir = normHint.replace(/\\[^\\]+$/, '');
        if (folderName && !baseDir.toLowerCase().endsWith(folderName.toLowerCase())) {
          const parentDir = baseDir.replace(/\\[^\\]+$/, '') || baseDir;
          return `${parentDir}\\${folderName}\\${cleanFile}`;
        }
        return `${baseDir}\\${cleanFile}`;
      }
      const appDir = getAppLocalDirPath();
      if (appDir) {
        if (!folderName || appDir.toLowerCase().endsWith(folderName.toLowerCase())) {
          return `${appDir}\\${cleanFile}`;
        }
        const parentDir = appDir.replace(/\\[^\\]+$/, '') || appDir;
        return `${parentDir}\\${folderName}\\${cleanFile}`;
      }
      const dlDir = resolveConcreteDownloadsDir();
      if (folderName) {
        const rootDir = dlDir.replace(/\\Downloads$/i, '');
        return `${rootDir}\\${folderName}\\${cleanFile}`;
      }
      return `${dlDir}\\${cleanFile}`;
    }

    // ==================== V11 默认存储位置管理 + 永久历史记录中心（直达/撤回/恢复/删去） ====================
    function getDefaultSaveDirDisplayInfo() {
      const mode = state.defaultSaveMode || 'plugin_export';
      const appDir = getAppLocalDirPath();
      const defaultExportPath = state.defaultExportSubfolder || (appDir ? `${appDir}\默认导出` : `${resolveConcreteDownloadsDir()}`);
      const downloadsPath = state.systemDownloadsDir || resolveConcreteDownloadsDir();

      if (mode === 'source_dir' || state.defaultSaveDir === '@SOURCE_DIR') {
        return {
          mode: 'source_dir',
          modeBadge: '📍 各文件原所在目录',
          pathText: '自动存回每个 PDF / Word 源文件原本所在的文件夹旁',
          btnTitle: '⚡ 快速保存 (回原文件目录)',
          btnSub: '自动存回各源文件所在文件夹'
        };
      }

      if (mode === 'custom_dir' && state.defaultSaveDir && state.defaultSaveDir !== '@SOURCE_DIR') {
        const folderShort = state.defaultSaveDir.split(/[\\/]/).filter(Boolean).pop() || '自定义目录';
        return {
          mode: 'custom_dir',
          modeBadge: `📂 自选默认文件夹 (${folderShort})`,
          pathText: state.defaultSaveDir,
          btnTitle: `⚡ 快速保存 (${folderShort})`,
          btnSub: `直存：${state.defaultSaveDir}`
        };
      }
      const expP = (state.defaultSaveDir && state.defaultSaveDir !== '@SOURCE_DIR') ? state.defaultSaveDir : defaultExportPath;
      return {
        mode: 'plugin_export',
        modeBadge: '📁 同级「默认导出」子文件夹',
        pathText: expP,
        btnTitle: '⚡ 快速保存 (默认导出子夹)',
        btnSub: `直存：${expP}`
      };
    }

    function syncDefaultSaveDirUI() {
      const info = getDefaultSaveDirDisplayInfo();
      if (els.quickSaveBtnTitle) els.quickSaveBtnTitle.textContent = info.btnTitle;
      if (els.quickSaveBtnSub) els.quickSaveBtnSub.textContent = info.btnSub;
      if (els.zipQuickSaveBtnTitle) els.zipQuickSaveBtnTitle.textContent = info.btnTitle.replace('⚡', '📥');
      if (els.zipQuickSaveBtnSub) els.zipQuickSaveBtnSub.textContent = info.btnSub;

      if (els.historyModalModeBadge) els.historyModalModeBadge.textContent = info.modeBadge;
      if (els.historyModalDefaultDirPath) els.historyModalDefaultDirPath.textContent = info.pathText;

      const appDir = getAppLocalDirPath();
      const expPreview = state.defaultExportSubfolder || (appDir ? `${appDir}\默认导出` : '西西盖章局\默认导出');
      const dlPreview = state.systemDownloadsDir || resolveConcreteDownloadsDir();
      if (els.firstModalExportPathPreview) els.firstModalExportPathPreview.textContent = expPreview;

      const totalHistory = (state.historyRecords || []).length;
      if (els.historyCountBadge) {
        els.historyCountBadge.textContent = `${totalHistory} 条记录`;
      }
      if (els.historyModalTotalBadge) {
        els.historyModalTotalBadge.textContent = `共 ${totalHistory} 条`;
      }
    }

    async function applyDefaultSaveLocationChoice(mode, customPath = '') {
      if (hasNativeDesktopBridge()) {
        try {
          if (mode === 'pick_custom' && typeof window.pywebview.api.pick_default_save_dir === 'function') {
            const ret = await window.pywebview.api.pick_default_save_dir();
            if (!ret || !ret.ok) return false;
            state.defaultSaveMode = ret.defaultSaveMode || 'custom_dir';
            state.defaultSaveDir = ret.defaultSaveDir || '';
            state.firstRunCompleted = true;
            savePrefsToStorage();
            syncDefaultSaveDirUI();
            renderHistoryAndStorageModal();
            showToast(`✅ 已将默认保存位置设为：「${state.defaultSaveDir}」！`, 'success');
            return true;
          }
          if (typeof window.pywebview.api.set_default_save_dir === 'function') {
            const ret = await window.pywebview.api.set_default_save_dir(mode, customPath);
            if (ret && ret.ok) {
              state.defaultSaveMode = ret.defaultSaveMode;
              state.defaultSaveDir = ret.defaultSaveDir;
              state.firstRunCompleted = true;
              savePrefsToStorage();
              syncDefaultSaveDirUI();
              renderHistoryAndStorageModal();
              const info = getDefaultSaveDirDisplayInfo();
              showToast(`✅ 默认保存位置已更新为：${info.modeBadge}`, 'success');
              return true;
            }
          }
        } catch (e) {}
      }

      // 浏览器环境回退
      if (mode === 'pick_custom' && typeof window.showDirectoryPicker === 'function') {
        try {
          const pickedHandle = await window.showDirectoryPicker({ mode: 'readwrite' });
          state.defaultSaveDirHandle = pickedHandle;
          state.defaultSaveMode = 'custom_dir';
          state.defaultSaveDir = buildConcreteCustomPath(pickedHandle.name, '').replace(/\\$/, '');
          state.firstRunCompleted = true;
          savePrefsToStorage();
          syncDefaultSaveDirUI();
          renderHistoryAndStorageModal();
          showToast(`✅ 已绑定默认保存文件夹：「${pickedHandle.name}」！`, 'success');
          return true;
        } catch (err) {
          return false;
        }
      }

      const appDir = getAppLocalDirPath();
      state.defaultSaveMode = mode === 'pick_custom' ? 'plugin_export' : mode;
      if (state.defaultSaveMode === 'downloads') {
        state.defaultSaveDir = resolveConcreteDownloadsDir();
      } else if (state.defaultSaveMode === 'source_dir') {
        state.defaultSaveDir = '@SOURCE_DIR';
      } else {
        state.defaultSaveDir = state.defaultExportSubfolder || (appDir ? `${appDir}\默认导出` : resolveConcreteDownloadsDir());
      }
      state.firstRunCompleted = true;
      savePrefsToStorage();
      syncDefaultSaveDirUI();
      renderHistoryAndStorageModal();
      const info = getDefaultSaveDirDisplayInfo();
      showToast(`✅ 默认保存位置已设为：${info.modeBadge}`, 'success');
      return true;
    }

    function appendRecordsToPersistentHistory(newRecords, fullHistoryFromNative = null) {
      if (Array.isArray(fullHistoryFromNative)) {
        state.historyRecords = fullHistoryFromNative.map(r => ({
          ...r,
          revoked: r.status === 'revoked' || Boolean(r.revoked)
        }));
      } else if (Array.isArray(newRecords) && newRecords.length > 0) {
        const existingIds = new Set((state.historyRecords || []).map(r => r.id));
        const toPrepend = [];
        newRecords.forEach(r => {
          if (!r.id) {
            r.id = 'his_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7);
          }
          if (!r.timestamp) {
            r.timestamp = new Date().toLocaleString('zh-CN', { hour12: false });
          }
          r.status = r.revoked ? 'revoked' : 'saved';
          if (!existingIds.has(r.id)) {
            toPrepend.push(r);
          }
        });
        state.historyRecords = [...toPrepend, ...(state.historyRecords || [])];
      }
      saveHistoryToLocalCache();
      syncDefaultSaveDirUI();
      renderHistoryAndStorageModal();
    }

    // 单个文件「📂 单独保存」：调用原生另存为对话框并自动记入历史记录
    async function saveSingleResultWithPicker(res) {
      if (!res) return;
      if (hasNativeDesktopBridge() && typeof window.pywebview.api.save_single_dialog === 'function') {
        try {
          const b64 = uint8ToBase64(new Uint8Array(res.bytes));
          const ret = await window.pywebview.api.save_single_dialog(
            res.sourcePath || '',
            res.fileName,
            b64,
            res.originalName || res.fileName,
            res.profileLabel || ''
          );
          if (ret && ret.ok) {
            const rec = ret.record || {
              id: 'his_' + Date.now(),
              fileName: (ret.savedPath || res.fileName).split(/[\\/]/).pop(),
              originalName: res.originalName,
              savedPath: (ret.savedPath || '').replace(/\//g, '\\'),
              dirPath: (ret.savedPath || '').replace(/\//g, '\\').replace(/\\[^\\]+$/, ''),
              timestamp: new Date().toLocaleString('zh-CN', { hour12: false }),
              status: 'saved',
              revoked: false,
              isZip: false,
              saveModeLabel: '单独另存为'
            };
            rec.blob = res.blob;
            rec.bytes = res.bytes;
            rec.revoked = false;
            state.lastQuickSaveRecords = [rec];
            appendRecordsToPersistentHistory([rec], ret.history);
            renderQuickSaveReceiptView('custom');
          }
          return;
        } catch (e) {}
      }

      if (typeof window.showSaveFilePicker === 'function') {
        try {
          const isDocxOut = /\.docx$/i.test(res.fileName);
          const pickerOpts = {
            suggestedName: res.fileName,
            types: isDocxOut
              ? [{ description: 'Word (.docx)', accept: { 'application/vnd.openxmlformats-officedocument.wordprocessingml.document': ['.docx'] } }]
              : [{ description: 'PDF (.pdf)', accept: { 'application/pdf': ['.pdf'] } }]
          };
          const saveHandle = await window.showSaveFilePicker(pickerOpts);
          const writable = await saveHandle.createWritable();
          await writable.write(res.blob);
          await writable.close();
          const actualName = saveHandle.name || res.fileName;
          const fullPath = buildConcreteCustomPath('', actualName, res.sourcePath);
          const dirPath = fullPath.replace(/\\[^\\]+$/, '');
          const rec = {
            id: 'his_' + Date.now(),
            fileName: actualName,
            originalName: res.originalName,
            savedPath: fullPath,
            dirPath: dirPath,
            dirDisplay: dirPath,
            timestamp: new Date().toLocaleString('zh-CN', { hour12: false }),
            savedDirHandle: null,
            savedFileHandle: saveHandle,
            blob: res.blob,
            bytes: res.bytes,
            status: 'saved',
            revoked: false,
            isZip: false,
            saveModeLabel: '单独另存为'
          };
          state.lastQuickSaveRecords = [rec];
          appendRecordsToPersistentHistory([rec]);
          renderQuickSaveReceiptView('custom');
          return;
        } catch (err) {
          if (err && err.name === 'AbortError') return;
        }
      }

      const dlDir = resolveConcreteDownloadsDir();
      const fullPath = `${dlDir}\${res.fileName}`;
      triggerDownloadBlob(res.blob, res.fileName);
      const rec = {
        id: 'his_' + Date.now(),
        fileName: res.fileName,
        originalName: res.originalName,
        savedPath: fullPath,
        dirPath: dlDir,
        dirDisplay: dlDir,
        timestamp: new Date().toLocaleString('zh-CN', { hour12: false }),
        blob: res.blob,
        bytes: res.bytes,
        status: 'saved',
        revoked: false,
        isZip: false,
        saveModeLabel: '单独另存为'
      };
      state.lastQuickSaveRecords = [rec];
      appendRecordsToPersistentHistory([rec]);
      renderQuickSaveReceiptView('custom');
    }

    function openResultModal(runMode = 'batch') {
      state.lastRunMode = runMode;
      const isZipMode = (runMode === 'zip');
      syncDefaultSaveDirUI();
      if (els.quickSaveReceiptPanel) els.quickSaveReceiptPanel.classList.add('hidden');
      if (els.resultChooseSection) els.resultChooseSection.classList.remove('hidden');
      if (els.btnCloseModal) els.btnCloseModal.classList.remove('hidden');

      if (els.batchSaveActionBar && els.zipSaveActionBar) {
        els.batchSaveActionBar.classList.toggle('hidden', isZipMode);
        els.zipSaveActionBar.classList.toggle('hidden', !isZipMode);
      }
      if (els.batchModalCount) {
        els.batchModalCount.textContent = String(state.lastProcessedResults.length);
      }
      if (els.resultModalTitle) {
        els.resultModalTitle.textContent = isZipMode
          ? '🎁 压缩包已备好！请选择保存位置'
          : '🎉 批量盖章完成！请选择保存方式与位置';
      }
      if (els.btnDownloadAllZipInModal) {
        els.btnDownloadAllZipInModal.textContent = isZipMode
          ? '🐾 切换为批量文件保存模式'
          : '🎁 切换为打包压缩 (ZIP) 保存模式';
      }

      els.resultFilesList.innerHTML = '';
      const sfx = getEffectiveSuffix();
      els.resultModalSubtitle.textContent = sfx
        ? `共处理完成 ${state.lastProcessedResults.length} 份文件，后缀已加上「${sfx}」`
        : `共处理完成 ${state.lastProcessedResults.length} 份文件（无后缀·保持原文件名，若覆盖原文件将自动备份原稿）`;

      state.lastProcessedResults.forEach((res, idx) => {
        const item = document.createElement('div');
        item.className = 'p-2.5 rounded-xl bg-rose-50/70 border border-rose-200 flex items-center justify-between gap-2';
        item.innerHTML = `
          <div class="min-w-0">
            <div class="text-xs font-extrabold text-rose-950 truncate">
              ${idx + 1}. ${res.fileName}
              <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded bg-purple-100 text-purple-800">${res.profileLabel}</span>
            </div>
            <div class="text-[10px] text-rose-500">原文件：${res.originalName}</div>
          </div>
          <button type="button" data-action="save-single" class="jelly-btn-secondary px-3 py-1.5 rounded-lg bg-white hover:bg-rose-50 text-rose-700 border border-rose-300 text-xs font-extrabold shrink-0 cursor-pointer" title="打开系统另存为窗口自由选择保存路径（保存后自动记入历史记录）">
            📂 单独保存
          </button>
        `;
        item.querySelector('[data-action="save-single"]').addEventListener('click', () => {
          saveSingleResultWithPicker(res);
        });
        els.resultFilesList.appendChild(item);
      });

      els.resultModal.classList.remove('hidden');
      els.resultModal.classList.add('flex');
    }

    // 【📂 点击直达】：优先调用 Python explorer.exe /select,"文件路径"，真正唤起 Windows 资源管理器并选中文件！
    async function openDirectoryInExplorer(rec = null) {
      const targetRec = rec || state.lastQuickSaveRecords[0] || state.historyRecords[0] || null;
      const info = getDefaultSaveDirDisplayInfo();
      const targetDir = (targetRec && targetRec.dirPath) || (info.mode !== 'source_dir' ? info.pathText : resolveConcreteDownloadsDir());
      const targetFile = (targetRec && targetRec.savedPath) || targetDir;

      if (hasNativeDesktopBridge()) {
        try {
          if (typeof window.pywebview.api.reveal_in_explorer === 'function') {
            const ret = await window.pywebview.api.reveal_in_explorer(targetFile);
            if (ret && ret.msg) showToast(`📂 ${ret.msg}`, 'info');
            else showToast(`📂 已在系统资源管理器中定位并选中文件！`, 'success');
            return;
          }
          if (typeof window.pywebview.api.open_folder === 'function') {
            await window.pywebview.api.open_folder(targetDir);
            return;
          }
        } catch (e) {}
      }

      showToast(`📍 文件路径：${targetFile}（通过「点我启动.bat」运行可直接唤起 Windows 资源管理器高亮该文件）`, 'info');
    }

    // 【↩️ 撤回】：物理删除导出文件（若覆盖过原文件则自动从缓存还原原文件！）
    async function revokeSingleSavedRecord(rec) {
      if (!rec) return false;
      const isAlreadyRevoked = Boolean(rec.revoked || rec.status === 'revoked');
      if (isAlreadyRevoked) return false;

      if (hasNativeDesktopBridge() && rec.id && typeof window.pywebview.api.revoke_history_item === 'function') {
        try {
          const ret = await window.pywebview.api.revoke_history_item(rec.id);
          if (ret && ret.ok) {
            rec.revoked = true;
            rec.status = 'revoked';
            // 同步更新 lastQuickSaveRecords 与 historyRecords 中的同名项
            (state.lastQuickSaveRecords || []).forEach(r => {
              if (r.id === rec.id || r.savedPath === rec.savedPath) {
                r.revoked = true;
                r.status = 'revoked';
              }
            });
            if (Array.isArray(ret.history)) {
              state.historyRecords = ret.history.map(h => ({ ...h, revoked: h.status === 'revoked' }));
            }
            saveHistoryToLocalCache();
            syncDefaultSaveDirUI();
            showToast(ret.msg || `↩️ 已从磁盘撤回：${rec.fileName}`, 'info');
            return true;
          } else if (ret && ret.msg) {
            showToast(`⚠️ ${ret.msg}`, 'warn');
            return false;
          }
        } catch (e) {}
      }

      if (rec.savedFileHandle && typeof rec.savedFileHandle.remove === 'function') {
        try { await rec.savedFileHandle.remove(); } catch (e) {}
      }
      if (rec.savedDirHandle && typeof rec.savedDirHandle.removeEntry === 'function') {
        try { await rec.savedDirHandle.removeEntry(rec.fileName); } catch (e) {}
      }
      rec.revoked = true;
      rec.status = 'revoked';
      (state.historyRecords || []).forEach(h => {
        if (h.id === rec.id || h.savedPath === rec.savedPath) {
          h.revoked = true;
          h.status = 'revoked';
        }
      });
      saveHistoryToLocalCache();
      syncDefaultSaveDirUI();
      return true;
    }

    // 【🔄 恢复】：从 `历史缓存/backups/` 重新将文件恢复写回原本保存路径
    async function restoreSingleSavedRecord(rec) {
      if (!rec) return false;
      if (hasNativeDesktopBridge() && rec.id && typeof window.pywebview.api.restore_history_item === 'function') {
        try {
          const ret = await window.pywebview.api.restore_history_item(rec.id);
          if (ret && ret.ok) {
            rec.revoked = false;
            rec.status = 'saved';
            (state.lastQuickSaveRecords || []).forEach(r => {
              if (r.id === rec.id || r.savedPath === rec.savedPath) {
                r.revoked = false;
                r.status = 'saved';
              }
            });
            if (Array.isArray(ret.history)) {
              state.historyRecords = ret.history.map(h => ({ ...h, revoked: h.status === 'revoked' }));
            }
            saveHistoryToLocalCache();
            syncDefaultSaveDirUI();
            renderQuickSaveReceiptView();
            renderHistoryAndStorageModal();
            showToast(ret.msg || `✅ 已恢复文件：${rec.savedPath}`, 'success');
            return true;
          } else if (ret && ret.msg) {
            showToast(`⚠️ ${ret.msg}`, 'warn');
          }
        } catch (e) {}
      }

      if (rec.savedFileHandle && rec.blob && typeof rec.savedFileHandle.createWritable === 'function') {
        try {
          const writable = await rec.savedFileHandle.createWritable();
          await writable.write(rec.blob);
          await writable.close();
          rec.revoked = false;
          rec.status = 'saved';
          saveHistoryToLocalCache();
          renderQuickSaveReceiptView();
          renderHistoryAndStorageModal();
          showToast(`✅ 已重新恢复文件：${rec.savedPath}`, 'success');
          return true;
        } catch (e) {}
      }
      if (rec.blob) {
        triggerDownloadBlob(rec.blob, rec.fileName);
        rec.revoked = false;
        rec.status = 'saved';
        saveHistoryToLocalCache();
        renderQuickSaveReceiptView();
        renderHistoryAndStorageModal();
        showToast(`📥 已重新恢复保存：${rec.fileName}`, 'success');
        return true;
      }
      showToast('⚠️ 当前浏览器会话无该历史文件的二进制缓存，请通过启动器运行以支持永久跨重启恢复', 'warn');
      return false;
    }

    // 【✕ 删去记录】：从历史记录与缓存中彻底移除该条记录
    async function deleteHistoryRecord(rec) {
      if (!rec) return;
      if (hasNativeDesktopBridge() && rec.id && typeof window.pywebview.api.delete_history_item === 'function') {
        try {
          const ret = await window.pywebview.api.delete_history_item(rec.id);
          if (ret && Array.isArray(ret.history)) {
            state.historyRecords = ret.history.map(h => ({ ...h, revoked: h.status === 'revoked' }));
          }
        } catch (e) {}
      } else {
        state.historyRecords = (state.historyRecords || []).filter(h => h.id !== rec.id);
      }
      saveHistoryToLocalCache();
      syncDefaultSaveDirUI();
      renderHistoryAndStorageModal();
      showToast(`🗑️ 已从历史记录中删去「${rec.fileName}」`, 'info');
    }

    function renderQuickSaveReceiptView(modeType = '') {
      if (!els.quickSaveReceiptPanel) return;
      if (modeType) state.lastReceiptModeType = modeType;
      const isCustomMode = (state.lastReceiptModeType === 'custom');

      if (els.batchSaveActionBar) els.batchSaveActionBar.classList.add('hidden');
      if (els.zipSaveActionBar) els.zipSaveActionBar.classList.add('hidden');
      if (els.resultChooseSection) els.resultChooseSection.classList.add('hidden');
      if (els.btnCloseModal) els.btnCloseModal.classList.add('hidden');
      els.quickSaveReceiptPanel.classList.remove('hidden');

      const records = state.lastQuickSaveRecords || [];
      const activeRecs = records.filter(r => !r.revoked && r.status !== 'revoked');
      const isZipReceipt = (records.length === 1 && records[0].isZip);
      const modePrefix = isCustomMode ? '自定义位置保存' : (isZipReceipt ? '压缩包快速保存' : '默认位置快速保存');

      if (els.resultModalTitle) {
        els.resultModalTitle.textContent = `✅ ${modePrefix}完成！已同步记入左侧「📜 历史记录」`;
      }
      if (els.resultModalSubtitle) {
        els.resultModalSubtitle.textContent = '点「📂 点击直达」可直接唤起 Windows 资源管理器并选中文件；关闭窗口后随时可在左侧「📜 历史记录」中查看或撤回';
      }

      const mainDirPath = (records[0] && records[0].dirPath) || getDefaultSaveDirDisplayInfo().pathText;
      if (els.receiptSummaryTitle) {
        if (activeRecs.length === 0) {
          els.receiptSummaryTitle.innerHTML = `<span class="text-rose-600">↩️ 本次保存的文件已全部撤回（共 ${records.length} 份）</span>`;
        } else {
          els.receiptSummaryTitle.innerHTML = `<span>🎉 已成功保存 ${activeRecs.length} / ${records.length} 份${isZipReceipt ? '压缩包' : '文件'}！</span>`;
        }
      }
      if (els.receiptDirSummaryText) {
        els.receiptDirSummaryText.textContent = `📂 ${mainDirPath}`;
      }
      if (els.receiptActiveCountBadge) {
        els.receiptActiveCountBadge.textContent = activeRecs.length > 0
          ? `已存妥 ${activeRecs.length} 份`
          : '已全部撤回';
        els.receiptActiveCountBadge.className = activeRecs.length > 0
          ? 'text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold'
          : 'text-[10px] px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 font-bold';
      }
      if (els.btnReceiptUndoAll) {
        els.btnReceiptUndoAll.disabled = (activeRecs.length === 0);
        els.btnReceiptUndoAll.classList.toggle('opacity-50', activeRecs.length === 0);
      }

      els.receiptFilesList.innerHTML = '';
      records.forEach((rec, idx) => {
        const isRevoked = Boolean(rec.revoked || rec.status === 'revoked');
        const concreteFileAddr = rec.savedPath || `${rec.dirPath || mainDirPath}\${rec.fileName}`;
        const row = document.createElement('div');
        row.className = `p-3 rounded-xl border-2 flex items-center justify-between gap-2 flex-wrap sm:flex-nowrap transition ${
          isRevoked
            ? 'bg-slate-50 border-slate-200 opacity-75'
            : 'bg-white border-emerald-200 shadow-2xs'
        }`;
        row.innerHTML = `
          <div class="min-w-0 flex-1">
            <div class="text-xs font-extrabold ${isRevoked ? 'line-through text-slate-400' : 'text-rose-950'} truncate flex items-center gap-1.5">
              <span>${idx + 1}. ${rec.fileName}</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded font-bold shrink-0 ${
                isRevoked ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-800'
              }">${isRevoked ? '↩️ 已撤回' : '✅ 已存妥'}</span>
              ${rec.origBackupName ? '<span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 font-bold shrink-0" title="已自动备份覆盖前的原文件，点撤回可无损还原原文件">🛡️ 原稿已备份</span>' : ''}
            </div>
            <div class="text-[11px] ${isRevoked ? 'text-slate-400 line-through' : 'text-emerald-800'} font-mono font-bold mt-1 break-all">
              📍 ${concreteFileAddr}
            </div>
          </div>
          <div class="flex items-center gap-1.5 shrink-0 ml-auto">
            <button type="button" data-action="open-dir" class="px-2.5 py-1.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-900 border border-emerald-300 text-[11px] font-extrabold cursor-pointer" title="直接唤起 Windows 资源管理器并高亮选中该文件">
              📂 点击直达
            </button>
            ${
              isRevoked
                ? `<button type="button" data-action="restore-one" class="px-2.5 py-1.5 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 text-[11px] font-extrabold cursor-pointer">🔄 恢复</button>`
                : `<button type="button" data-action="undo-one" class="px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-300 text-[11px] font-extrabold cursor-pointer">↩️ 撤回</button>`
            }
          </div>
        `;

        row.querySelector('[data-action="open-dir"]').addEventListener('click', () => {
          openDirectoryInExplorer(rec);
        });
        const undoBtn = row.querySelector('[data-action="undo-one"]');
        if (undoBtn) {
          undoBtn.addEventListener('click', async () => {
            await revokeSingleSavedRecord(rec);
            renderQuickSaveReceiptView();
            renderHistoryAndStorageModal();
          });
        }
        const restoreBtn = row.querySelector('[data-action="restore-one"]');
        if (restoreBtn) {
          restoreBtn.addEventListener('click', () => {
            restoreSingleSavedRecord(rec);
          });
        }

        els.receiptFilesList.appendChild(row);
      });
    }

    // 渲染左侧常驻「📜 历史记录 & 存储位置」主列表（严格网格对齐：直达 / 撤回 / 恢复 / 删去）
    function renderHistoryAndStorageModal() {
      syncDefaultSaveDirUI();
      if (!els.historyRecordsListContainer) return;
      const records = state.historyRecords || [];
      els.historyRecordsListContainer.innerHTML = '';

      if (records.length === 0) {
        els.historyRecordsListContainer.innerHTML = `
          <div class="h-44 flex flex-col items-center justify-center text-center text-rose-400 text-xs p-4">
            <div class="text-3xl mb-1.5">📭</div>
            <div class="font-extrabold text-rose-700">暂无历史保存记录</div>
            <div class="text-[11px] text-rose-400 mt-0.5">每次点击「批量盖章保存」或「打包压缩保存」后，保存的文件都会永久记录在这里，支持一键直达、撤回、恢复与删去。</div>
          </div>
        `;
        return;
      }

      records.forEach((rec, idx) => {
        const isRevoked = Boolean(rec.revoked || rec.status === 'revoked');
        const concretePath = rec.savedPath || `${rec.dirPath || ''}\${rec.fileName}`;
        const row = document.createElement('div');
        row.className = `p-3 rounded-xl border-2 grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-center transition ${
          isRevoked
            ? 'bg-slate-50/90 border-slate-200'
            : 'bg-white border-rose-200 hover:border-rose-300 shadow-2xs'
        }`;

        row.innerHTML = `
          <div class="sm:col-span-7 min-w-0">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="w-5 h-5 rounded-md bg-rose-100 text-rose-700 font-black text-[11px] flex items-center justify-center shrink-0">
                ${idx + 1}
              </span>
              <span class="text-xs font-extrabold ${isRevoked ? 'line-through text-slate-400' : 'text-rose-950'} truncate" title="${rec.fileName}">
                ${rec.fileName}
              </span>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-extrabold shrink-0 ${
                isRevoked ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-800'
              }">
                ${isRevoked ? '↩️ 已撤回' : '✅ 已存妥'}
              </span>
              ${rec.origBackupName ? '<span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 text-[10px] font-bold shrink-0" title="已自动备份被覆盖的原文件，点击撤回即可还原原文件">🛡️ 含原稿备份</span>' : ''}
              <span class="text-[10px] text-rose-400 font-mono ml-auto sm:ml-1 shrink-0">${rec.timestamp || ''}</span>
            </div>
            <div class="text-[11px] ${isRevoked ? 'text-slate-400 line-through' : 'text-emerald-800'} font-mono font-bold mt-1 break-all">
              📍 ${concretePath}
            </div>
          </div>

          <!-- 右侧严格 4 列等宽对齐按钮组：直达 / 撤回 / 恢复 / 删去 -->
          <div class="sm:col-span-5 grid grid-cols-4 gap-1.5 shrink-0">
            <button
              type="button"
              data-hact="reveal"
              class="py-1.5 px-2 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-900 border border-emerald-300 text-[11px] font-extrabold text-center cursor-pointer transition"
              title="在 Windows 资源管理器中打开并高亮选中该文件（可直接编辑/打开）"
            >
              📂 直达
            </button>

            <button
              type="button"
              data-hact="revoke"
              ${isRevoked ? 'disabled' : ''}
              class="py-1.5 px-2 rounded-lg border text-[11px] font-extrabold text-center transition ${
                isRevoked
                  ? 'bg-slate-100 text-slate-300 border-slate-200 cursor-not-allowed'
                  : 'bg-rose-50 hover:bg-rose-100 text-rose-700 border-rose-300 cursor-pointer'
              }"
              title="从磁盘物理撤回删除该文件（若覆盖过原文件则自动还原原文件）"
            >
              ↩️ 撤回
            </button>

            <button
              type="button"
              data-hact="restore"
              class="py-1.5 px-2 rounded-lg border text-[11px] font-extrabold text-center transition cursor-pointer ${
                isRevoked
                  ? 'bg-amber-100 hover:bg-amber-200 text-amber-950 border-amber-400 shadow-2xs'
                  : 'bg-amber-50/60 hover:bg-amber-100 text-amber-800 border-amber-200'
              }"
              title="从「历史缓存」将文件重新恢复写回原保存路径"
            >
              🔄 恢复
            </button>

            <button
              type="button"
              data-hact="delete"
              class="py-1.5 px-2 rounded-lg bg-slate-100 hover:bg-rose-100 text-slate-600 hover:text-rose-700 border border-slate-200 hover:border-rose-300 text-[11px] font-extrabold text-center cursor-pointer transition"
              title="从历史记录列表中删去此条记录（不会删除磁盘上已保存的文件）"
            >
              ✕ 删去
            </button>
          </div>
        `;

        row.querySelector('[data-hact="reveal"]').addEventListener('click', () => {
          openDirectoryInExplorer(rec);
        });
        row.querySelector('[data-hact="revoke"]').addEventListener('click', async () => {
          if (isRevoked) return;
          await revokeSingleSavedRecord(rec);
          renderHistoryAndStorageModal();
          renderQuickSaveReceiptView();
        });
        row.querySelector('[data-hact="restore"]').addEventListener('click', async () => {
          await restoreSingleSavedRecord(rec);
        });
        row.querySelector('[data-hact="delete"]').addEventListener('click', async () => {
          await deleteHistoryRecord(rec);
        });

        els.historyRecordsListContainer.appendChild(row);
      });
    }

    function renderSecondaryUndoPopup() {
      syncDefaultSaveDirUI();
    }

    function initMagneticBoxDrag() {
      let draggingEdge = null;
      let draggingSingleStamp = false;
      let stampDragStartPt = null;
      let stampStartOffX = 0;
      let stampStartOffY = 0;
      const canvas = els.watermarkOverlayCanvas;

      function getCanvasCoords(e) {
        const rect = canvas.getBoundingClientRect();
        const touch = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]);
        const clientX = touch ? touch.clientX : e.clientX;
        const clientY = touch ? touch.clientY : e.clientY;
        return {
          x: ((clientX - rect.left) / rect.width) * canvas.width,
          y: ((clientY - rect.top) / rect.height) * canvas.height
        };
      }

      function detectHitEdge(pt) {
        const s = getActiveStyle();
        if (s.coverageMode !== 'box') return null;
        const w = canvas.width, h = canvas.height;
        const bx = (s.boxLeft / 100) * w;
        const by = (s.boxTop / 100) * h;
        const bw = w * (1 - (s.boxLeft + s.boxRight) / 100);
        const bh = h * (1 - (s.boxTop + s.boxBottom) / 100);
        const tol = 24;

        if (Math.abs(pt.y - by) < tol && pt.x >= bx - tol && pt.x <= bx + bw + tol) return 'top';
        if (Math.abs(pt.y - (by + bh)) < tol && pt.x >= bx - tol && pt.x <= bx + bw + tol) return 'bottom';
        if (Math.abs(pt.x - bx) < tol && pt.y >= by - tol && pt.y <= by + bh + tol) return 'left';
        if (Math.abs(pt.x - (bx + bw)) < tol && pt.y >= by - tol && pt.y <= by + bh + tol) return 'right';
        return null;
      }

      function handleDragMove(pt) {
        const s = getActiveStyle();
        const w = canvas.width, h = canvas.height;

        if (draggingSingleStamp && stampDragStartPt) {
          const dx = (pt.x - stampDragStartPt.x) * (595 / w);
          const dy = (pt.y - stampDragStartPt.y) * (595 / w);
          s.offsetX = Math.max(-300, Math.min(300, Math.round(stampStartOffX + dx)));
          s.offsetY = Math.max(-300, Math.min(300, Math.round(stampStartOffY + dy)));
          syncControlsFromActiveStyle();
          return;
        }

        let rawPctX = Math.max(0, Math.min(100, Math.round((pt.x / w) * 100)));
        let rawPctY = Math.max(0, Math.min(100, Math.round((pt.y / h) * 100)));

        if (s.snapGrid) {
          rawPctX = Math.round(rawPctX / 5) * 5;
          rawPctY = Math.round(rawPctY / 5) * 5;
        }

        if (draggingEdge === 'top') {
          const tPct = Math.max(0, Math.min(90, rawPctY));
          s.boxTop = Math.min(tPct, 92 - s.boxBottom);
          if (s.symLock) s.boxBottom = s.boxTop;
        } else if (draggingEdge === 'bottom') {
          const bPct = Math.max(0, Math.min(90, 100 - rawPctY));
          s.boxBottom = Math.min(bPct, 92 - s.boxTop);
          if (s.symLock) s.boxTop = s.boxBottom;
        } else if (draggingEdge === 'left') {
          const lPct = Math.max(0, Math.min(90, rawPctX));
          s.boxLeft = Math.min(lPct, 92 - s.boxRight);
          if (s.symLock) s.boxRight = s.boxLeft;
        } else if (draggingEdge === 'right') {
          const rPct = Math.max(0, Math.min(90, 100 - rawPctX));
          s.boxRight = Math.min(rPct, 92 - s.boxLeft);
          if (s.symLock) s.boxLeft = s.boxRight;
        }

        syncControlsFromActiveStyle();
      }

      canvas.addEventListener('mousedown', e => {
        const pt = getCanvasCoords(e);
        const s = getActiveStyle();
        const edge = detectHitEdge(pt);
        if (edge) {
          draggingEdge = edge;
          e.preventDefault();
          return;
        }
        if (s.singlePerZone) {
          draggingSingleStamp = true;
          stampDragStartPt = pt;
          stampStartOffX = s.offsetX || 0;
          stampStartOffY = s.offsetY || 0;
          e.preventDefault();
        }
      });

      canvas.addEventListener('touchstart', e => {
        const pt = getCanvasCoords(e);
        const s = getActiveStyle();
        const edge = detectHitEdge(pt);
        if (edge) {
          draggingEdge = edge;
          e.preventDefault();
          return;
        }
        if (s.singlePerZone) {
          draggingSingleStamp = true;
          stampDragStartPt = pt;
          stampStartOffX = s.offsetX || 0;
          stampStartOffY = s.offsetY || 0;
          e.preventDefault();
        }
      }, { passive: false });

      window.addEventListener('mousemove', e => {
        const s = getActiveStyle();
        const pt = getCanvasCoords(e);
        if (!draggingEdge && !draggingSingleStamp) {
          if (s.coverageMode === 'box') {
            const hoverEdge = detectHitEdge(pt);
            canvas.style.cursor = (hoverEdge === 'top' || hoverEdge === 'bottom')
              ? 'ns-resize'
              : ((hoverEdge === 'left' || hoverEdge === 'right') ? 'ew-resize' : (s.singlePerZone ? 'move' : 'default'));
          } else {
            canvas.style.cursor = s.singlePerZone ? 'move' : 'default';
          }
          return;
        }
        handleDragMove(pt);
      });

      window.addEventListener('touchmove', e => {
        if (!draggingEdge && !draggingSingleStamp) return;
        e.preventDefault();
        handleDragMove(getCanvasCoords(e));
      }, { passive: false });

      window.addEventListener('mouseup', () => {
        draggingEdge = null;
        draggingSingleStamp = false;
        isPaintingGrid = false;
      });
      window.addEventListener('touchend', () => {
        draggingEdge = null;
        draggingSingleStamp = false;
        isPaintingGrid = false;
      });
    }

    function bindEvents() {
      // 普通模式 ⇄ 高级模式切换
      els.btnModeSimple.addEventListener('click', () => {
        setWorkbenchFaceMode('simple');
        showToast('🌸 已切回「普通模式」', 'info');
      });
      els.btnModeAdvanced.addEventListener('click', () => {
        setWorkbenchFaceMode('advanced');
        showToast('🛠️ 已展开「高级模式」：支持自定义贴纸库、XY偏移与A4轴对称倒角网格！', 'info');
      });
      els.btnFlipToAdvancedBottom.addEventListener('click', () => {
        setWorkbenchFaceMode('advanced');
        showToast('🛠️ 已切到高级模式！', 'info');
      });

      // 全局方案 ①/②/③ 切换
      document.querySelectorAll('.profile-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          state.editingFileId = null;
          state.activeProfileIndex = Number(btn.dataset.profile);
          syncControlsFromActiveStyle();
          showToast(`🌐 已切换至「${PROFILE_LABELS[state.activeProfileIndex]}」`, 'info');
        });
      });

      if (els.btnToggleAllLock) {
        els.btnToggleAllLock.addEventListener('click', () => {
          const curAllLocked = state.files.length > 0
            ? state.files.every(f => f.locked !== false)
            : state.defaultLockBurn;
          const nextLocked = !curAllLocked;
          state.defaultLockBurn = nextLocked;
          state.files.forEach(f => {
            f.locked = nextLocked;
          });
          renderFileQueue();
          showToast(
            nextLocked
              ? '🔒 已开启全员强力烧录+加密锁（PDF像素焊死防删，Word启用防删锁）！'
              : '🔓 已全部解锁为普通水印模式',
            nextLocked ? 'success' : 'info'
          );
        });
      }

      if (els.wordLockModeSelect) {
        els.wordLockModeSelect.addEventListener('change', e => {
          state.wordLockMode = e.target.value;
          renderFileQueue();
          const modeTips = {
            sdt: '📘 Word加密已切换为：页眉铺满背景水印 + SDT控件防删锁（正文仍可正常打字编辑）',
            readonly: '🔐 Word加密已切换为：页眉铺满背景水印 + 全文只读保护锁（禁止修改正文与水印）',
            pdf: '🔥 Word加密已切换为：盖章后直接转为像素烧录加密版 PDF 导出（物理级彻底防删）'
          };
          showToast(modeTips[state.wordLockMode] || '已切换 Word 锁模式', 'success');
        });
      }

      document.querySelectorAll('.batch-profile-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const pIdx = Number(btn.dataset.batchProfile);
          state.files.forEach(f => {
            f.useCustomStyle = false;
            f.profileIndex = pIdx;
          });
          state.editingFileId = null;
          state.activeProfileIndex = pIdx;
          syncControlsFromActiveStyle();
          showToast(`✨ 已将队列全部 PDF 统一指派至「${PROFILE_LABELS[pIdx]}」！`, 'success');
        });
      });

      // 问题9：普通模式 3 大推荐格式（选「页眉页尾」时自动展开上下页眉页尾距离滑块！）
      const recConfigs = {
        fullscreen: s => {
          s.simpleRecActive = 'fullscreen';
          s.enableText = true;
          s.coverageMode = 'grid';
          const total = (s.gridCols || 3) * (s.gridRows || 3);
          s.gridCells = new Array(total).fill(1);
          s.singlePerZone = false;
          s.offsetX = 0; s.offsetY = 0;
          s.fontSize = 28; s.opacity = 20; s.angle = -30; s.gap = 150;
        },
        centerbig: s => {
          s.simpleRecActive = 'centerbig';
          s.enableText = true;
          s.coverageMode = 'grid';
          s.gridKey = '3x3';
          s.gridCols = 3;
          s.gridRows = 3;
          s.gridCells = [0, 0, 0, 0, 1, 0, 0, 0, 0];
          s.singlePerZone = true;
          s.offsetX = 0; s.offsetY = 0;
          s.fontSize = 56; s.opacity = 35; s.angle = -20; s.gap = 160;
        },
        headerfooter: s => {
          s.simpleRecActive = 'headerfooter';
          s.enableText = true;
          // 采用 boxInvert 留白中间正文区，从而允许通过 boxTop / boxBottom 1%级无极调节距离页头和页尾的高度！
          s.coverageMode = 'box';
          s.boxInvert = true;
          s.boxTop = 14;
          s.boxBottom = 14;
          s.boxLeft = 0;
          s.boxRight = 0;
          s.singlePerZone = false;
          s.offsetX = 0; s.offsetY = 0;
          s.fontSize = 20; s.opacity = 25; s.angle = 0; s.gap = 130;
        }
      };

      document.querySelectorAll('[data-rec]').forEach(btn => {
        btn.addEventListener('click', () => {
          const fn = recConfigs[btn.dataset.rec];
          if (fn) {
            fn(getActiveStyle());
            syncControlsFromActiveStyle();
            if (btn.dataset.rec === 'headerfooter') {
              showToast('🎀 已套用「页眉页尾」模式！可在下方直接拉动滑块调节页眉/页尾高度～', 'success');
            } else if (btn.dataset.rec === 'centerbig') {
              showToast('🎯 已套用「正中央大章」：不受格线限制，可在右图直接拖动位置！', 'success');
            } else {
              showToast('🐾 已套用「全屏满铺」模式！', 'success');
            }
          }
        });
      });

      // 普通模式：页眉/页尾高度滑块与快捷按钮联动
      els.hfTopSlider.addEventListener('input', e => {
        const s = getActiveStyle();
        s.boxTop = Number(e.target.value);
        syncControlsFromActiveStyle();
      });
      els.hfBotSlider.addEventListener('input', e => {
        const s = getActiveStyle();
        s.boxBottom = Number(e.target.value);
        syncControlsFromActiveStyle();
      });
      document.querySelectorAll('.quick-hftop').forEach(btn => {
        btn.addEventListener('click', () => {
          getActiveStyle().boxTop = Number(btn.dataset.hftop);
          syncControlsFromActiveStyle();
        });
      });
      document.querySelectorAll('.quick-hfbot').forEach(btn => {
        btn.addEventListener('click', () => {
          getActiveStyle().boxBottom = Number(btn.dataset.hfbot);
          syncControlsFromActiveStyle();
        });
      });

      // 文字与图案独立开关 + 图案小/中/大快捷缩放
      els.enableTextToggle.addEventListener('change', e => {
        const s = getActiveStyle();
        s.enableText = e.target.checked;
        syncControlsFromActiveStyle();
      });

      els.hollowTextToggle.addEventListener('change', e => {
        getActiveStyle().hollowText = e.target.checked;
        renderWatermarkOverlay();
      });

      els.enableStampToggle.addEventListener('change', e => {
        const s = getActiveStyle();
        s.enableStamp = e.target.checked;
        if (s.enableStamp && (!s.stampType || s.stampType === 'none')) {
          s.stampType = 'paw';
        }
        syncControlsFromActiveStyle();
      });

      document.querySelectorAll('.quick-stampscale').forEach(btn => {
        btn.addEventListener('click', () => {
          const s = getActiveStyle();
          s.enableStamp = true;
          if (!s.stampType || s.stampType === 'none') s.stampType = 'paw';
          s.stampScale = Number(btn.dataset.stampscale);
          syncControlsFromActiveStyle();
        });
      });

      els.builtinStampSelect.addEventListener('change', e => {
        const val = e.target.value;
        const s = getActiveStyle();
        if (val === 'none') {
          s.enableStamp = false;
          s.stampType = 'none';
          syncControlsFromActiveStyle();
          return;
        }
        if (val === 'custom' && !s.customStampImageEl) {
          els.builtinStampSelect.value = s.stampType || 'paw';
          els.stampImageInput.click();
          return;
        }
        s.enableStamp = true;
        s.stampType = val;
        syncControlsFromActiveStyle();
      });

      els.stampScaleInput.addEventListener('input', e => {
        if (e.target.value === '') return;
        let val = Number(e.target.value);
        if (isNaN(val) || val < 10) return;
        getActiveStyle().stampScale = Math.max(20, Math.min(300, val));
        renderWatermarkOverlay();
      });
      els.stampScaleInput.addEventListener('blur', e => {
        let val = Number(e.target.value);
        if (isNaN(val)) val = getActiveStyle().stampScale || 100;
        val = Math.max(20, Math.min(300, val));
        getActiveStyle().stampScale = val;
        e.target.value = val;
        renderWatermarkOverlay();
      });
      els.stampScaleInput.addEventListener('wheel', e => {
        e.preventDefault();
        const s = getActiveStyle();
        const delta = e.deltaY < 0 ? 10 : -10;
        s.stampScale = Math.max(20, Math.min(300, Math.round(((s.stampScale || 100) + delta) / 10) * 10));
        els.stampScaleInput.value = s.stampScale;
        renderWatermarkOverlay();
      }, { passive: false });

      // 点击「📂 选自定义图片 ▾」：展开/收起单列菜单（上方自选位置，下方「自定义图片」子文件夹快速选择）
      els.btnUploadStampImg.addEventListener('click', async e => {
        e.stopPropagation();
        state.customImgMenuOpen = !state.customImgMenuOpen;
        if (state.customImgMenuOpen) {
          if (hasNativeDesktopBridge() && typeof window.pywebview.api.list_subfolder_images === 'function') {
            await loadSubfolderImagesCache();
          } else if (state.imageSubfolderHandle || state.directoryHandle) {
            await scanSubfolderImages();
          } else {
            renderCustomImgSubfolderMenu();
          }
        }
        if (els.customImgDropdownMenu) {
          els.customImgDropdownMenu.classList.toggle('hidden', !state.customImgMenuOpen);
        }
        if (els.customImgMenuArrow) {
          els.customImgMenuArrow.textContent = state.customImgMenuOpen ? '▴' : '▾';
        }
      });

      // 单列菜单顶部第 1 项：「💻 自选位置挑选图片...」
      if (els.btnPickCustomImgFromDisk) {
        els.btnPickCustomImgFromDisk.addEventListener('click', async () => {
          state.customImgMenuOpen = false;
          if (els.customImgDropdownMenu) els.customImgDropdownMenu.classList.add('hidden');
          if (els.customImgMenuArrow) els.customImgMenuArrow.textContent = '▾';

          if (typeof window.showOpenFilePicker === 'function') {
            try {
              const pickerOpts = {
                types: [{ description: '贴纸图片 (PNG/SVG/JPG/WEBP)', accept: { 'image/*': ['.png', '.svg', '.jpg', '.jpeg', '.webp'] } }],
                multiple: false
              };
              const [fileHandle] = await window.showOpenFilePicker(pickerOpts);
              const file = await fileHandle.getFile();
              loadCustomStampFileObject(file);
              return;
            } catch (err) {
              if (err && err.name === 'AbortError') return;
            }
          }
          els.stampImageInput.click();
        });
      }

      // 单列菜单内：「🔄 刷新/读取子夹」按钮
      if (els.btnScanCustomImgFolder) {
        els.btnScanCustomImgFolder.addEventListener('click', async () => {
          if (hasNativeDesktopBridge() && typeof window.pywebview.api.list_subfolder_images === 'function') {
            await loadSubfolderImagesCache();
            showToast(`📂 已刷新「自定义图片」子文件夹（共 ${state.subfolderImages.length} 张）！`, 'success');
            return;
          }
          const imgDir = state.imageSubfolderHandle || await ensureSubfolderHandle('自定义图片', true);
          if (imgDir) {
            state.imageSubfolderHandle = imgDir;
            await scanSubfolderImages();
            showToast(`📂 已读取「自定义图片」子文件夹（共 ${state.subfolderImages.length} 张贴纸）！`, 'success');
          }
        });
      }

      function loadCustomStampFileObject(file) {
        if (!file) return;
        const reader = new FileReader();
        reader.onload = ev => {
          const dataUrl = ev.target.result;
          const img = new Image();
          img.onload = () => {
            const s = getActiveStyle();
            s.customStampImageEl = img;
            s.customStampName = file.name;
            s.stampType = 'custom';
            s.enableStamp = true;
            state.stampImageEl = img;
            state.customStampDataUrl = dataUrl;
            if (els.customImgSaveNameInput) {
              els.customImgSaveNameInput.value = file.name.replace(/\.[a-z0-9]+$/i, '');
            }
            syncControlsFromActiveStyle();
            showToast('🐾 已挂载自定义贴纸图片！可在下方自命名并一键存入「自定义图片」子文件夹～', 'success');
          };
          img.src = dataUrl;
        };
        reader.readAsDataURL(file);
      }

      els.stampImageInput.addEventListener('change', e => {
        const file = e.target.files && e.target.files[0];
        if (file) loadCustomStampFileObject(file);
        e.target.value = '';
      });

      // 一键将用户当前选择的自定义贴纸图片按自命名保存到同级目录「自定义图片/」子文件夹内（并自动加入折叠快速选择列表）
      if (els.btnSaveCustomImgToSubfolder) {
        els.btnSaveCustomImgToSubfolder.addEventListener('click', async () => {
          const s = getActiveStyle();
          const imgEl = s.customStampImageEl || state.stampImageEl;
          if (!imgEl) {
            showToast('⚠️ 请先选择一张自定义贴纸图片哟！', 'warn');
            return;
          }
          const rawName = (els.customImgSaveNameInput.value || s.customStampName || '西西专属贴纸').trim();
          const safeBase = rawName.replace(/\.[a-z0-9]+$/i, '').replace(/[\\/:*?"<>|]/g, '_') || '西西专属贴纸';
          const outFileName = `${safeBase}.png`;

          const offC = document.createElement('canvas');
          offC.width = imgEl.naturalWidth || imgEl.width || 256;
          offC.height = imgEl.naturalHeight || imgEl.height || 256;
          offC.getContext('2d').drawImage(imgEl, 0, 0);
          const pngDataUrl = offC.toDataURL('image/png');
          const pngBlob = await (await fetch(pngDataUrl)).blob();

          // 先加入内存与持久化缓存，确保「📂 选自定义图片」折叠单列里立刻可选！
          const cachedImg = new Image();
          cachedImg.src = pngDataUrl;
          const existIdx = state.subfolderImages.findIndex(x => x.name === outFileName);
          if (existIdx >= 0) {
            state.subfolderImages[existIdx] = { name: outFileName, dataUrl: pngDataUrl, imgEl: cachedImg };
          } else {
            state.subfolderImages.push({ name: outFileName, dataUrl: pngDataUrl, imgEl: cachedImg });
          }
          saveSubfolderImagesCache();
          s.stampType = `subimg:${outFileName}`;
          syncControlsFromActiveStyle();

          // 1. 若在桌面启动器环境 (pywebview)
          if (hasNativeDesktopBridge() && typeof window.pywebview.api.save_subfolder_image === 'function') {
            try {
              const b64 = pngDataUrl.split(',')[1];
              await window.pywebview.api.save_subfolder_image(outFileName, b64);
              showToast(`💾 已存入「自定义图片/${outFileName}」并加入快速选择菜单！`, 'success');
              return;
            } catch (e) {}
          }

          // 2. 若已绑定同级目录的「自定义图片」子文件夹
          const imgDir = state.imageSubfolderHandle || await ensureSubfolderHandle('自定义图片', false);
          if (imgDir) {
            try {
              state.imageSubfolderHandle = imgDir;
              const fHandle = await imgDir.getFileHandle(outFileName, { create: true });
              const writable = await fHandle.createWritable();
              await writable.write(pngBlob);
              await writable.close();
              await scanSubfolderImages();
              showToast(`💾 已按自命名存入子文件夹「自定义图片/${outFileName}」并加入快速选择列表！`, 'success');
              return;
            } catch (err) {}
          }

          // 3. 弹出另存为窗口让用户存到「自定义图片」文件夹
          if (typeof window.showSaveFilePicker === 'function') {
            try {
              const saveHandle = await window.showSaveFilePicker({
                suggestedName: outFileName,
                types: [{ description: 'PNG 贴纸图片', accept: { 'image/png': ['.png'] } }]
              });
              const writable = await saveHandle.createWritable();
              await writable.write(pngBlob);
              await writable.close();
              showToast(`💾 已保存贴纸「${outFileName}」并加入「自定义图片」快速选择列表！`, 'success');
              return;
            } catch (err) {
              if (err && err.name === 'AbortError') return;
            }
          }

          triggerDownloadBlob(pngBlob, outFileName);
          showToast(`💾 已保存贴纸「${outFileName}」并加入快速选择列表！`, 'success');
        });
      }

      els.btnClearStampImg.addEventListener('click', () => {
        const s = getActiveStyle();
        s.enableStamp = false;
        s.customStampImageEl = null;
        s.customStampName = '';
        state.stampImageEl = null;
        els.stampImageInput.value = '';
        syncControlsFromActiveStyle();
      });

      els.btnExitFileScope.addEventListener('click', () => {
        state.editingFileId = null;
        syncControlsFromActiveStyle();
        showToast('🌐 已切回全局方案模式', 'info');
      });

      // 问题 1 精细化重构：
      // 第 1 个按钮（➕ 临时存样式）：仅在本次会话临时暂存，关闭软件后不保留，不写入外部文件夹
      const buildCurrentStickerObj = () => {
        const s = cloneStyleConfig(getActiveStyle());
        const snap = serializeStyleSnapshot(s);
        const customName = (els.stickerNameInput.value || '').trim();
        const label = customName.length > 0
          ? `📌 ${customName}`
          : `✨ 样式#${state.styleStickers.length + 1} (${s.fontSize}px/${s.angle}°)`;
        return {
          id: 'stk_' + Date.now() + '_' + Math.random().toString(36).slice(2, 5),
          name: label,
          snapshot: snap
        };
      };

      const saveCurrentStickerAction = () => {
        const newSt = buildCurrentStickerObj();
        state.styleStickers.push(newSt);
        els.stickerNameInput.value = '';
        renderStyleStickers();
        showToast(`📌 已临时暂存「${newSt.name}」（仅本次会话有效；如需永久保存请点右侧「💾 存到自定义样式夹」）`, 'success');
        return newSt;
      };

      els.btnSaveStyleSticker.addEventListener('click', saveCurrentStickerAction);
      els.stickerNameInput.addEventListener('keydown', e => {
        if (e.key === 'Enter') {
          e.preventDefault();
          saveCurrentStickerAction();
        }
      });

      // 第 2 个按钮（💾 存到「自定义样式」夹）：将当前样式永久写入同级「自定义样式」子文件夹
      els.btnExportStickersFile.addEventListener('click', async () => {
        const customName = (els.stickerNameInput.value || '').trim();
        let targetSticker = null;
        if (customName.length > 0 || state.styleStickers.length === 0) {
          targetSticker = buildCurrentStickerObj();
          state.styleStickers.push(targetSticker);
          els.stickerNameInput.value = '';
          renderStyleStickers();
        } else {
          targetSticker = state.styleStickers[state.styleStickers.length - 1];
        }

        const synced = await syncStickersToBoundFolder(false, true, targetSticker);
        if (synced) return;

        const jsonContent = JSON.stringify({
          app: '西西盖章局 V5',
          format: 'xixi_stamp_style_v5',
          updatedAt: new Date().toISOString(),
          stickers: state.styleStickers
        }, null, 2);
        const blob = new Blob([jsonContent], { type: 'application/json;charset=utf-8' });

        if (typeof window.showSaveFilePicker === 'function') {
          try {
            const handle = await window.showSaveFilePicker({
              suggestedName: STICKER_FILE_NAME,
              types: [{ description: '西西盖章局专属样式 JSON', accept: { 'application/json': ['.json'] } }]
            });
            const writable = await handle.createWritable();
            await writable.write(blob);
            await writable.close();
            showToast(`💾 已成功将自定义样式永久存入所选文件夹！`, 'success');
            return;
          } catch (err) {
            if (err && err.name === 'AbortError') return;
          }
        }

        triggerDownloadBlob(blob, STICKER_FILE_NAME);
        showToast(`💾 已导出本软件专属样式文件「${STICKER_FILE_NAME}」！`, 'success');
      });

      // 点击「📂 载入样式 ▾」：展开/收起单列菜单（自动静默拉取同级「自定义样式」子文件夹内容，零弹窗！）
      els.btnImportStickersFile.addEventListener('click', async e => {
        e.stopPropagation();
        state.styleImportMenuOpen = !state.styleImportMenuOpen;
        if (state.styleImportMenuOpen) {
          if (hasNativeDesktopBridge() && typeof window.pywebview.api.list_subfolder_styles === 'function') {
            await loadStickersFromBoundFolder(true);
          } else if (state.directoryHandle || state.styleSubfolderHandle) {
            await loadStickersFromBoundFolder(true);
          }
          renderStyleImportSubfolderMenu();
        }
        if (els.styleImportDropdownMenu) {
          els.styleImportDropdownMenu.classList.toggle('hidden', !state.styleImportMenuOpen);
        }
        if (els.styleImportMenuArrow) {
          els.styleImportMenuArrow.textContent = state.styleImportMenuOpen ? '▴' : '▾';
        }
      });

      // 样式单列菜单第 1 项：「💻 自选位置导入样式 (.json)...」
      if (els.btnPickStyleFromDisk) {
        els.btnPickStyleFromDisk.addEventListener('click', async () => {
          state.styleImportMenuOpen = false;
          if (els.styleImportDropdownMenu) els.styleImportDropdownMenu.classList.add('hidden');
          if (els.styleImportMenuArrow) els.styleImportMenuArrow.textContent = '▾';

          if (typeof window.showOpenFilePicker === 'function') {
            try {
              const opts = {
                types: [{ description: '西西自定义样式 JSON', accept: { 'application/json': ['.json'] } }],
                multiple: true
              };
              const handles = await window.showOpenFilePicker(opts);
              let importedCount = 0;
              let lastSnap = null;
              for (const h of handles) {
                const f = await h.getFile();
                const parsed = JSON.parse(await f.text());
                if (parsed && Array.isArray(parsed.stickers)) {
                  parsed.stickers.forEach(st => {
                    if (st && st.name && isValidXixiStyleSnapshot(st.snapshot)) {
                      if (!state.styleStickers.some(x => x.name === st.name)) {
                        state.styleStickers.push(st);
                      }
                      lastSnap = st.snapshot;
                      importedCount++;
                    }
                  });
                } else if (parsed && isValidXixiStyleSnapshot(parsed.snapshot)) {
                  const stName = parsed.name || `📌 ${f.name.replace(/\.json$/i, '')}`;
                  if (!state.styleStickers.some(x => x.name === stName)) {
                    state.styleStickers.push({
                      id: parsed.id || ('stk_' + Date.now() + '_' + importedCount),
                      name: stName,
                      snapshot: parsed.snapshot
                    });
                  }
                  lastSnap = parsed.snapshot;
                  importedCount++;
                }
              }
              if (importedCount > 0) {
                if (lastSnap) {
                  const s = getActiveStyle();
                  Object.keys(lastSnap).forEach(k => {
                    if (k === 'gridCells') {
                      s.gridKey = lastSnap.gridKey || '3x3';
                      s.gridCols = lastSnap.gridCols || 3;
                      s.gridRows = lastSnap.gridRows || 3;
                      s.gridCells = [...lastSnap.gridCells];
                    } else {
                      s[k] = lastSnap[k];
                    }
                  });
                }
                renderStyleStickers();
                syncControlsFromActiveStyle();
                showToast(`📂 成功导入并套用 ${importedCount} 款本软件专属样式！`, 'success');
              } else {
                showToast('⚠️ 无法读取：仅支持读取本软件导出的专属样式格式 (.json)！', 'warn');
              }
              return;
            } catch (err) {
              if (err && err.name === 'AbortError') return;
            }
          }
          els.stickerFileInput.click();
        });
      }

      // 样式单列菜单内：「🔄 刷新/读取子夹」按钮（优先走桌面启动器固定同级路径免弹窗读取）
      if (els.btnScanStyleSubfolder) {
        els.btnScanStyleSubfolder.addEventListener('click', async () => {
          if (hasNativeDesktopBridge() && typeof window.pywebview.api.list_subfolder_styles === 'function') {
            await loadStickersFromBoundFolder(false);
            renderStyleImportSubfolderMenu();
            return;
          }
          const styleDir = state.styleSubfolderHandle || await ensureSubfolderHandle('自定义样式', true);
          if (styleDir) {
            state.styleSubfolderHandle = styleDir;
            await loadStickersFromBoundFolder(false);
            renderStyleImportSubfolderMenu();
          }
        });
      }
      els.stickerFileInput.addEventListener('change', e => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = ev => {
          try {
            const parsed = JSON.parse(ev.target.result);
            let validList = [];
            if (parsed && isValidXixiStyleSnapshot(parsed.snapshot)) {
              validList = [{ id: parsed.id || ('stk_' + Date.now()), name: parsed.name || ('📌 ' + file.name.replace(/\.json$/i, '')), snapshot: parsed.snapshot }];
            } else {
              const rawList = Array.isArray(parsed) ? parsed : (parsed && Array.isArray(parsed.stickers) ? parsed.stickers : null);
              if (rawList) {
                validList = rawList.filter(st => st && st.name && isValidXixiStyleSnapshot(st.snapshot));
              }
            }
            if (validList.length === 0) throw new Error('Invalid format');
            validList.forEach(st => {
              if (!state.styleStickers.some(x => x.name === st.name)) state.styleStickers.push(st);
            });
            renderStyleStickers();
            showToast(`📂 成功载入 ${validList.length} 款本软件专属样式！`, 'success');
          } catch (err) {
            showToast('⚠️ 无法读取：仅支持读取本软件导出的专属样式格式 (.json)！', 'warn');
          }
        };
        reader.readAsText(file);
        e.target.value = '';
      });

      // 问题5：水平/垂直偏移滑块 + 快捷按钮 + 一键重置偏移与行距
      els.btnResetOffsets.addEventListener('click', () => {
        const s = getActiveStyle();
        s.offsetX = 0;
        s.offsetY = 0;
        s.rowGapScale = 100;
        s.staggerRow = true;
        syncControlsFromActiveStyle();
        showToast('↺ 水平/垂直位移与行距已全部重置回初始状态 (0, 0)！', 'info');
      });

      document.querySelectorAll('.quick-offx').forEach(btn => {
        btn.addEventListener('click', () => {
          getActiveStyle().offsetX = Number(btn.dataset.offx);
          syncControlsFromActiveStyle();
        });
      });
      document.querySelectorAll('.quick-offy').forEach(btn => {
        btn.addEventListener('click', () => {
          getActiveStyle().offsetY = Number(btn.dataset.offy);
          syncControlsFromActiveStyle();
        });
      });
      document.querySelectorAll('.quick-rowgap').forEach(btn => {
        btn.addEventListener('click', () => {
          getActiveStyle().rowGapScale = Number(btn.dataset.rowgap);
          syncControlsFromActiveStyle();
        });
      });

      els.staggerRowToggle.addEventListener('change', e => {
        getActiveStyle().staggerRow = e.target.checked;
        renderWatermarkOverlay();
      });

      els.watermarkText.addEventListener('input', e => {
        const s = getActiveStyle();
        s.watermarkText = e.target.value;
        if (!s.enableText && e.target.value.trim().length > 0) {
          s.enableText = true;
          els.enableTextToggle.checked = true;
        }
        renderWatermarkOverlay();
      });

      els.btnInsertDate.addEventListener('click', () => {
        const s = getActiveStyle();
        s.enableText = true;
        const today = new Date().toISOString().slice(0, 10);
        const base = (s.watermarkText || CODE_DEFAULT_WATERMARK_TEXT).trim();
        s.watermarkText = base.includes(today) ? base : `${base} / ${today}`;
        syncControlsFromActiveStyle();
        showToast('📅 已追加今日日期！', 'success');
      });

      els.btnClearText.addEventListener('click', () => {
        const s = getActiveStyle();
        s.enableText = true;
        s.watermarkText = '';
        syncControlsFromActiveStyle();
        showToast('✨ 已清空输入，使用默认词「西西专属·严禁外传」', 'info');
      });

      els.fontFamilySelect.addEventListener('change', e => {
        getActiveStyle().fontFamily = e.target.value;
        renderWatermarkOverlay();
      });

      document.querySelectorAll('.color-swatch').forEach(btn => {
        btn.addEventListener('click', () => {
          const s = getActiveStyle();
          s.color = btn.dataset.color;
          s.colorName = btn.dataset.name;
          syncControlsFromActiveStyle();
        });
      });
      els.customColorInput.addEventListener('input', e => {
        const s = getActiveStyle();
        s.color = e.target.value;
        s.colorName = '特调';
        syncControlsFromActiveStyle();
      });

      /**
       * 问题4核心实现：
       * 1. 滑块拖动与鼠标滚轮悬停滚动均按整倍数 step 跳动（如角度 5° 一档、透明度 5% 一档、间距 10px 一档）
       * 2. 右侧数字输入框支持手敲任意 1 单位精度数值（如 -17°、23px），互不冲突！
       */
      function bindSliderAndNumber(sliderEl, numInputEl, propName, minVal, maxVal) {
        const stepVal = Number(sliderEl.step) || 1;

        sliderEl.addEventListener('input', e => {
          const val = Number(e.target.value);
          getActiveStyle()[propName] = val;
          numInputEl.value = val;
          renderWatermarkOverlay();
        });

        // 在滑块上滚动鼠标滚轮：按整倍数 step 干净跳动
        sliderEl.addEventListener('wheel', e => {
          e.preventDefault();
          const cur = Number(getActiveStyle()[propName]) || 0;
          const dir = e.deltaY < 0 ? 1 : -1;
          const snapped = Math.round((cur + dir * stepVal) / stepVal) * stepVal;
          const nextVal = Math.max(Number(sliderEl.min), Math.min(Number(sliderEl.max), snapped));
          getActiveStyle()[propName] = nextVal;
          sliderEl.value = nextVal;
          numInputEl.value = nextVal;
          renderWatermarkOverlay();
        }, { passive: false });

        numInputEl.addEventListener('input', e => {
          if (e.target.value === '' || e.target.value === '-') return;
          let val = Number(e.target.value);
          if (isNaN(val)) return;
          val = Math.max(minVal, Math.min(maxVal, val));
          getActiveStyle()[propName] = val;
          sliderEl.value = Math.max(Number(sliderEl.min), Math.min(Number(sliderEl.max), val));
          renderWatermarkOverlay();
        });

        numInputEl.addEventListener('blur', e => {
          let val = Number(e.target.value);
          if (isNaN(val)) val = getActiveStyle()[propName];
          val = Math.max(minVal, Math.min(maxVal, val));
          getActiveStyle()[propName] = val;
          numInputEl.value = val;
          sliderEl.value = Math.max(Number(sliderEl.min), Math.min(Number(sliderEl.max), val));
          renderWatermarkOverlay();
        });
      }

      bindSliderAndNumber(els.fontSizeSlider, els.fontSizeVal, 'fontSize', 8, 160);
      bindSliderAndNumber(els.opacitySlider, els.opacityVal, 'opacity', 1, 100);
      bindSliderAndNumber(els.angleSlider, els.angleVal, 'angle', -180, 180);
      bindSliderAndNumber(els.gapSlider, els.gapVal, 'gap', 30, 500);
      bindSliderAndNumber(els.rowGapScaleSlider, els.rowGapScaleInput, 'rowGapScale', 40, 250);
      bindSliderAndNumber(els.offsetXSlider, els.offsetXInput, 'offsetX', -300, 300);
      bindSliderAndNumber(els.offsetYSlider, els.offsetYInput, 'offsetY', -300, 300);
      bindSliderAndNumber(els.smoothRadiusSlider, els.smoothRadiusVal, 'smoothRadius', 0, 180);

      // 各个滑块下方的【小 / 中 / 大】快捷按钮
      document.querySelectorAll('.quick-size').forEach(btn => {
        btn.addEventListener('click', () => {
          getActiveStyle().fontSize = Number(btn.dataset.size);
          syncControlsFromActiveStyle();
        });
      });
      document.querySelectorAll('.quick-opacity').forEach(btn => {
        btn.addEventListener('click', () => {
          getActiveStyle().opacity = Number(btn.dataset.opacity);
          syncControlsFromActiveStyle();
        });
      });
      document.querySelectorAll('.quick-angle').forEach(btn => {
        btn.addEventListener('click', () => {
          getActiveStyle().angle = Number(btn.dataset.angle);
          syncControlsFromActiveStyle();
        });
      });
      document.querySelectorAll('.quick-gap').forEach(btn => {
        btn.addEventListener('click', () => {
          getActiveStyle().gap = Number(btn.dataset.gap);
          syncControlsFromActiveStyle();
        });
      });
      document.querySelectorAll('.quick-smooth').forEach(btn => {
        btn.addEventListener('click', () => {
          getActiveStyle().smoothRadius = Number(btn.dataset.smooth);
          syncControlsFromActiveStyle();
        });
      });

      // 覆盖区域双引擎与动态分组控制
      els.tabModeGrid.addEventListener('click', () => {
        const s = getActiveStyle();
        s.coverageMode = 'grid';
        s.simpleRecActive = '';
        syncControlsFromActiveStyle();
      });
      els.tabModeBox.addEventListener('click', () => {
        const s = getActiveStyle();
        s.coverageMode = 'box';
        s.simpleRecActive = '';
        syncControlsFromActiveStyle();
        showToast('📏 已进入自选磁吸区域！支持抬头/尾部/包边快捷预设与四边 0% 贴底拖拽', 'info');
      });

      els.smartMergeBandToggle.addEventListener('change', e => {
        getActiveStyle().smartMergeBand = e.target.checked;
        syncControlsFromActiveStyle();
      });

      els.btnAddSmoothGroup.addEventListener('click', () => {
        const s = getActiveStyle();
        const cur = s.groupCount || 1;
        if (cur >= 8) {
          showToast('⚠️ 最多支持创建 8 个平滑分组（A组~H组）哟！', 'warn');
          return;
        }
        s.groupCount = cur + 1;
        state.activeBrushGroup = s.groupCount;
        syncControlsFromActiveStyle();
        const newPal = GROUP_PALETTE[s.groupCount];
        showToast(`🎨 已新增「${newPal.name}」并切换画笔！`, 'success');
      });

      // 3 档预设网格切换 (3×3 / 6×9 / 9×9) + 自定义 x*y（单填一个自动默认正方形 x*x 或 y*y）
      document.querySelectorAll('.grid-size-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const s = getActiveStyle();
          const key = btn.dataset.gridkey;
          const spec = GRID_SPECS[key];
          if (!spec) return;
          const oldCols = s.gridCols || 3;
          const oldRows = s.gridRows || 3;
          if (oldCols === spec.cols && oldRows === spec.rows) return;
          s.gridCells = resampleGridRect(s.gridCells, oldCols, oldRows, spec.cols, spec.rows);
          s.gridKey = key;
          s.gridCols = spec.cols;
          s.gridRows = spec.rows;
          syncControlsFromActiveStyle();
          showToast(`🔢 已切换为 ${spec.label} 网格！`, 'success');
        });
      });

      const applyCustomGridAction = () => {
        const s = getActiveStyle();
        const rawX = (els.customGridXInput ? els.customGridXInput.value : '').trim();
        const rawY = (els.customGridYInput ? els.customGridYInput.value : '').trim();
        let nx = parseInt(rawX, 10);
        let ny = parseInt(rawY, 10);
        if (isNaN(nx) && isNaN(ny)) {
          showToast('💡 请输入自定义网格的 x(列数) 或 y(行数)，只填一个会自动按正方形生成哟！', 'info');
          return;
        }
        if (!isNaN(nx) && isNaN(ny)) {
          ny = nx;
        } else if (isNaN(nx) && !isNaN(ny)) {
          nx = ny;
        }
        const exceededMax = (nx > 21 || ny > 21);
        nx = Math.max(2, Math.min(21, nx));
        ny = Math.max(2, Math.min(21, ny));
        if (els.customGridXInput) els.customGridXInput.value = String(nx);
        if (els.customGridYInput) els.customGridYInput.value = String(ny);

        const oldCols = s.gridCols || 3;
        const oldRows = s.gridRows || 3;
        s.gridCells = resampleGridRect(s.gridCells, oldCols, oldRows, nx, ny);
        s.gridCols = nx;
        s.gridRows = ny;
        s.gridKey = `${nx}x${ny}`;
        syncControlsFromActiveStyle();
        if (exceededMax) {
          showToast(`⚠️ 自定义格数上限为 21×21，超出部分已自动锁定为 ${nx}×${ny}！`, 'warn');
        } else {
          showToast(`🔢 已应用自定义 ${nx}×${ny} ${nx === ny ? '正方形' : ''}网格！`, 'success');
        }
      };

      if (els.btnApplyCustomGrid) {
        els.btnApplyCustomGrid.addEventListener('click', applyCustomGridAction);
      }
      [els.customGridXInput, els.customGridYInput].forEach(inp => {
        if (!inp) return;
        inp.addEventListener('input', e => {
          const val = parseInt(e.target.value, 10);
          if (!isNaN(val) && val > 21) {
            e.target.value = '21';
            showToast('⚠️ 自定义格数上限为 21×21，已自动锁定为 21！', 'warn');
          }
        });
        inp.addEventListener('keydown', e => {
          if (e.key === 'Enter') {
            e.preventDefault();
            applyCustomGridAction();
          }
        });
      });

      els.btnInvertZones.addEventListener('click', () => {
        const s = getActiveStyle();
        const brush = state.activeBrushGroup || 1;
        s.gridCells = s.gridCells.map(v => v > 0 ? 0 : brush);
        if (s.singlePerZone) { s.offsetX = 0; s.offsetY = 0; }
        syncControlsFromActiveStyle();
      });

      els.btnClearZones.addEventListener('click', () => {
        const s = getActiveStyle();
        const total = (s.gridCols || 3) * (s.gridRows || 3);
        s.gridCells = new Array(total).fill(0);
        if (s.singlePerZone) { s.offsetX = 0; s.offsetY = 0; }
        syncControlsFromActiveStyle();
      });

      els.singlePerZoneToggle.addEventListener('change', e => {
        const s = getActiveStyle();
        s.singlePerZone = e.target.checked;
        if (s.singlePerZone) {
          s.offsetX = 0;
          s.offsetY = 0;
        }
        syncControlsFromActiveStyle();
        if (e.target.checked) {
          showToast('🎯 已开启独苗模式：点选任意区域自动归位平均中心，随后可在右图拖拽！', 'success');
        }
      });

      els.btnSnapSingleCenter.addEventListener('click', () => {
        const s = getActiveStyle();
        s.offsetX = 0;
        s.offsetY = 0;
        syncControlsFromActiveStyle();
        showToast('📍 独苗大章已归位到所选区域的几何平均中心！', 'success');
      });

      // 折叠式 6 款倒角款式抽屉交互与 ABCD 分组独立款式联动
      if (els.btnToggleSmoothDrawer) {
        els.btnToggleSmoothDrawer.addEventListener('click', () => {
          state.smoothDrawerOpen = !state.smoothDrawerOpen;
          syncControlsFromActiveStyle();
        });
      }

      if (els.perGroupSmoothToggle) {
        els.perGroupSmoothToggle.addEventListener('change', e => {
          const s = getActiveStyle();
          s.perGroupSmooth = e.target.checked;
          if (!s.perGroupSmooth) {
            const curKey = s.smoothStyle || 'concave';
            for (let g = 1; g <= 8; g++) s.groupSmoothStyles[g] = curKey;
          }
          syncControlsFromActiveStyle();
        });
      }

      if (els.btnSyncSmoothToAllGroups) {
        els.btnSyncSmoothToAllGroups.addEventListener('click', () => {
          const s = getActiveStyle();
          const activeGrp = (state.activeBrushGroup && state.activeBrushGroup !== INDEPENDENT_GROUP_VAL) ? state.activeBrushGroup : 1;
          const key = (s.groupSmoothStyles && s.groupSmoothStyles[activeGrp]) || s.smoothStyle || 'concave';
          s.smoothStyle = key;
          if (!s.groupSmoothStyles) s.groupSmoothStyles = {};
          for (let g = 1; g <= 8; g++) s.groupSmoothStyles[g] = key;
          syncControlsFromActiveStyle();
          showToast(`✨ 已将「${SMOOTH_STYLE_META[key].short}」统配给全部 A~H 平滑分组！`, 'success');
        });
      }

      document.querySelectorAll('.smooth-style-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const s = getActiveStyle();
          const key = btn.dataset.sstyle;
          s.smartMergeBand = true;
          s.smoothStyle = key;
          if (!s.groupSmoothStyles) s.groupSmoothStyles = {};
          const activeGrp = (state.activeBrushGroup && state.activeBrushGroup !== INDEPENDENT_GROUP_VAL) ? state.activeBrushGroup : 1;
          if (s.perGroupSmooth !== false) {
            s.groupSmoothStyles[activeGrp] = key;
          } else {
            for (let g = 1; g <= 8; g++) s.groupSmoothStyles[g] = key;
          }
          syncControlsFromActiveStyle();
          const meta = SMOOTH_STYLE_META[key] || SMOOTH_STYLE_META.concave;
          const pal = GROUP_PALETTE[activeGrp] || GROUP_PALETTE[1];
          showToast(`🌊 已为 ${s.perGroupSmooth !== false ? pal.name : '全部平滑组'} 切换倒角款式：「${meta.short}」！`, 'success');
        });
      });

      /**
       * 问题3完美实现：根据不同网格密度智能区分「主对角 / 副对角 / X型」几何选区形态！
       * - 当为 3×3（或 <=4×4 的小网格）时：点亮经典单格对角 (0,0)-(1,1)-(2,2)。
       * - 当为 6×9、9×9 或高密自定义网格时：复刻图2 (image_63694f.jpg) 的「逐行逐格连续递进斜带」形态，
       *   首尾两端各保持约 1/3 宽度的平齐肩部，中间每一行平滑递进 1 格，告别呆板的 3 大块断层，且 100% 中心与镜像对称！
       */
      function markSymmetricDiagonal(cells, cols, rows, brush, isAnti = false) {
        if (cols <= 3 && rows <= 3) {
          const steps = Math.max(cols, rows);
          for (let k = 0; k < steps; k++) {
            const r = Math.min(rows - 1, Math.floor(((k + 0.5) / steps) * rows));
            const c0 = Math.min(cols - 1, Math.floor(((k + 0.5) / steps) * cols));
            const rMir = rows - 1 - r;
            const cMir = cols - 1 - c0;
            const colA = isAnti ? (cols - 1 - c0) : c0;
            const colB = isAnti ? (cols - 1 - cMir) : cMir;
            cells[r * cols + colA] = brush;
            cells[rMir * cols + colB] = brush;
          }
          return;
        }

        // 高密网格（6×9、9×9 及自定义网格）：完全复刻图2 (image_63694f.jpg) 的「滑窗递进斜带」形态！
        // 首尾两行稳稳点亮 wBand 格（如 9列下 r=0,1 均为 0,1,2 三格，末两行均为 6,7,8 三格），中间逐行平滑递进！
        const wBand = Math.max(2, Math.round(cols / 3));
        const maxStart = Math.max(0, cols - wBand);
        const effRows = Math.max(1, rows - 3);
        for (let r = 0; r < rows; r++) {
          let cStart, cEnd;
          if (r <= 1) {
            cStart = 0;
            cEnd = wBand - 1;
          } else if (r >= rows - 2) {
            cStart = cols - wBand;
            cEnd = cols - 1;
          } else {
            const t = (r - 1.5) / effRows;
            const centerStart = t * maxStart;
            cStart = Math.max(0, Math.min(maxStart, Math.floor(centerStart)));
            cEnd = Math.min(cols - 1, Math.max(cStart + wBand - 1, Math.ceil(centerStart) + wBand - 1));
          }
          for (let c = cStart; c <= cEnd; c++) {
            const rMir = rows - 1 - r;
            const cMir = cols - 1 - c;
            const colA = isAnti ? (cols - 1 - c) : c;
            const colB = isAnti ? (cols - 1 - cMir) : cMir;
            cells[r * cols + colA] = brush;
            cells[rMir * cols + colB] = brush;
          }
        }
      }

      document.querySelectorAll('.zone-preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const s = getActiveStyle();
          const pName = btn.dataset.preset;
          const cols = s.gridCols || 3;
          const rows = s.gridRows || 3;
          const brush = (state.activeBrushGroup && state.activeBrushGroup !== INDEPENDENT_GROUP_VAL) ? state.activeBrushGroup : 1;

          s.gridCells = new Array(cols * rows).fill(0);
          if (pName === 'all') {
            s.gridCells.fill(brush);
          } else if (pName === 'diagonal') {
            markSymmetricDiagonal(s.gridCells, cols, rows, brush, false);
            s.smartMergeBand = true;
          } else if (pName === 'antidiag') {
            markSymmetricDiagonal(s.gridCells, cols, rows, brush, true);
            s.smartMergeBand = true;
          } else if (pName === 'xshape') {
            markSymmetricDiagonal(s.gridCells, cols, rows, brush, false);
            markSymmetricDiagonal(s.gridCells, cols, rows, brush, true);
            s.smartMergeBand = true;
          }

          if (s.singlePerZone) {
            s.offsetX = 0;
            s.offsetY = 0;
          }
          s.simpleRecActive = '';
          syncControlsFromActiveStyle();
        });
      });

      // 自选磁吸区域控制（含抬头、尾部、上下页眉页尾、四周包边、标准内框）
      els.btnBoxInside.addEventListener('click', () => {
        getActiveStyle().boxInvert = false;
        syncControlsFromActiveStyle();
      });
      els.btnBoxOutside.addEventListener('click', () => {
        getActiveStyle().boxInvert = true;
        syncControlsFromActiveStyle();
      });
      els.snapGridToggle.addEventListener('change', e => {
        getActiveStyle().snapGrid = e.target.checked;
      });
      els.symLockToggle.addEventListener('change', e => {
        const s = getActiveStyle();
        s.symLock = e.target.checked;
        if (s.symLock) {
          s.boxBottom = s.boxTop;
          s.boxRight = s.boxLeft;
          syncControlsFromActiveStyle();
        }
      });

      function bindBoxInput(inputEl, prop, mirrorProp) {
        inputEl.addEventListener('input', e => {
          if (e.target.value === '') return;
          let val = Math.max(0, Math.min(90, Number(e.target.value) || 0));
          const s = getActiveStyle();
          s[prop] = val;
          if (s.symLock) s[mirrorProp] = val;
          syncControlsFromActiveStyle();
        });
      }
      bindBoxInput(els.boxTopInput, 'boxTop', 'boxBottom');
      bindBoxInput(els.boxBottomInput, 'boxBottom', 'boxTop');
      bindBoxInput(els.boxLeftInput, 'boxLeft', 'boxRight');
      bindBoxInput(els.boxRightInput, 'boxRight', 'boxLeft');

      document.querySelectorAll('.quick-box-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const [t, b, l, r, inv] = btn.dataset.box.split(',').map(Number);
          const s = getActiveStyle();
          s.coverageMode = 'box';
          s.boxTop = t; s.boxBottom = b; s.boxLeft = l; s.boxRight = r;
          s.boxInvert = Boolean(inv);
          s.symLock = false;
          if (s.singlePerZone) { s.offsetX = 0; s.offsetY = 0; }
          syncControlsFromActiveStyle();
        });
      });

      els.showGridLinesToggle.addEventListener('change', e => {
        state.showGridLines = e.target.checked;
        renderWatermarkOverlay();
      });

      // 内置 3 页说明书样板与上传 PDF 的翻页控制
      els.demoTemplateSelect.addEventListener('change', e => {
        state.demoPageNum = Number(e.target.value) || 1;
        state.activeFileId = null;
        els.basePageCanvas.height = 842;
        els.watermarkOverlayCanvas.height = 842;
        renderFileQueue();
        drawDemoBasePage();
        renderWatermarkOverlay();
      });

      const startHold = () => { state.holdOriginal = true; renderWatermarkOverlay(); };
      const endHold = () => { state.holdOriginal = false; renderWatermarkOverlay(); };
      els.btnHoldOriginal.addEventListener('mousedown', startHold);
      els.btnHoldOriginal.addEventListener('mouseup', endHold);
      els.btnHoldOriginal.addEventListener('mouseleave', endHold);
      els.btnHoldOriginal.addEventListener('touchstart', e => { e.preventDefault(); startHold(); });
      els.btnHoldOriginal.addEventListener('touchend', endHold);

      els.pageRangeModeSelect.addEventListener('change', e => {
        const s = getActiveStyle();
        s.pageRangeMode = e.target.value;
        syncControlsFromActiveStyle();
      });
      els.customPageRangeInput.addEventListener('input', e => {
        getActiveStyle().customPageRange = e.target.value;
        syncControlsFromActiveStyle();
      });

      els.btnPrevPage.addEventListener('click', () => {
        if (state.activeFileId) {
          if (state.activePageNum > 1) {
            state.activePageNum--;
            renderUploadedPdfPage();
          }
        } else {
          state.demoPageNum = state.demoPageNum > 1 ? state.demoPageNum - 1 : 2;
          drawDemoBasePage();
          renderWatermarkOverlay();
        }
      });
      els.btnNextPage.addEventListener('click', () => {
        if (state.activeFileId) {
          if (state.activePageNum < state.activeTotalPages) {
            state.activePageNum++;
            renderUploadedPdfPage();
          }
        } else {
          state.demoPageNum = state.demoPageNum < 2 ? state.demoPageNum + 1 : 1;
          drawDemoBasePage();
          renderWatermarkOverlay();
        }
      });
      els.pageJumpInput.addEventListener('change', e => {
        let p = parseInt(e.target.value, 10);
        if (isNaN(p)) p = 1;
        if (state.activeFileId) {
          p = Math.max(1, Math.min(state.activeTotalPages, p));
          state.activePageNum = p;
          renderUploadedPdfPage();
        } else {
          p = Math.max(1, Math.min(2, p));
          state.demoPageNum = p;
          drawDemoBasePage();
          renderWatermarkOverlay();
        }
      });

      if (els.btnImportSourceDir) {
        els.btnImportSourceDir.addEventListener('click', async e => {
          e.stopPropagation();
          if (typeof window.showDirectoryPicker !== 'function') {
            showToast('⚠️ 当前浏览器不支持直接读取文件夹，请直接点击挑选文件', 'warn');
            return;
          }
          try {
            const dirHandle = await window.showDirectoryPicker({ mode: 'readwrite' });
            state.sourceDirHandle = dirHandle;
            if (els.sourceDirBindHint) {
              els.sourceDirBindHint.innerHTML = `✅ 已绑定源文件夹：<b>「${dirHandle.name}」</b> · 待会儿点「⚡ 快速保存 A」将免弹窗直接存回该目录！`;
              els.sourceDirBindHint.className = 'text-[11px] text-emerald-700 font-bold';
            }
            const files = [];
            const handles = [];
            for await (const entry of dirHandle.values()) {
              if (entry.kind === 'file' && /\.(pdf|docx)$/i.test(entry.name) && !entry.name.includes(getEffectiveSuffix())) {
                files.push(await entry.getFile());
                handles.push(entry);
              }
            }
            if (files.length > 0) {
              await handleIncomingFiles(files, handles);
            } else {
              showToast(`📁 已绑定源文件夹「${dirHandle.name}」（可继续拖入文件，保存A将直接存回此目录）`, 'success');
            }
          } catch (err) {
            if (err && err.name === 'AbortError') return;
          }
        });
      }

      els.dropZone.addEventListener('click', async () => {
        if (hasNativeDesktopBridge() && typeof window.pywebview.api.pick_input_files === 'function') {
          try {
            const pickedList = await window.pywebview.api.pick_input_files();
            if (pickedList && pickedList.length > 0) {
              const fakeFiles = pickedList.map(item => {
                learnUserHomeFromPath(item.path || '');
                const buf = base64ToArrayBuffer(item.base64);
                const f = new File([buf], item.name, {
                  type: item.name.toLowerCase().endsWith('.docx')
                    ? 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                    : 'application/pdf'
                });
                Object.defineProperty(f, 'path', { value: item.path });
                return f;
              });
              await handleIncomingFiles(fakeFiles);
            }
            return;
          } catch (e) {}
        }
        if (typeof window.showOpenFilePicker === 'function') {
          try {
            const handles = await window.showOpenFilePicker({
              multiple: true,
              types: [{
                description: 'PDF 或 Word 文档 (.pdf, .docx)',
                accept: {
                  'application/pdf': ['.pdf'],
                  'application/vnd.openxmlformats-officedocument.wordprocessingml.document': ['.docx']
                }
              }]
            });
            if (handles && handles.length > 0) {
              const files = [];
              for (const h of handles) {
                files.push(await h.getFile());
              }
              await handleIncomingFiles(files, handles);
              return;
            }
          } catch (err) {
            if (err && err.name === 'AbortError') return;
          }
        }
        els.pdfFileInput.click();
      });
      els.pdfFileInput.addEventListener('change', e => {
        if (e.target.files && e.target.files.length > 0) {
          handleIncomingFiles(e.target.files);
          e.target.value = '';
        }
      });
      els.dropZone.addEventListener('dragover', e => {
        e.preventDefault();
        els.dropZone.classList.add('bg-rose-200/60', 'scale-[1.01]');
      });
      els.dropZone.addEventListener('dragleave', () => {
        els.dropZone.classList.remove('bg-rose-200/60', 'scale-[1.01]');
      });
      els.dropZone.addEventListener('drop', async e => {
        e.preventDefault();
        els.dropZone.classList.remove('bg-rose-200/60', 'scale-[1.01]');
        if (!e.dataTransfer) return;
        const rawFiles = Array.from(e.dataTransfer.files || []);
        const items = Array.from(e.dataTransfer.items || []);
        const handles = [];
        for (let i = 0; i < items.length; i++) {
          if (typeof items[i].getAsFileSystemHandle === 'function') {
            try {
              const h = await items[i].getAsFileSystemHandle();
              if (h && h.kind === 'directory') {
                // 如果用户直接把整个源文件夹拖进了上传框！直接获得文件夹读写权限，后续零弹窗秒存回！
                state.sourceDirHandle = h;
                if (els.sourceDirBindHint) {
                  els.sourceDirBindHint.innerHTML = `✅ 已绑定拖入的源文件夹：<b>「${h.name}」</b> · 点「⚡ 快速保存 A」将免弹窗直接存回该目录！`;
                  els.sourceDirBindHint.className = 'text-[11px] text-emerald-700 font-bold';
                }
                const dirFiles = [];
                const dirHandles = [];
                for await (const entry of h.values()) {
                  if (entry.kind === 'file' && /\.(pdf|docx)$/i.test(entry.name) && !entry.name.includes(getEffectiveSuffix())) {
                    dirFiles.push(await entry.getFile());
                    dirHandles.push(entry);
                  }
                }
                if (dirFiles.length > 0) {
                  await handleIncomingFiles(dirFiles, dirHandles);
                }
                return;
              }
              handles[i] = h;
            } catch (err) {
              handles[i] = null;
            }
          }
        }
        if (rawFiles.length > 0) {
          handleIncomingFiles(rawFiles, handles);
        }
      });

      els.btnClearQueue.addEventListener('click', () => {
        state.files = [];
        state.activeFileId = null;
        state.editingFileId = null;
        els.basePageCanvas.height = 842;
        els.watermarkOverlayCanvas.height = 842;
        drawDemoBasePage();
        syncControlsFromActiveStyle();
        state.userEditedZipName = false; syncDynamicZipFolderName(); showToast('🗑️ 已清空队列，回到内置 2 页大字版说明书样板', 'info');
      });

      els.customSuffixInput.addEventListener('input', e => {
        state.customSuffix = e.target.value;
        renderWatermarkOverlay();
      });
      if (els.noSuffixToggle) {
        els.noSuffixToggle.addEventListener('change', e => {
          state.noSuffix = e.target.checked;
          renderWatermarkOverlay();
          showToast(
            state.noSuffix
              ? '🚫 已开启「无后缀」模式：导出文件将直接保持原文件名！'
              : `🏷️ 已恢复导出后缀：「${getEffectiveSuffix()}」`,
            'info'
          );
        });
      }

      els.btnPickFolder.addEventListener('click', async () => {
        if (typeof window.showDirectoryPicker === 'function') {
          try {
            const handle = await window.showDirectoryPicker({ mode: 'readwrite' });
            await bindProjectDirectoryHandle(handle);
            showToast(`📁 已绑定同级目录「${handle.name}」，自动直连「自定义样式」与「自定义图片」子文件夹！`, 'success');
            return;
          } catch (err) {
            if (err && err.name === 'AbortError') return;
          }
        }
        els.virtualFolderName.focus();
        els.virtualFolderName.select();
        const folderVal = els.virtualFolderName.value.trim() || '西西盖好章的PDF小窝';
        els.selectedFolderText.textContent = `📂 输出文件夹包：「${folderVal}」`;
        showToast('💡 已锁定右侧输出文件夹名！', 'info');
      });

      els.virtualFolderName.addEventListener('input', e => {
        const raw = e.target.value.trim();
        state.userEditedZipName = raw.length > 0 && raw !== computeDefaultZipName();
        const val = raw || computeDefaultZipName();
        if (!state.directoryHandle) {
          els.selectedFolderText.textContent = `📂 输出文件夹包：「${val}」`;
        }
      });

      els.btnProcessBatch.addEventListener('click', () => runBatchWatermark('folder'));
      els.btnProcessZip.addEventListener('click', () => runBatchWatermark('zip'));

      const btnBackToHub = document.getElementById('btnBackToHub');
      if (btnBackToHub) {
        btnBackToHub.addEventListener('click', async () => {
          if (hasNativeDesktopBridge() && typeof window.pywebview.api.go_home === 'function') {
            await window.pywebview.api.go_home();
          } else {
            showToast('💡 请通过「启动西西工具包.bat」打开，即可一键返回工具包大厅切换其他插件哟！', 'info');
          }
        });
      }

      // a. 全局重置（放在顶栏右边：回到普通模式，并且预设全回到经典铺满屏）
      els.btnResetAll.addEventListener('click', () => {
        try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
        state.uiMode = 'simple';
        state.globalProfiles = [
          createDefaultStyleConfig(),
          createDefaultStyleConfig(),
          createDefaultStyleConfig()
        ];
        state.activeProfileIndex = 0;
        state.editingFileId = null;
        state.activeBrushGroup = 1;
        state.customSuffix = '';
        state.noSuffix = false;
        els.customSuffixInput.value = '';
        if (els.noSuffixToggle) els.noSuffixToggle.checked = false;
        if (els.customGridXInput) els.customGridXInput.value = 3;
        if (els.customGridYInput) els.customGridYInput.value = 3;
        renderStyleStickers();
        syncControlsFromActiveStyle();
        showToast('🔄 全局重置完成：已回到「🌸 普通模式」并恢复经典全屏铺满预设！', 'success');
      });

      // b. 印章字体重置（放在字体面板右边：只重置所有字体与排版参数，不碰水印文字、图案与网格选区）
      if (els.btnResetFontParams) {
        els.btnResetFontParams.addEventListener('click', () => {
          const s = getActiveStyle();
          const def = createDefaultStyleConfig();
          s.fontFamily = def.fontFamily;
          s.color = def.color;
          s.colorName = def.colorName;
          s.fontSize = def.fontSize;
          s.opacity = def.opacity;
          s.angle = def.angle;
          s.gap = def.gap;
          s.rowGapScale = def.rowGapScale;
          s.staggerRow = def.staggerRow;
          s.hollowText = def.hollowText;
          syncControlsFromActiveStyle();
          showToast('↺ 印章字体重置完成：字体、颜色、字号、透明度、角度与间距已恢复默认！', 'info');
        });
      }

      // c. 网格调整重置（只在高级模式显示，放在网格面板右边：重置所有网格区域与参数，回到最开始的 3×3 且全屏）
      if (els.btnResetGridParams) {
        els.btnResetGridParams.addEventListener('click', () => {
          const s = getActiveStyle();
          s.coverageMode = 'grid';
          s.gridKey = '3x3';
          s.gridCols = 3;
          s.gridRows = 3;
          s.groupCount = 1;
          s.gridCells = new Array(9).fill(1);
          s.smartMergeBand = true;
          s.smoothStyle = 'concave';
          s.perGroupSmooth = true;
          s.groupSmoothStyles = { 1: 'concave', 2: 'slope', 3: 'allround', 4: 'concave', 5: 'slope', 6: 'allround', 7: 'concave', 8: 'slope' };
          s.smoothRadius = 90;
          s.singlePerZone = false;
          s.boxTop = 14;
          s.boxBottom = 14;
          s.boxLeft = 10;
          s.boxRight = 10;
          s.boxInvert = false;
          s.snapGrid = false;
          s.symLock = false;
          s.simpleRecActive = 'fullscreen';
          state.activeBrushGroup = 1;
          if (els.customGridXInput) els.customGridXInput.value = 3;
          if (els.customGridYInput) els.customGridYInput.value = 3;
          syncControlsFromActiveStyle();
          showToast('↺ 网格调整重置完成：已恢复为初始 3×3 全屏铺满与默认内凹倒角(90°)！', 'info');
        });
      }

      const closeModal = () => {
        els.resultModal.classList.add('hidden');
        els.resultModal.classList.remove('flex');
      };
      els.btnCloseModal.addEventListener('click', closeModal);
      els.btnCloseModalBottom.addEventListener('click', closeModal);

      // 切换弹窗内的「批量 PDF 模式 ⇄ 打包 ZIP 模式」
      els.btnDownloadAllZipInModal.addEventListener('click', () => {
        const nextMode = (state.lastRunMode === 'zip') ? 'batch' : 'zip';
        openResultModal(nextMode);
      });

      // ==================== V11 批量快速保存（直接零弹窗存入用户设定的默认存储位置，并记入历史缓存） ====================
      async function executeBatchQuickSaveAndShowReceipt() {
        if (state.lastProcessedResults.length === 0) return;

        // 1. 优先走桌面启动器环境 (pywebview) 的 save_batch_to_default_dir
        if (hasNativeDesktopBridge() && typeof window.pywebview.api.save_batch_to_default_dir === 'function') {
          try {
            const payload = state.lastProcessedResults.map(r => ({
              sourcePath: r.sourcePath || '',
              originalName: r.originalName || r.fileName,
              fileName: r.fileName,
              profileLabel: r.profileLabel || '',
              isZip: false,
              base64: uint8ToBase64(new Uint8Array(r.bytes))
            }));
            const ret = await window.pywebview.api.save_batch_to_default_dir(payload);
            if (ret && ret.ok && Array.isArray(ret.records)) {
              const recs = ret.records.map((rec, i) => ({
                ...rec,
                blob: state.lastProcessedResults[i]?.blob,
                bytes: state.lastProcessedResults[i]?.bytes,
                revoked: false
              }));
              state.lastQuickSaveRecords = recs;
              appendRecordsToPersistentHistory(recs, ret.history);
              renderQuickSaveReceiptView('quick');
              return;
            }
          } catch (e) {}
        }

        // 2. 若在浏览器中绑定了默认保存目录句柄 (state.defaultSaveDirHandle)
        if (state.defaultSaveDirHandle && typeof state.defaultSaveDirHandle.getFileHandle === 'function') {
          try {
            const records = [];
            const firstSrc = (state.lastProcessedResults[0] && state.lastProcessedResults[0].sourcePath) || '';
            for (const res of state.lastProcessedResults) {
              const fh = await state.defaultSaveDirHandle.getFileHandle(res.fileName, { create: true });
              const writable = await fh.createWritable();
              await writable.write(res.blob);
              await writable.close();
              const fullPath = buildConcreteCustomPath(state.defaultSaveDirHandle.name, res.fileName, firstSrc);
              const dirPath = fullPath.replace(/\\[^\\]+$/, '');
              records.push({
                id: 'his_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
                fileName: res.fileName,
                originalName: res.originalName,
                savedPath: fullPath,
                dirPath: dirPath,
                timestamp: new Date().toLocaleString('zh-CN', { hour12: false }),
                savedDirHandle: state.defaultSaveDirHandle,
                savedFileHandle: fh,
                blob: res.blob,
                bytes: res.bytes,
                status: 'saved',
                revoked: false,
                isZip: false
              });
            }
            state.lastQuickSaveRecords = records;
            appendRecordsToPersistentHistory(records);
            renderQuickSaveReceiptView('quick');
            return;
          } catch (e) {}
        }

        // 3. 浏览器默认下载通道回退
        const downloadsDir = resolveConcreteDownloadsDir();
        const records = [];
        state.lastProcessedResults.forEach((res, idx) => {
          setTimeout(() => triggerDownloadBlob(res.blob, res.fileName), idx * 160);
          const sp = `${downloadsDir}\${res.fileName}`;
          records.push({
            id: 'his_' + Date.now() + '_' + idx,
            fileName: res.fileName,
            originalName: res.originalName,
            savedPath: sp,
            dirPath: downloadsDir,
            timestamp: new Date().toLocaleString('zh-CN', { hour12: false }),
            downloadUrl: res.url,
            blob: res.blob,
            bytes: res.bytes,
            status: 'saved',
            revoked: false,
            isZip: false
          });
        });
        state.lastQuickSaveRecords = records;
        appendRecordsToPersistentHistory(records);
        renderQuickSaveReceiptView('quick');
      }

      if (els.btnQuickSaveSourceA) {
        els.btnQuickSaveSourceA.addEventListener('click', () => {
          executeBatchQuickSaveAndShowReceipt();
        });
      }
      if (els.btnQuickSaveBrowserB) {
        els.btnQuickSaveBrowserB.addEventListener('click', () => {
          executeBatchQuickSaveAndShowReceipt();
        });
      }

      // 【批量保存 - 右侧按钮：📂 自定义位置（优先调用 Python 原生文件夹选择框，彻底告别 file:/// 报错！）】
      if (els.btnBatchCustomLocation) {
        els.btnBatchCustomLocation.addEventListener('click', async () => {
          if (state.lastProcessedResults.length === 0) return;

          if (hasNativeDesktopBridge() && typeof window.pywebview.api.save_batch_custom_dir === 'function') {
            try {
              const payload = state.lastProcessedResults.map(r => ({
                fileName: r.fileName,
                originalName: r.originalName || r.fileName,
                profileLabel: r.profileLabel || '',
                isZip: false,
                base64: uint8ToBase64(new Uint8Array(r.bytes))
              }));
              const ret = await window.pywebview.api.save_batch_custom_dir(payload);
              if (ret && ret.ok && Array.isArray(ret.records)) {
                const recs = ret.records.map((rec, i) => ({
                  ...rec,
                  blob: state.lastProcessedResults[i]?.blob,
                  bytes: state.lastProcessedResults[i]?.bytes,
                  revoked: false
                }));
                state.lastQuickSaveRecords = recs;
                appendRecordsToPersistentHistory(recs, ret.history);
                renderQuickSaveReceiptView('custom');
              }
              return;
            } catch (e) {}
          }

          if (typeof window.showDirectoryPicker === 'function') {
            try {
              const customDir = await window.showDirectoryPicker({ mode: 'readwrite' });
              const records = [];
              const firstSrc = (state.lastProcessedResults[0] && state.lastProcessedResults[0].sourcePath) || '';
              for (const res of state.lastProcessedResults) {
                const fh = await customDir.getFileHandle(res.fileName, { create: true });
                const writable = await fh.createWritable();
                await writable.write(res.blob);
                await writable.close();
                const fullPath = buildConcreteCustomPath(customDir.name, res.fileName, firstSrc);
                const dirPath = fullPath.replace(/\\[^\\]+$/, '');
                records.push({
                  id: 'his_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
                  fileName: res.fileName,
                  originalName: res.originalName,
                  savedPath: fullPath,
                  dirPath: dirPath,
                  timestamp: new Date().toLocaleString('zh-CN', { hour12: false }),
                  savedDirHandle: customDir,
                  savedFileHandle: fh,
                  blob: res.blob,
                  bytes: res.bytes,
                  status: 'saved',
                  revoked: false,
                  isZip: false
                });
              }
              state.lastQuickSaveRecords = records;
              appendRecordsToPersistentHistory(records);
              renderQuickSaveReceiptView('custom');
              return;
            } catch (err) {
              if (err && err.name === 'AbortError') return;
            }
          }

          if (state.lastProcessedResults.length === 1) {
            await saveSingleResultWithPicker(state.lastProcessedResults[0]);
          } else {
            executeBatchQuickSaveAndShowReceipt();
          }
        });
      }

      // 【打包压缩保存 - 左侧按钮：📥 快速保存 (默认位置)】
      if (els.btnZipQuickBrowserB) {
        els.btnZipQuickBrowserB.addEventListener('click', async () => {
          const built = await buildResultsZipBlob();
          if (!built) return;
          const zipBuf = await built.zipBlob.arrayBuffer();
          const zipBytes = new Uint8Array(zipBuf);
          const firstSrc = (state.lastProcessedResults[0] && state.lastProcessedResults[0].sourcePath) || '';

          if (hasNativeDesktopBridge() && typeof window.pywebview.api.save_batch_to_default_dir === 'function') {
            try {
              const ret = await window.pywebview.api.save_batch_to_default_dir([{
                sourcePath: firstSrc,
                originalName: `含 ${state.lastProcessedResults.length} 份盖章文件`,
                fileName: built.zipFileName,
                isZip: true,
                base64: uint8ToBase64(zipBytes)
              }]);
              if (ret && ret.ok && Array.isArray(ret.records) && ret.records[0]) {
                const rec = {
                  ...ret.records[0],
                  blob: built.zipBlob,
                  bytes: zipBytes,
                  revoked: false,
                  isZip: true
                };
                state.lastQuickSaveRecords = [rec];
                appendRecordsToPersistentHistory([rec], ret.history);
                renderQuickSaveReceiptView('quick');
                return;
              }
            } catch (e) {}
          }

          const downloadsDir = resolveConcreteDownloadsDir();
          const fullZipPath = `${downloadsDir}\${built.zipFileName}`;
          triggerDownloadBlob(built.zipBlob, built.zipFileName);
          const rec = {
            id: 'his_zip_' + Date.now(),
            fileName: built.zipFileName,
            originalName: `含 ${state.lastProcessedResults.length} 份盖章文件`,
            savedPath: fullZipPath,
            dirPath: downloadsDir,
            timestamp: new Date().toLocaleString('zh-CN', { hour12: false }),
            blob: built.zipBlob,
            bytes: zipBytes,
            status: 'saved',
            revoked: false,
            isZip: true
          };
          state.lastQuickSaveRecords = [rec];
          appendRecordsToPersistentHistory([rec]);
          renderQuickSaveReceiptView('quick');
        });
      }

      // 【打包压缩保存 - 右侧按钮：📂 自定义位置】
      if (els.btnZipCustomLocation) {
        els.btnZipCustomLocation.addEventListener('click', async () => {
          const built = await buildResultsZipBlob();
          if (!built) return;
          const zipBuf = await built.zipBlob.arrayBuffer();
          const zipBytes = new Uint8Array(zipBuf);
          const firstSrc = (state.lastProcessedResults[0] && state.lastProcessedResults[0].sourcePath) || '';

          if (hasNativeDesktopBridge() && typeof window.pywebview.api.save_single_dialog === 'function') {
            try {
              const ret = await window.pywebview.api.save_single_dialog(
                firstSrc,
                built.zipFileName,
                uint8ToBase64(zipBytes),
                `含 ${state.lastProcessedResults.length} 份盖章文件`,
                'ZIP打包'
              );
              if (ret && ret.ok) {
                const rec = ret.record || {
                  id: 'his_zip_' + Date.now(),
                  fileName: (ret.savedPath || built.zipFileName).split(/[\\/]/).pop(),
                  originalName: `含 ${state.lastProcessedResults.length} 份盖章文件`,
                  savedPath: (ret.savedPath || '').replace(/\//g, '\\'),
                  dirPath: (ret.savedPath || '').replace(/\//g, '\\').replace(/\\[^\\]+$/, ''),
                  timestamp: new Date().toLocaleString('zh-CN', { hour12: false }),
                  status: 'saved',
                  revoked: false,
                  isZip: true
                };
                rec.blob = built.zipBlob;
                rec.bytes = zipBytes;
                rec.revoked = false;
                state.lastQuickSaveRecords = [rec];
                appendRecordsToPersistentHistory([rec], ret.history);
                renderQuickSaveReceiptView('custom');
              }
              return;
            } catch (e) {}
          }

          if (typeof window.showSaveFilePicker === 'function') {
            try {
              const saveHandle = await window.showSaveFilePicker({
                suggestedName: built.zipFileName,
                types: [{ description: 'ZIP (.zip)', accept: { 'application/zip': ['.zip'] } }]
              });
              const writable = await saveHandle.createWritable();
              await writable.write(built.zipBlob);
              await writable.close();
              const actualName = saveHandle.name || built.zipFileName;
              const fullPath = buildConcreteCustomPath('', actualName, firstSrc);
              const dirPath = fullPath.replace(/\\[^\\]+$/, '');
              const rec = {
                id: 'his_zip_' + Date.now(),
                fileName: actualName,
                originalName: `含 ${state.lastProcessedResults.length} 份盖章文件`,
                savedPath: fullPath,
                dirPath: dirPath,
                timestamp: new Date().toLocaleString('zh-CN', { hour12: false }),
                savedFileHandle: saveHandle,
                blob: built.zipBlob,
                bytes: zipBytes,
                status: 'saved',
                revoked: false,
                isZip: true
              };
              state.lastQuickSaveRecords = [rec];
              appendRecordsToPersistentHistory([rec]);
              renderQuickSaveReceiptView('custom');
              return;
            } catch (err) {
              if (err && err.name === 'AbortError') return;
            }
          }

          const dlDir = resolveConcreteDownloadsDir();
          const fullZipPath = `${dlDir}\${built.zipFileName}`;
          triggerDownloadBlob(built.zipBlob, built.zipFileName);
          const rec = {
            id: 'his_zip_' + Date.now(),
            fileName: built.zipFileName,
            originalName: `含 ${state.lastProcessedResults.length} 份盖章文件`,
            savedPath: fullZipPath,
            dirPath: dlDir,
            timestamp: new Date().toLocaleString('zh-CN', { hour12: false }),
            blob: built.zipBlob,
            bytes: zipBytes,
            status: 'saved',
            revoked: false,
            isZip: true
          };
          state.lastQuickSaveRecords = [rec];
          appendRecordsToPersistentHistory([rec]);
          renderQuickSaveReceiptView('custom');
        });
      }

      // 存盘回执页按钮事件绑定
      if (els.btnReceiptUndoAll) {
        els.btnReceiptUndoAll.addEventListener('click', async () => {
          let count = 0;
          for (const rec of state.lastQuickSaveRecords) {
            if (!rec.revoked && rec.status !== 'revoked') {
              await revokeSingleSavedRecord(rec);
              count++;
            }
          }
          renderQuickSaveReceiptView();
          renderHistoryAndStorageModal();
          if (count > 0) {
            showToast(`↩️ 已一键全部撤回 ${count} 份文件！`, 'info');
          }
        });
      }
      if (els.btnReceiptBackToChoose) {
        els.btnReceiptBackToChoose.addEventListener('click', () => {
          openResultModal(state.lastRunMode || 'batch');
        });
      }
      if (els.btnConfirmReceiptClose) {
        els.btnConfirmReceiptClose.addEventListener('click', () => {
          closeModal();
          syncDefaultSaveDirUI();
          if (els.btnOpenHistoryDrawer) {
            els.btnOpenHistoryDrawer.classList.add('ring-4', 'ring-emerald-400', 'scale-105');
            setTimeout(() => {
              els.btnOpenHistoryDrawer.classList.remove('ring-4', 'ring-emerald-400', 'scale-105');
            }, 1400);
          }
          showToast('✅ 已存入左侧「📜 历史记录 & 存储位置」，随时可查看、直达、撤回或恢复！', 'success');
        });
      }

      // ==================== 初次进入全屏选择默认文件夹弹窗 & 左侧常驻「📜 历史记录 & 存储位置」事件绑定 ====================
      const closeFirstTimeModal = () => {
        if (els.firstTimeSaveDirModal) {
          els.firstTimeSaveDirModal.classList.add('hidden');
          els.firstTimeSaveDirModal.classList.remove('flex');
        }
      };

      if (els.btnFirstPickCustomDir) {
        els.btnFirstPickCustomDir.addEventListener('click', async () => {
          const ok = await applyDefaultSaveLocationChoice('pick_custom');
          if (ok) closeFirstTimeModal();
        });
      }
      if (els.btnFirstUsePluginExport) {
        els.btnFirstUsePluginExport.addEventListener('click', async () => {
          await applyDefaultSaveLocationChoice('plugin_export');
          closeFirstTimeModal();
        });
      }
      if (els.btnFirstUseSourceDir) {
        els.btnFirstUseSourceDir.addEventListener('click', async () => {
          await applyDefaultSaveLocationChoice('source_dir');
          closeFirstTimeModal();
        });
      }

      const openHistoryModal = async () => {
        if (hasNativeDesktopBridge() && typeof window.pywebview.api.get_save_history === 'function') {
          try {
            const latestHis = await window.pywebview.api.get_save_history();
            if (Array.isArray(latestHis)) {
              state.historyRecords = latestHis.map(h => ({ ...h, revoked: h.status === 'revoked' }));
            }
          } catch (e) {}
        }
        renderHistoryAndStorageModal();
        if (els.historyAndStorageModal) {
          els.historyAndStorageModal.classList.remove('hidden');
          els.historyAndStorageModal.classList.add('flex');
        }
      };

      const closeHistoryModal = () => {
        if (els.historyAndStorageModal) {
          els.historyAndStorageModal.classList.add('hidden');
          els.historyAndStorageModal.classList.remove('flex');
        }
      };

      if (els.btnOpenHistoryDrawer) {
        els.btnOpenHistoryDrawer.addEventListener('click', openHistoryModal);
      }
      if (els.btnQuickChangeDefaultInModal) {
        els.btnQuickChangeDefaultInModal.addEventListener('click', () => {
          closeModal();
          openHistoryModal();
        });
      }
      if (els.btnCloseHistoryModal) {
        els.btnCloseHistoryModal.addEventListener('click', closeHistoryModal);
      }
      if (els.btnCloseHistoryModalBottom) {
        els.btnCloseHistoryModalBottom.addEventListener('click', closeHistoryModal);
      }

      if (els.btnChangeDefaultDirCustom) {
        els.btnChangeDefaultDirCustom.addEventListener('click', () => applyDefaultSaveLocationChoice('pick_custom'));
      }
      if (els.btnChangeDefaultDirExport) {
        els.btnChangeDefaultDirExport.addEventListener('click', () => applyDefaultSaveLocationChoice('plugin_export'));
      }
      if (els.btnChangeDefaultDirSource) {
        els.btnChangeDefaultDirSource.addEventListener('click', () => applyDefaultSaveLocationChoice('source_dir'));
      }
      if (els.btnOpenDefaultDirInExplorer) {
        els.btnOpenDefaultDirInExplorer.addEventListener('click', async () => {
          const info = getDefaultSaveDirDisplayInfo();
          const targetDir = info.mode === 'source_dir'
            ? (state.defaultExportSubfolder || getAppLocalDirPath() || resolveConcreteDownloadsDir())
            : info.pathText;
          if (hasNativeDesktopBridge() && typeof window.pywebview.api.open_folder === 'function') {
            await window.pywebview.api.open_folder(targetDir);
          } else {
            showToast(`📂 默认保存目录：${targetDir}`, 'info');
          }
        });
      }

      if (els.btnHistoryRevokeAll) {
        els.btnHistoryRevokeAll.addEventListener('click', async () => {
          const activeList = (state.historyRecords || []).filter(r => !r.revoked && r.status !== 'revoked');
          if (activeList.length === 0) {
            showToast('💡 当前没有处于「已存妥」状态的文件可供撤回', 'info');
            return;
          }
          let count = 0;
          for (const rec of activeList) {
            const ok = await revokeSingleSavedRecord(rec);
            if (ok) count++;
          }
          renderHistoryAndStorageModal();
          renderQuickSaveReceiptView();
          if (count > 0) {
            showToast(`↩️ 已从磁盘批量撤回 ${count} 份历史保存文件！`, 'info');
          }
        });
      }

      if (els.btnHistoryClearAll) {
        els.btnHistoryClearAll.addEventListener('click', async () => {
          if ((state.historyRecords || []).length === 0) return;
          if (hasNativeDesktopBridge() && typeof window.pywebview.api.clear_all_history === 'function') {
            try { await window.pywebview.api.clear_all_history(); } catch (e) {}
          }
          state.historyRecords = [];
          saveHistoryToLocalCache();
          syncDefaultSaveDirUI();
          renderHistoryAndStorageModal();
          showToast('🗑️ 已清空全部历史记录（磁盘上已保存的文件均保留完好）', 'info');
        });
      }

      initMagneticBoxDrag();
    }

    // ==================== 启动器桌面桥接初始化（pywebviewready 自动静默绑定同级 4 大固定子文件夹） ====================
    let nativeBridgeInitialized = false;
    async function initFromNativeDesktopBridge() {
      if (nativeBridgeInitialized || !hasNativeDesktopBridge()) return;
      if (typeof window.pywebview.api.get_plugin_init_data !== 'function') return;
      nativeBridgeInitialized = true;

      try {
        const initData = await window.pywebview.api.get_plugin_init_data();
        if (!initData || !initData.ok) return;

        state.defaultExportSubfolder = initData.defaultExportSubfolder || '';
        state.systemDownloadsDir = initData.systemDownloadsDir || '';
        state.defaultSaveMode = initData.defaultSaveMode || 'plugin_export';
        state.defaultSaveDir = initData.defaultSaveDir || state.defaultExportSubfolder;

        // 1. 从「历史缓存/prefs_config.json」恢复保存的所有插件调教参数
        const savedPrefs = initData.prefs || {};
        if (Array.isArray(savedPrefs.profiles) && savedPrefs.profiles.length === 3) {
          savedPrefs.profiles.forEach((saved, idx) => {
            if (!saved || typeof saved !== 'object') return;
            const target = state.globalProfiles[idx];
            Object.keys(saved).forEach(k => {
              if (k === 'gridCells') {
                const cols = saved.gridCols || 3;
                const rows = saved.gridRows || 3;
                if (Array.isArray(saved.gridCells) && saved.gridCells.length === cols * rows) {
                  target.gridCells = saved.gridCells.map(v => Number(v) || 0);
                }
              } else if (saved[k] !== undefined) {
                target[k] = saved[k];
              }
            });
          });
        }
        if (typeof savedPrefs.customSuffix === 'string') {
          state.customSuffix = savedPrefs.customSuffix;
          els.customSuffixInput.value = savedPrefs.customSuffix;
        }
        if (typeof savedPrefs.noSuffix === 'boolean') {
          state.noSuffix = savedPrefs.noSuffix;
          if (els.noSuffixToggle) els.noSuffixToggle.checked = state.noSuffix;
        }
        if (typeof savedPrefs.defaultLockBurn === 'boolean') {
          state.defaultLockBurn = savedPrefs.defaultLockBurn;
        }
        if (typeof savedPrefs.wordLockMode === 'string') {
          state.wordLockMode = savedPrefs.wordLockMode;
        }
        syncDynamicZipFolderName();

        // 2. 自动静默载入同级「自定义图片」子文件夹
        if (Array.isArray(initData.images)) {
          const loadedImgs = [];
          for (const item of initData.images) {
            if (item && item.name && item.dataUrl) {
              const imgEl = new Image();
              imgEl.src = item.dataUrl;
              loadedImgs.push({ name: item.name, dataUrl: item.dataUrl, imgEl });
            }
          }
          state.subfolderImages = loadedImgs;
          saveSubfolderImagesCache();
        }

        // 3. 自动静默读取同级「自定义样式」子文件夹至载入列表（注：下方临时贴纸栏保持清爽，点「📂 载入样式」可随时点选套用）
        if (Array.isArray(initData.styles)) {
          state.folderStyleStickers = initData.styles.filter(st => st && st.name && isValidXixiStyleSnapshot(st.snapshot));
        }

        // 4. 自动载入同级「历史缓存/history.json」中的持久化历史记录
        if (Array.isArray(initData.history)) {
          state.historyRecords = initData.history.map(h => ({ ...h, revoked: h.status === 'revoked' }));
          saveHistoryToLocalCache();
        }

        // 5. 更新同级 5 大固定子文件夹绑定状态徽章
        if (els.subfolderBindBadge) {
          els.subfolderBindBadge.textContent = '✅ 已自动直连同级：系统资源 / 自定义样式 / 自定义图片 / 历史缓存';
          els.subfolderBindBadge.className = 'text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-300 font-bold';
        }

        // 6. 将内置 2 页大字版《西西盖章局_功能说明与演示样板.pdf》及内置图标同步写入同级「系统资源/」子文件夹
        if (typeof window.pywebview.api.ensure_system_resources === 'function') {
          setTimeout(async () => {
            try {
              const guideBuf = await buildBuiltInGuidePdfBuffer();
              const pdfB64 = uint8ToBase64(new Uint8Array(guideBuf));
              await window.pywebview.api.ensure_system_resources(pdfB64, MASCOT_SVG_SOURCE);
            } catch (err) {}
          }, 300);
        }

        renderStyleStickers();
        syncControlsFromActiveStyle();
        syncDefaultSaveDirUI();
        renderHistoryAndStorageModal();

        // 6. 若初次进入尚未设置默认保存目录，弹出全屏引导对话框
        if (initData.needsFirstTimeSetup) {
          if (els.firstTimeSaveDirModal) {
            els.firstTimeSaveDirModal.classList.remove('hidden');
            els.firstTimeSaveDirModal.classList.add('flex');
          }
        } else {
          state.firstRunCompleted = true;
        }
      } catch (e) {}
    }

    window.addEventListener('pywebviewready', () => {
      initFromNativeDesktopBridge();
    });

    window.addEventListener('DOMContentLoaded', () => {
      loadPrefsFromStorage();
      loadHistoryFromLocalCache();
      loadSubfolderImagesCache();
      renderStyleStickers();
      drawDemoBasePage();
      syncControlsFromActiveStyle();
      syncDefaultSaveDirUI();
      renderHistoryAndStorageModal();
      bindEvents();

      // 若 pywebview 已经就绪则立即拉取，否则等待 pywebviewready；若在普通浏览器初次打开也弹出默认位置设置引导
      setTimeout(() => {
        if (hasNativeDesktopBridge()) {
          initFromNativeDesktopBridge();
        } else if (!state.firstRunCompleted && els.firstTimeSaveDirModal) {
          els.firstTimeSaveDirModal.classList.remove('hidden');
          els.firstTimeSaveDirModal.classList.add('flex');
        }
      }, 180);

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => {
          renderWatermarkOverlay();
        });
      }
    });
  </script>
</body>
</html>