    ];

    function getActiveStyle() {
      if (state.editingFileId) {
        const f = state.files.find(item => item.id === state.editingFileId);
        if (f && f.useCustomStyle && f.customStyle) {
          return f.customStyle;
        }
      }
      return state.globalProfiles[state.activeProfileIndex] || state.globalProfiles[0];
    }

    function getStyleForFile(fileItem) {
      if (fileItem) {
        if (fileItem.useCustomStyle && fileItem.customStyle) {
          return fileItem.customStyle;
        }
        const pIdx = fileItem.profileIndex || 0;
        if (state.globalProfiles[pIdx]) return state.globalProfiles[pIdx];
      }
      return getActiveStyle();
    }

    function getStampImageForStyle(styleObj) {
      if (!styleObj.enableStamp) return null;
      const st = styleObj.stampType || 'paw';
      if (st === 'none') return null;
      if (st.startsWith('subimg:')) {
        const fname = st.slice(7);
        const found = state.subfolderImages.find(item => item.name === fname);
        if (found && found.imgEl) return found.imgEl;
      }
      if (st === 'custom') return styleObj.customStampImageEl || state.stampImageEl || getTintedBuiltinStamp('paw', styleObj.color);
      if (st === 'paw') return getTintedBuiltinStamp('paw', styleObj.color);
      return getTintedBuiltinStamp('paw', styleObj.color);
    }

    function isPageInStampRange(pageNum, totalPages, styleObj) {
      const mode = styleObj.pageRangeMode || 'all';
      if (mode === 'all') return true;
      if (mode === 'skipFirst') return totalPages > 1 ? pageNum >= 2 : true;
      if (mode === 'onlyFirst') return pageNum === 1;
      if (mode === 'odd') return pageNum % 2 === 1;
      if (mode === 'even') return pageNum % 2 === 0;
      if (mode === 'custom') {
        const raw = (styleObj.customPageRange || '').trim();
        if (!raw) return true;
        const parts = raw.split(/[,，;；\s]+/).filter(Boolean);
        for (const p of parts) {
          if (p.includes('-')) {
            const [s, e] = p.split('-').map(n => parseInt(n, 10));
            if (!isNaN(s) && !isNaN(e) && pageNum >= Math.min(s, e) && pageNum <= Math.max(s, e)) return true;
          } else {
            const n = parseInt(p, 10);
            if (!isNaN(n) && pageNum === n) return true;
          }
        }
        return false;
      }
      return true;
    }

