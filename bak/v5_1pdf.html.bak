<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>西西盖章局 V5 · 多款式平滑倒角与PDF批量水印工坊</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=ZCOOL+KuaiLe&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-cream: #FFFDF9;
      --bg-peach: #FFF3EE;
      --border-berry: #F9CBD6;
      --accent-rose: #F43F5E;
      --accent-pink: #FB7185;
      --accent-soft: #FFE4E8;
      --text-cocoa: #4A353B;
      --text-muted: #8C6F77;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
      background-color: var(--bg-cream);
      background-image:
        radial-gradient(#FBCFE8 1.35px, transparent 1.35px),
        radial-gradient(#FDE68A 1.35px, #FFFDF9 1.35px);
      background-size: 36px 36px;
      background-position: 0 0, 18px 18px;
      color: var(--text-cocoa);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      user-select: none;
    }

    input, select, textarea {
      user-select: text;
    }

    .washi-tape {
      position: relative;
    }
    .washi-tape::before {
      content: '';
      position: absolute;
      top: -9px;
      left: 50%;
      transform: translateX(-50%) rotate(-1.2deg);
      width: 104px;
      height: 18px;
      background: repeating-linear-gradient(
        45deg,
        rgba(251, 113, 133, 0.24),
        rgba(251, 113, 133, 0.24) 8px,
        rgba(255, 241, 242, 0.65) 8px,
        rgba(255, 241, 242, 0.65) 16px
      );
      border-left: 2px dashed rgba(244, 63, 94, 0.3);
      border-right: 2px dashed rgba(244, 63, 94, 0.3);
      border-radius: 3px;
      z-index: 5;
      pointer-events: none;
    }

    .kawaii-card {
      background: rgba(255, 255, 255, 0.96);
      border: 2.5px solid #FBCFE8;
      border-radius: 24px;
      box-shadow: 0 7px 0 #F9CBD6, 0 12px 24px rgba(244, 63, 94, 0.07);
    }

    .jelly-btn {
      transition: all 0.16s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 0 #E11D48, 0 6px 14px rgba(244, 63, 94, 0.25);
    }
    .jelly-btn:hover:not(:disabled) {
      transform: translateY(-1.5px);
      box-shadow: 0 5.5px 0 #E11D48, 0 10px 18px rgba(244, 63, 94, 0.3);
    }
    .jelly-btn:active:not(:disabled) {
      transform: translateY(2px) scale(0.98);
      box-shadow: 0 2px 0 #E11D48, 0 3px 8px rgba(244, 63, 94, 0.2);
    }
    .jelly-btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      box-shadow: 0 3px 0 #CBD5E1;
    }

    .jelly-btn-secondary {
      transition: all 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 3px 0 #F9A8D4;
    }
    .jelly-btn-secondary:hover:not(:disabled) {
      transform: translateY(-1.5px);
      box-shadow: 0 4.5px 0 #F472B6;
    }
    .jelly-btn-secondary:active:not(:disabled) {
      transform: translateY(1.5px);
      box-shadow: 0 1px 0 #F472B6;
    }

    input[type="range"].kawaii-slider {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 9px;
      background: #FFE4E8;
      border-radius: 999px;
      border: 1.5px solid #FBCFE8;
      outline: none;
    }
    input[type="range"].kawaii-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #FB7185;
      border: 3px solid #FFFFFF;
      box-shadow: 0 2px 6px rgba(244, 63, 94, 0.45);
      cursor: pointer;
      transition: transform 0.15s ease, background-color 0.15s ease;
    }
    input[type="range"].kawaii-slider::-webkit-slider-thumb:hover {
      transform: scale(1.15);
      background: #F43F5E;
    }

    .num-pill-input {
      width: 58px;
      text-align: right;
      background: transparent;
      outline: none;
      font-weight: 800;
      color: #BE123C;
      -moz-appearance: textfield;
      appearance: textfield;
    }
    .num-pill-input::-webkit-inner-spin-button,
    .num-pill-input::-webkit-outer-spin-button,
    .no-spin-input::-webkit-inner-spin-button,
    .no-spin-input::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    .no-spin-input {
      -moz-appearance: textfield;
      appearance: textfield;
    }

    /* V7 高辨识度可点击按钮：告别粉底顺色，采用纯白凸起立体底边 + 琥珀/靛蓝/玫红高对比撞色 */
    .click-chip {
      background: #FFFFFF;
      border: 1.5px solid #FDA4AF;
      border-bottom: 3px solid #FB7185;
      color: #881337;
      font-weight: 800;
      box-shadow: 0 2px 5px rgba(244, 63, 94, 0.08);
      transition: all 0.14s cubic-bezier(0.34, 1.56, 0.64, 1);
      cursor: pointer;
    }
    .click-chip:hover:not(:disabled) {
      transform: translateY(-1.5px);
      background: #FFFDF5;
      border-color: #F43F5E;
      border-bottom-color: #E11D48;
      color: #BE123C;
      box-shadow: 0 4px 10px rgba(244, 63, 94, 0.16);
    }
    .click-chip:active:not(:disabled) {
      transform: translateY(1px);
      border-bottom-width: 1.5px;
    }
    .click-chip-active {
      background: linear-gradient(135deg, #F43F5E 0%, #E11D48 100%) !important;
      border: 1.5px solid #BE123C !important;
      border-bottom: 3px solid #881337 !important;
      color: #FFFFFF !important;
      box-shadow: 0 4px 12px rgba(225, 29, 72, 0.32) !important;
    }
    .click-chip-indigo-active {
      background: linear-gradient(135deg, #4F46E5 0%, #4338CA 100%) !important;
      border: 1.5px solid #3730A3 !important;
      border-bottom: 3px solid #1E1B4B !important;
      color: #FFFFFF !important;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.32) !important;
    }
    .reset-pill-btn {
      background: #FFFBEB;
      border: 1.5px solid #FCD34D;
      border-bottom: 2.5px solid #F59E0B;
      color: #92400E;
      font-weight: 800;
      transition: all 0.14s ease;
      cursor: pointer;
    }
    .reset-pill-btn:hover {
      background: #FEF3C7;
      border-color: #F59E0B;
      border-bottom-color: #D97706;
      color: #78350F;
      transform: translateY(-1px);
    }
    .reset-pill-btn:active {
      transform: translateY(1px);
    }

    .zone-cell {
      transition: transform 0.08s ease, background-color 0.08s ease;
      touch-action: none;
    }
    .zone-cell.inactive {
      background: #FFFDF9;
      border-color: #FBCFE8;
      color: #C4A4AC;
    }

    ::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }
    ::-webkit-scrollbar-track {
      background: #FFF5F7;
      border-radius: 8px;
    }
    ::-webkit-scrollbar-thumb {
      background: #F9A8D4;
      border-radius: 8px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #FB7185;
    }
  </style>
</head>
<body class="min-h-screen pb-10">

  <!-- 外层布局：左侧独立大号「返回工具包」按钮（置于主框外部左侧，醒目好按） + 右侧双栏核心工作台 -->
  <div class="max-w-[1460px] mx-auto px-3 sm:px-5 pt-5 flex flex-col xl:flex-row items-start gap-4">

    <!-- 独立左翼：上方「⬅️ 返回工具包」+ 下方常驻「📜 历史记录 & 存储位置」 -->
    <aside class="w-full xl:w-auto xl:sticky xl:top-5 shrink-0 flex flex-row xl:flex-col items-stretch gap-3">
      <button
        id="btnBackToHub"
        type="button"
        class="jelly-btn px-4 py-3 xl:py-3.5 xl:px-4 rounded-2xl bg-gradient-to-br from-rose-500 via-pink-500 to-amber-500 text-white font-black text-sm sm:text-base flex xl:flex-col items-center justify-center gap-1.5 shadow-lg border-2 border-white ring-2 ring-rose-300 cursor-pointer hover:scale-[1.03] transition"
        title="返回西西工具包大厅选择其他插件"
      >
        <span class="text-xl sm:text-2xl leading-none">⬅️</span>
        <span class="tracking-wide whitespace-nowrap">返回工具包</span>
      </button>

      <button
        id="btnOpenHistoryDrawer"
        type="button"
        class="jelly-btn-secondary px-4 py-3 xl:py-3.5 xl:px-3.5 rounded-2xl bg-white hover:bg-rose-50 text-rose-950 font-black text-xs sm:text-sm flex xl:flex-col items-center justify-center gap-1.5 shadow-md border-2 border-rose-300 cursor-pointer hover:scale-[1.03] transition relative"
        title="查看历史保存记录（支持直达资源管理器、撤回、恢复、删去）并管理默认存储位置"
      >
        <span class="text-xl sm:text-2xl leading-none">📜</span>
        <span class="tracking-wide whitespace-nowrap font-extrabold text-rose-900">历史记录</span>
        <span class="text-[10px] text-rose-500 font-bold whitespace-nowrap">&amp; 存储位置</span>
        <span id="historyCountBadge" class="px-2 py-0.5 rounded-full bg-rose-500 text-white text-[10px] font-black shadow-2xs">
          0 条记录
        </span>
      </button>
    </aside>

    <main class="flex-1 min-w-0 w-full grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">

    <!-- 左栏：参数工作台 + 批量文件队列 (占7列) -->
    <div class="lg:col-span-7 flex flex-col gap-5">

      <!-- 模块1：印章工作台 -->
      <section class="kawaii-card washi-tape p-4 sm:p-5">

        <!-- 顶栏第1层：左【西西盖章局 + 方案①/②/③】 ⇄ 右【a. 全局重置（回到普通模式 + 经典铺满屏）】 -->
        <div id="editingScopeBanner" class="mb-2.5 flex items-center justify-between gap-2 flex-wrap">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="w-6 h-6 rounded-lg bg-rose-500 text-white font-black text-xs flex items-center justify-center shadow-sm">🐾</span>
            <h1 class="text-base sm:text-lg font-extrabold text-rose-950 mr-0.5">西西盖章局</h1>

            <span id="editingScopeIcon" class="hidden px-2 py-0.5 rounded-lg bg-purple-600 text-white text-xs font-extrabold">🎨 单件定制</span>
            <div id="globalProfileTabs" class="flex items-center gap-1 bg-rose-100/80 p-1 rounded-xl border border-rose-200">
              <button type="button" data-profile="0" class="profile-tab-btn px-2.5 py-1 rounded-lg text-xs font-extrabold click-chip click-chip-active">✔ 方案 ①</button>
              <button type="button" data-profile="1" class="profile-tab-btn px-2.5 py-1 rounded-lg text-xs font-extrabold click-chip">方案 ②</button>
              <button type="button" data-profile="2" class="profile-tab-btn px-2.5 py-1 rounded-lg text-xs font-extrabold click-chip">方案 ③</button>
            </div>
            <span id="editingScopeText" class="text-xs font-bold text-purple-800 hidden"></span>
            <button id="btnExitFileScope" type="button" class="hidden px-2 py-0.5 rounded-lg bg-purple-100 hover:bg-purple-200 text-purple-800 border border-purple-300 text-xs font-extrabold">
              ↩ 切回全局
            </button>
            <span id="activeTextStatusBadge" class="hidden sm:inline-block text-[11px] px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-300 font-bold">
              默认词
            </span>
          </div>

          <!-- 右侧：a. 超大号全局重置（占满「自定义文字」右侧整片区域，一键轻松点击） -->
          <button id="btnResetAll" type="button" class="reset-pill-btn flex-1 min-w-[140px] py-2 px-4 rounded-xl text-sm sm:text-base font-black flex items-center justify-center gap-1.5 shadow-sm cursor-pointer" title="一键回到普通模式，并将所有预设恢复为经典全屏铺满">
            <span>🔄 全局重置 (一键恢复初始)</span>
          </button>
        </div>

        <!-- 顶栏第2层：普通模式 ⇄ 高级模式（加大字号、加高按钮，直接拉满整条顶栏，一眼就能点！） -->
        <div class="mb-4 pb-3 border-b-2 border-dashed border-rose-100">
          <div class="w-full grid grid-cols-2 gap-2.5 p-1.5 rounded-2xl bg-slate-100/90 border-2 border-rose-200 shadow-inner">
            <button id="btnModeSimple" type="button" class="w-full py-2.5 px-4 rounded-xl text-sm sm:text-base font-black tracking-wide flex items-center justify-center gap-2 transition cursor-pointer click-chip click-chip-active">
              <span>🌸 普通模式</span>
              <span class="text-[11px] px-2 py-0.5 rounded-full bg-white/25 text-white font-extrabold">推荐快盖</span>
            </button>
            <button id="btnModeAdvanced" type="button" class="w-full py-2.5 px-4 rounded-xl text-sm sm:text-base font-black tracking-wide flex items-center justify-center gap-2 transition cursor-pointer click-chip">
              <span>🛠️ 高级模式</span>
              <span class="text-[11px] px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 font-extrabold">网格·倒角·精调</span>
            </button>
          </div>
        </div>

        <!-- 隐藏兼容节点 -->
        <input id="defaultWatermarkText" type="hidden" value="西西专属·严禁外传" />
        <input id="defaultSuffixKeyword" type="hidden" value="西西专属" />

        <!-- ==================== 核心输入区：文字水印 & 图案水印 左右并排（图案卡新增 小/中/大 快捷比例） ==================== -->
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 mb-4">

          <!-- 左卡：文字水印 -->
          <div id="textWatermarkCard" class="sm:col-span-6 p-3 rounded-2xl bg-rose-50/50 border-2 border-rose-200 transition flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-1 mb-2">
                <label class="inline-flex items-center gap-1.5 cursor-pointer">
                  <input id="enableTextToggle" type="checkbox" checked class="w-4 h-4 accent-rose-500 rounded cursor-pointer" />
                  <span class="text-xs font-extrabold text-rose-950">🏷️ 文字水印</span>
                </label>
                <div class="flex items-center gap-1.5">
                  <label class="inline-flex items-center gap-1 cursor-pointer text-[11px] text-rose-700 font-bold" title="镂空描边印章效果">
                    <input id="hollowTextToggle" type="checkbox" class="accent-rose-500 rounded" />
                    <span>镂空</span>
                  </label>
                  <button id="btnInsertDate" type="button" class="px-1.5 py-0.5 rounded bg-white hover:bg-rose-100 text-[10px] text-rose-600 border border-rose-200 font-bold" title="追加今日日期">+日期</button>
                  <button id="btnClearText" type="button" class="px-1.5 py-0.5 rounded bg-white hover:bg-rose-100 text-[10px] text-rose-500 border border-rose-200 font-bold" title="清空以使用默认词">清空</button>
                </div>
              </div>
              <input
                id="watermarkText"
                type="text"
                placeholder="默认：西西专属·严禁外传（加 / 可换行）"
                class="w-full px-3 py-2 rounded-xl border-2 border-rose-200 bg-white focus:border-rose-400 focus:outline-none text-xs sm:text-sm text-rose-950 placeholder:text-slate-400 font-semibold transition"
              />
            </div>
          </div>

          <!-- 右卡：图案水印（支持读取同级「自定义图片」子文件夹 + 自命名一键存入子文件夹） -->
          <div id="patternWatermarkCard" class="sm:col-span-6 p-3 rounded-2xl bg-amber-50/50 border-2 border-amber-200 transition flex flex-col justify-between gap-1.5">
            <div class="flex items-center justify-between gap-1 flex-wrap">
              <label class="inline-flex items-center gap-1.5 cursor-pointer">
                <input id="enableStampToggle" type="checkbox" class="w-4 h-4 accent-rose-500 rounded cursor-pointer" />
                <span class="text-xs font-extrabold text-rose-950">🐾 图案水印</span>
              </label>
              <div class="flex items-center gap-1 text-[11px] font-bold text-rose-700">
                <button type="button" data-stampscale="60" class="quick-stampscale click-chip px-2 py-0.5 rounded-md text-[10px]">小</button>
                <button type="button" data-stampscale="100" class="quick-stampscale click-chip px-2 py-0.5 rounded-md text-[10px]">中</button>
                <button type="button" data-stampscale="160" class="quick-stampscale click-chip px-2 py-0.5 rounded-md text-[10px]">大</button>
                <div class="flex items-center bg-white px-2 py-0.5 rounded-lg border-2 border-amber-300 ml-0.5" title="滚轮10%缩放或手敲输入">
                  <input id="stampScaleInput" type="number" min="20" max="300" step="1" value="100" class="no-spin-input w-11 text-right text-rose-800 font-extrabold focus:outline-none text-xs" />
                  <span class="text-[10px] text-rose-600 ml-0.5">%</span>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-12 gap-1.5 items-center relative">
              <div class="col-span-6">
                <select id="builtinStampSelect" class="w-full px-2 py-1.5 rounded-xl border-2 border-amber-200 bg-white text-xs font-bold text-rose-950 focus:border-rose-400 focus:outline-none cursor-pointer">
                  <option value="paw">🐾 默认猫爪章 (内置)</option>
                  <option value="custom">🖼️ 自定义贴纸图片</option>
                  <option value="none">🚫 不选图案</option>
                </select>
              </div>
              <div class="col-span-6 flex items-center gap-1 relative">
                <input id="stampImageInput" type="file" accept="image/*" class="sr-only" />
                <button id="btnUploadStampImg" type="button" class="w-full px-2.5 py-1.5 rounded-xl bg-white hover:bg-rose-100 border-2 border-rose-300 text-rose-800 text-xs font-extrabold truncate flex items-center justify-between gap-1 cursor-pointer shadow-2xs" title="展开单列菜单：上方自选位置，下方快速选择「自定义图片」子文件夹内容">
                  <span id="btnUploadStampImgLabel" class="truncate">📂 选自定义图片</span>
                  <span id="customImgMenuArrow" class="text-[10px] text-rose-500 shrink-0">▾</span>
                </button>
                <button id="btnClearStampImg" type="button" class="hidden px-2 py-1.5 rounded-xl bg-rose-200 text-rose-800 text-xs font-bold shrink-0" title="关闭图案印章">✕</button>
              </div>
            </div>

            <!-- 折叠式单列菜单：最上面是【💻 自选位置】，下面是【📁 子文件夹「自定义图片」】内的图片列表 -->
            <div id="customImgDropdownMenu" class="hidden mt-1.5 p-2 rounded-xl bg-white border-2 border-amber-300 shadow-lg space-y-1.5 z-30">
              <button id="btnPickCustomImgFromDisk" type="button" class="w-full px-3 py-2 rounded-lg bg-gradient-to-r from-rose-500 to-pink-500 hover:from-rose-600 hover:to-pink-600 text-white text-xs font-extrabold flex items-center justify-between shadow-2xs cursor-pointer transition">
                <span>💻 自选位置挑选图片...</span>
                <span class="text-[10px] opacity-90 font-normal">打开电脑文件管理器</span>
              </button>
              <div class="pt-1 border-t border-amber-100">
                <div class="flex items-center justify-between px-1 mb-1">
                  <span class="text-[10px] font-extrabold text-amber-900">📁 子文件夹「自定义图片」快速选择：</span>
                  <button id="btnScanCustomImgFolder" type="button" class="text-[10px] px-1.5 py-0.5 rounded bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 font-bold cursor-pointer" title="扫描或绑定同级「自定义图片」子文件夹">
                    🔄 刷新/读取子夹
                  </button>
                </div>
                <div id="customImgSubfolderList" class="max-h-40 overflow-y-auto flex flex-col gap-1 pr-0.5"></div>
              </div>
            </div>

            <!-- 当选择了自定义图片时展示：自命名 + 一键存入同级「自定义图片」子文件夹 -->
            <div id="customImgSubfolderBar" class="hidden pt-1.5 border-t border-amber-200/80 flex items-center justify-between gap-1.5">
              <input
                id="customImgSaveNameInput"
                type="text"
                placeholder="自命名贴纸图片..."
                class="flex-1 min-w-0 px-2 py-1 rounded-lg border border-amber-300 bg-white text-[11px] font-bold text-rose-950 focus:outline-none focus:border-rose-400"
              />
              <button
                id="btnSaveCustomImgToSubfolder"
                type="button"
                class="px-2 py-1 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-950 border border-amber-300 text-[11px] font-extrabold shrink-0 transition"
                title="将该贴纸图片按自命名直接保存到同级目录的「自定义图片」子文件夹内"
              >
                💾 存到「自定义图片」夹
              </button>
            </div>
          </div>
        </div>

        <!-- ==================== 普通模式专属：3 大推荐场景 + 页眉页尾专属距离微调滑块 ==================== -->
        <div id="simpleRecommendPanel" class="mb-4 p-3 rounded-2xl bg-gradient-to-r from-rose-50/90 via-pink-50/60 to-amber-50/60 border-2 border-rose-200/80">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-extrabold text-rose-950">⚡ 推荐预设：</span>
            <span id="simpleRecSubHint" class="text-[11px] text-rose-500 font-semibold">居中大章可在右图直接拖拽</span>
          </div>
          <div class="grid grid-cols-3 gap-2.5">
            <button type="button" data-rec="fullscreen" class="rec-card-btn click-chip click-chip-active py-2.5 px-3 rounded-xl text-center transition flex flex-col items-center justify-center gap-0.5">
              <span class="rec-title text-sm sm:text-base font-extrabold">✔ 🐾 全屏满铺</span>
              <span class="rec-sub text-[10px] opacity-90 font-medium">经典斜向铺满</span>
            </button>
            <button type="button" data-rec="centerbig" class="rec-card-btn click-chip py-2.5 px-3 rounded-xl text-center transition flex flex-col items-center justify-center gap-0.5">
              <span class="rec-title text-sm sm:text-base font-extrabold">🎯 正中央大章</span>
              <span class="rec-sub text-[10px] opacity-80 font-medium">独章·支持拖拽</span>
            </button>
            <button type="button" data-rec="headerfooter" class="rec-card-btn click-chip py-2.5 px-3 rounded-xl text-center transition flex flex-col items-center justify-center gap-0.5">
              <span class="rec-title text-sm sm:text-base font-extrabold">🎀 页眉页尾</span>
              <span class="rec-sub text-[10px] opacity-80 font-medium">上下封边留白</span>
            </button>
          </div>

          <!-- 当选中「🎀 页眉页尾」时在普通模式原地展开的【距离页头 / 距离页尾】快捷滑块 -->
          <div id="simpleHeaderFooterBar" class="hidden mt-3 pt-2.5 border-t border-rose-200/80 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div class="p-2.5 rounded-xl bg-white border border-rose-200">
              <div class="flex items-center justify-between text-xs font-bold text-rose-900 mb-1">
                <span>⬆️ 页眉覆盖高度 (距顶部)</span>
                <span id="hfTopValLabel" class="text-rose-600 font-extrabold">14%</span>
              </div>
              <input id="hfTopSlider" type="range" min="0" max="45" step="2" value="14" class="kawaii-slider" />
              <div class="flex justify-between text-[10px] text-rose-400 mt-1">
                <button type="button" data-hftop="0" class="quick-hftop hover:text-rose-600">不盖页眉(0%)</button>
                <button type="button" data-hftop="10" class="quick-hftop hover:text-rose-600">窄(10%)</button>
                <button type="button" data-hftop="16" class="quick-hftop hover:text-rose-600">标准(16%)</button>
                <button type="button" data-hftop="26" class="quick-hftop hover:text-rose-600">宽(26%)</button>
              </div>
            </div>
            <div class="p-2.5 rounded-xl bg-white border border-rose-200">
              <div class="flex items-center justify-between text-xs font-bold text-rose-900 mb-1">
                <span>⬇️ 页尾覆盖高度 (距底部)</span>
                <span id="hfBotValLabel" class="text-rose-600 font-extrabold">14%</span>
              </div>
              <input id="hfBotSlider" type="range" min="0" max="45" step="2" value="14" class="kawaii-slider" />
              <div class="flex justify-between text-[10px] text-rose-400 mt-1">
                <button type="button" data-hfbot="0" class="quick-hfbot hover:text-rose-600">不盖页尾(0%)</button>
                <button type="button" data-hfbot="10" class="quick-hfbot hover:text-rose-600">窄(10%)</button>
                <button type="button" data-hfbot="16" class="quick-hfbot hover:text-rose-600">标准(16%)</button>
                <button type="button" data-hfbot="26" class="quick-hfbot hover:text-rose-600">宽(26%)</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ==================== 基础外观与排版面板（右上角配有 b. 印章字体重置） ==================== -->
        <div class="p-3.5 rounded-2xl bg-rose-50/60 border border-rose-100">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-rose-200/70">
            <span class="text-xs font-extrabold text-rose-950">🎨 印章字体与参数</span>
            <button id="btnResetFontParams" type="button" class="reset-pill-btn px-2.5 py-1 rounded-xl text-[11px] flex items-center gap-1 ml-auto" title="只重置字体、颜色、字号、透明度、角度、间距与行距，不影响水印内容和网格区域">
              <span>↺ 印章字体重置</span>
            </button>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 mb-3 pb-3 border-b border-rose-200/60 items-center">
            <div class="sm:col-span-6">
              <label for="fontFamilySelect" class="block text-xs font-bold text-rose-900 mb-1">
                🔤 印章字体
              </label>
              <select
                id="fontFamilySelect"
                class="w-full px-3 py-1.5 rounded-xl border-2 border-rose-200 bg-white text-xs sm:text-sm text-rose-950 font-semibold focus:border-rose-400 focus:outline-none cursor-pointer"
              >
                <option value="'ZCOOL KuaiLe', 'YouYuan', 'PingFang SC', sans-serif">🍬 软萌手账圆体 (推荐)</option>
                <option value="'PingFang SC', 'Microsoft YaHei', 'Heiti SC', sans-serif">🖤 现代利落黑体 (清晰)</option>
                <option value="'Songti SC', 'SimSun', 'Noto Serif SC', serif">📜 复古书卷宋体 (正式)</option>
                <option value="'Kaiti SC', 'STKaiti', 'KaiTi', serif">🖌️ 潇洒手写楷体 (温婉)</option>
                <option value="'Courier New', 'Consolas', monospace">⌨️ 机密档案打字机 (酷感)</option>
              </select>
            </div>

            <div class="sm:col-span-6">
              <label class="block text-xs font-bold text-rose-900 mb-1">
                🎨 印泥颜色 <span id="colorLabelText" class="text-rose-500 font-normal text-[11px]">#F43F5E 草莓</span>
              </label>
              <div class="flex items-center gap-2 flex-wrap">
                <button type="button" data-color="#F43F5E" data-name="草莓" class="color-swatch w-6 h-6 rounded-full bg-[#F43F5E] border-2 border-white ring-2 ring-rose-500 shadow-sm transition transform hover:scale-110" title="草莓印泥"></button>
                <button type="button" data-color="#475569" data-name="深灰" class="color-swatch w-6 h-6 rounded-full bg-[#475569] border-2 border-white shadow-sm transition transform hover:scale-110" title="冷萃深灰"></button>
                <button type="button" data-color="#9333EA" data-name="芋泥" class="color-swatch w-6 h-6 rounded-full bg-[#9333EA] border-2 border-white shadow-sm transition transform hover:scale-110" title="芋泥波波"></button>
                <button type="button" data-color="#0D9488" data-name="薄荷" class="color-swatch w-6 h-6 rounded-full bg-[#0D9488] border-2 border-white shadow-sm transition transform hover:scale-110" title="薄荷苏打"></button>
                <button type="button" data-color="#D97706" data-name="焦糖" class="color-swatch w-6 h-6 rounded-full bg-[#D97706] border-2 border-white shadow-sm transition transform hover:scale-110" title="焦糖布丁"></button>
                <button type="button" data-color="#2563EB" data-name="海盐" class="color-swatch w-6 h-6 rounded-full bg-[#2563EB] border-2 border-white shadow-sm transition transform hover:scale-110" title="海盐蓝印"></button>
                <label class="relative px-2 py-0.5 rounded-full border-2 border-rose-300 bg-white flex items-center gap-1 cursor-pointer shadow-sm hover:scale-105 transition text-[11px] font-bold text-rose-800" title="自选任意颜色">
                  <span>🌈自选</span>
                  <input id="customColorInput" type="color" value="#F43F5E" class="sr-only" />
                </label>
              </div>
            </div>
          </div>

          <!-- 5 大核心滑块 + 错行开关（精简文案 + 立体可点快捷档） -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- 1. 印章字号 -->
            <div class="p-3 rounded-xl bg-white border border-rose-200/90 flex flex-col justify-center">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-bold text-rose-950">🔍 字号</span>
                <div class="flex items-center px-2 py-0.5 rounded-lg bg-rose-50 border border-rose-200">
                  <input id="fontSizeVal" type="number" min="8" max="160" step="1" value="28" class="num-pill-input text-xs" />
                  <span class="text-xs font-bold text-rose-700 ml-0.5">px</span>
                </div>
              </div>
              <input id="fontSizeSlider" type="range" min="10" max="120" step="2" value="28" class="kawaii-slider" />
              <div class="flex justify-between gap-1 text-[11px] mt-1.5">
                <button type="button" data-size="18" class="quick-size click-chip flex-1 py-0.5 rounded-md text-[10px]">小(18)</button>
                <button type="button" data-size="28" class="quick-size click-chip flex-1 py-0.5 rounded-md text-[10px]">中(28)</button>
                <button type="button" data-size="48" class="quick-size click-chip flex-1 py-0.5 rounded-md text-[10px]">大(48)</button>
                <button type="button" data-size="72" class="quick-size click-chip flex-1 py-0.5 rounded-md text-[10px]">特大(72)</button>
              </div>
            </div>

            <!-- 2. 透明度 -->
            <div class="p-3 rounded-xl bg-white border border-rose-200/90 flex flex-col justify-center">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-bold text-rose-950">💧 透明度</span>
                <div class="flex items-center px-2 py-0.5 rounded-lg bg-rose-50 border border-rose-200">
                  <input id="opacityVal" type="number" min="1" max="100" step="1" value="20" class="num-pill-input text-xs" />
                  <span class="text-xs font-bold text-rose-700 ml-0.5">%</span>
                </div>
              </div>
              <input id="opacitySlider" type="range" min="5" max="100" step="5" value="20" class="kawaii-slider" />
              <div class="flex justify-between gap-1 text-[11px] mt-1.5">
                <button type="button" data-opacity="15" class="quick-opacity click-chip flex-1 py-0.5 rounded-md text-[10px]">淡(15%)</button>
                <button type="button" data-opacity="25" class="quick-opacity click-chip flex-1 py-0.5 rounded-md text-[10px]">柔(25%)</button>
                <button type="button" data-opacity="50" class="quick-opacity click-chip flex-1 py-0.5 rounded-md text-[10px]">浓(50%)</button>
              </div>
            </div>

            <!-- 3. 旋转角度 -->
            <div class="p-3 rounded-xl bg-white border border-rose-200/90 flex flex-col justify-center">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-bold text-rose-950">📐 角度</span>
                <div class="flex items-center px-2 py-0.5 rounded-lg bg-rose-50 border border-rose-200">
                  <input id="angleVal" type="number" min="-180" max="180" step="1" value="-30" class="num-pill-input text-xs" />
                  <span class="text-xs font-bold text-rose-700 ml-0.5">°</span>
                </div>
              </div>
              <input id="angleSlider" type="range" min="-90" max="90" step="5" value="-30" class="kawaii-slider" />
              <div class="flex justify-between gap-1 text-[11px] mt-1.5">
                <button type="button" data-angle="-45" class="quick-angle click-chip flex-1 py-0.5 rounded-md text-[10px]">-45°</button>
                <button type="button" data-angle="-30" class="quick-angle click-chip flex-1 py-0.5 rounded-md text-[10px]">-30°</button>
                <button type="button" data-angle="0" class="quick-angle click-chip flex-1 py-0.5 rounded-md text-[10px]">0°</button>
                <button type="button" data-angle="30" class="quick-angle click-chip flex-1 py-0.5 rounded-md text-[10px]">+30°</button>
              </div>
            </div>

            <!-- 4. 印章间距 -->
            <div class="p-3 rounded-xl bg-white border border-rose-200/90 flex flex-col justify-center">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-bold text-rose-950">📏 间距</span>
                <div class="flex items-center px-2 py-0.5 rounded-lg bg-rose-50 border border-rose-200">
                  <input id="gapVal" type="number" min="30" max="500" step="1" value="150" class="num-pill-input text-xs" />
                  <span class="text-xs font-bold text-rose-700 ml-0.5">px</span>
                </div>
              </div>
              <input id="gapSlider" type="range" min="50" max="360" step="10" value="150" class="kawaii-slider" />
              <div class="flex justify-between gap-1 text-[11px] mt-1.5">
                <button type="button" data-gap="90" class="quick-gap click-chip flex-1 py-0.5 rounded-md text-[10px]">密(90)</button>
                <button type="button" data-gap="150" class="quick-gap click-chip flex-1 py-0.5 rounded-md text-[10px]">中(150)</button>
                <button type="button" data-gap="240" class="quick-gap click-chip flex-1 py-0.5 rounded-md text-[10px]">疏(240)</button>
              </div>
            </div>

            <!-- 5. 行距倍率 + 6. 错行交错开关 -->
            <div class="sm:col-span-2 p-3 rounded-xl bg-white border border-rose-200/90 grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
              <div class="sm:col-span-8">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-bold text-rose-950">↕️ 行距倍率</span>
                  <div class="flex items-center gap-1.5">
                    <button type="button" data-rowgap="70" class="quick-rowgap click-chip px-2 py-0.5 rounded-md text-[10px]">小(70%)</button>
                    <button type="button" data-rowgap="100" class="quick-rowgap click-chip px-2 py-0.5 rounded-md text-[10px]">中(100%)</button>
                    <button type="button" data-rowgap="140" class="quick-rowgap click-chip px-2 py-0.5 rounded-md text-[10px]">大(140%)</button>
                    <div class="flex items-center px-2 py-0.5 rounded-lg bg-rose-50 border border-rose-200">
                      <input id="rowGapScaleInput" type="number" min="40" max="250" step="1" value="100" class="num-pill-input text-xs" />
                      <span class="text-xs font-bold text-rose-700 ml-0.5">%</span>
                    </div>
                  </div>
                </div>
                <input id="rowGapScaleSlider" type="range" min="50" max="200" step="10" value="100" class="kawaii-slider" />
              </div>

              <div class="sm:col-span-4 flex flex-col justify-center sm:border-l border-rose-100 sm:pl-3">
                <label class="inline-flex items-center justify-between gap-2 cursor-pointer p-2 rounded-xl bg-rose-50/70 hover:bg-rose-100/60 border border-rose-200 transition">
                  <div>
                    <div class="text-xs font-extrabold text-rose-950">🧱 错行交错</div>
                    <div class="text-[10px] text-rose-500">关闭则横平竖直</div>
                  </div>
                  <input id="staggerRowToggle" type="checkbox" checked class="w-4 h-4 accent-rose-500 rounded cursor-pointer shrink-0" />
                </label>
              </div>
            </div>
          </div>

          <!-- 普通模式底部跳转条 -->
          <div id="simpleToAdvancedBar" class="mt-3 pt-2.5 border-t border-rose-200/60 flex items-center justify-between flex-wrap gap-2">
            <span class="text-[11px] text-rose-700 font-medium">
              💡 需要自定义贴纸槽、XY坐标位移、A4轴对称倒角网格或自选磁吸框？
            </span>
            <button id="btnFlipToAdvancedBottom" type="button" class="px-3 py-1 rounded-xl bg-white hover:bg-rose-100 text-rose-700 border border-rose-300 text-xs font-extrabold shadow-sm transition">
              🛠️ 切到高级模式精调 ➔
            </button>
          </div>
        </div>

        <!-- ==================== 高级模式专属面板（只放：1.自命名空贴纸槽+文件夹存取 2.XY偏移滑块+重置 3.A4轴对称倒角网格与磁吸区域） ==================== -->
        <div id="advancedFullPanel" class="hidden mt-4 space-y-4">

          <!-- 高级区1：自定义样式贴纸槽（直连同级目录的子文件夹「自定义样式」，不再盲目掉进浏览器下载） -->
          <div class="p-3.5 rounded-2xl bg-rose-50/70 border-2 border-rose-200/80 space-y-2.5">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs font-extrabold text-rose-950">📌 自定义样式槽</span>
                <span id="subfolderBindBadge" class="text-[10px] px-2 py-0.5 rounded-full bg-white text-rose-600 border border-rose-200 font-bold">
                  📂 目标：同级「自定义样式」与「自定义图片」子文件夹
                </span>
              </div>
              <div class="flex items-center gap-1.5 flex-wrap">
                <input
                  id="stickerNameInput"
                  type="text"
                  placeholder="起个样式名(可留空)..."
                  class="w-36 px-2.5 py-1 rounded-xl border border-rose-300 bg-white text-xs font-bold text-rose-950 placeholder:text-slate-400 focus:outline-none focus:border-rose-500"
                />
                <button id="btnSaveStyleSticker" type="button" class="px-2.5 py-1 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-300 text-[11px] font-extrabold cursor-pointer" title="仅在本次软件会话内临时暂存该样式（关闭软件后自动清空，不写入外部文件夹）">
                  ➕ 临时存样式(仅本次)
                </button>
                <button id="btnExportStickersFile" type="button" class="px-2.5 py-1 rounded-xl bg-white hover:bg-rose-100 text-rose-700 border border-rose-300 text-[11px] font-extrabold cursor-pointer" title="将当前样式永久存入同级「自定义样式」子文件夹中">
                  💾 存到「自定义样式」夹
                </button>
                <input id="stickerFileInput" type="file" accept=".json,application/json" class="sr-only" />
                <button id="btnImportStickersFile" type="button" class="px-2.5 py-1 rounded-xl bg-white hover:bg-rose-100 text-rose-800 border-2 border-rose-300 text-[11px] font-extrabold flex items-center gap-1 cursor-pointer shadow-2xs" title="展开单列菜单：仅支持读取本软件导出的专属样式格式 (.json)">
                  <span>📂 载入样式</span>
                  <span id="styleImportMenuArrow" class="text-[10px] text-rose-500">▾</span>
                </button>
              </div>
            </div>

            <!-- 折叠式单列菜单：最上面是【💻 自选位置】，下面是【📁 子文件夹「自定义样式」】内的样式单列列表 -->
            <div id="styleImportDropdownMenu" class="hidden p-2.5 rounded-xl bg-white border-2 border-rose-300 shadow-lg space-y-1.5 z-30">
              <div class="px-2.5 py-1.5 rounded-lg bg-amber-50 border border-amber-200 text-[11px] font-extrabold text-amber-900 flex items-center justify-between gap-2">
                <span>⚠️ 格式说明：仅支持读取本软件导出的专属样式格式 (.json)</span>
                <span class="text-[10px] text-amber-700 font-normal shrink-0">删去下方标签不影响文件夹原文件</span>
              </div>
              <button id="btnPickStyleFromDisk" type="button" class="w-full px-3 py-2 rounded-lg bg-gradient-to-r from-rose-500 to-pink-500 hover:from-rose-600 hover:to-pink-600 text-white text-xs font-extrabold flex items-center justify-between shadow-2xs cursor-pointer transition">
                <span>💻 自选位置导入本软件样式 (.json)...</span>
                <span class="text-[10px] opacity-90 font-normal">仅限本软件导出的样式文件</span>
              </button>
              <div class="pt-1 border-t border-rose-100">
                <div class="flex items-center justify-between px-1 mb-1">
                  <span class="text-[10px] font-extrabold text-rose-900">📁 子文件夹「自定义样式」快速选择（点一下立即载入套用）：</span>
                  <button id="btnScanStyleSubfolder" type="button" class="text-[10px] px-1.5 py-0.5 rounded bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold cursor-pointer" title="扫描同级「自定义样式」子文件夹">
                    🔄 刷新/读取子夹
                  </button>
                </div>
                <div id="styleImportSubfolderList" class="max-h-44 overflow-y-auto flex flex-col gap-1 pr-0.5"></div>
              </div>
            </div>

            <!-- 贴纸列表容器（初始清空，仅展示用户自存的样式） -->
            <div id="styleStickersBar" class="flex items-center gap-1.5 flex-wrap min-h-[28px]"></div>
          </div>

          <!-- 高级区2：水平 / 垂直位移微调（配齐整10px步进滑块 + 小中大快捷档 + 一键重置回初始） -->
          <div class="p-3.5 rounded-2xl bg-white border-2 border-rose-100 space-y-2.5">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-extrabold text-rose-950">🎛️ 位置偏移微调</span>
              </div>
              <button id="btnResetOffsets" type="button" class="reset-pill-btn px-2.5 py-1 rounded-xl text-[11px] flex items-center gap-1 ml-auto">
                <span>↺ 偏移重置</span>
              </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <!-- 水平位移 -->
              <div class="p-2.5 rounded-xl bg-rose-50/40 border border-rose-200/80">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-bold text-rose-950">↔️ 水平位移 (X)</span>
                  <div class="flex items-center px-2 py-0.5 rounded-lg bg-white border border-rose-200">
                    <input id="offsetXInput" type="number" min="-300" max="300" step="1" value="0" class="num-pill-input text-xs" />
                    <span class="text-xs font-bold text-rose-700 ml-0.5">px</span>
                  </div>
                </div>
                <input id="offsetXSlider" type="range" min="-240" max="240" step="10" value="0" class="kawaii-slider" />
                <div class="flex justify-between text-[10px] text-rose-400 mt-1 font-medium">
                  <button type="button" data-offx="-100" class="quick-offx hover:text-rose-600">左移(-100)</button>
                  <button type="button" data-offx="-40" class="quick-offx hover:text-rose-600">微左(-40)</button>
                  <button type="button" data-offx="0" class="quick-offx hover:text-rose-600 font-bold text-rose-600">居中(0)</button>
                  <button type="button" data-offx="40" class="quick-offx hover:text-rose-600">微右(+40)</button>
                  <button type="button" data-offx="100" class="quick-offx hover:text-rose-600">右移(+100)</button>
                </div>
              </div>

              <!-- 垂直位移 -->
              <div class="p-2.5 rounded-xl bg-rose-50/40 border border-rose-200/80">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-bold text-rose-950">↕️ 垂直位移 (Y)</span>
                  <div class="flex items-center px-2 py-0.5 rounded-lg bg-white border border-rose-200">
                    <input id="offsetYInput" type="number" min="-300" max="300" step="1" value="0" class="num-pill-input text-xs" />
                    <span class="text-xs font-bold text-rose-700 ml-0.5">px</span>
                  </div>
                </div>
                <input id="offsetYSlider" type="range" min="-240" max="240" step="10" value="0" class="kawaii-slider" />
                <div class="flex justify-between text-[10px] text-rose-400 mt-1 font-medium">
                  <button type="button" data-offy="-100" class="quick-offy hover:text-rose-600">上移(-100)</button>
                  <button type="button" data-offy="-40" class="quick-offy hover:text-rose-600">微上(-40)</button>
                  <button type="button" data-offy="0" class="quick-offy hover:text-rose-600 font-bold text-rose-600">居中(0)</button>
                  <button type="button" data-offy="40" class="quick-offy hover:text-rose-600">微下(+40)</button>
                  <button type="button" data-offy="100" class="quick-offy hover:text-rose-600">下移(+100)</button>
                </div>
              </div>
            </div>
          </div>

          <!-- 高级区3：网格与倒角区域（右上角配有 c. 网格调整重置，只在高级模式显示） -->
          <div class="p-4 rounded-2xl bg-gradient-to-br from-rose-50/80 to-pink-50/50 border-2 border-rose-200/80">
            <!-- 顶部模式切换 Tab + 右侧【c. 网格调整重置】 -->
            <div class="flex items-center justify-between flex-wrap gap-2 mb-3 pb-2.5 border-b border-rose-200/70">
              <div class="flex items-center gap-1.5 bg-white p-1 rounded-xl border border-rose-200">
                <button id="tabModeGrid" type="button" class="px-3 py-1.5 rounded-lg text-xs font-extrabold click-chip click-chip-active">
                  🐾 网格与倒角
                </button>
                <button id="tabModeBox" type="button" class="px-3 py-1.5 rounded-lg text-xs font-extrabold click-chip">
                  📏 自选磁吸框
                </button>
              </div>

              <div class="flex items-center gap-1.5 ml-auto flex-wrap">
                <label class="inline-flex items-center gap-1.5 text-xs font-bold text-rose-800 bg-white px-2.5 py-1 rounded-xl border border-rose-200 cursor-pointer" title="开启后每块连通区仅盖1枚独苗大章">
                  <input id="singlePerZoneToggle" type="checkbox" class="accent-rose-500 rounded cursor-pointer" />
                  <span>🎯 独章</span>
                </label>
                <button id="btnSnapSingleCenter" type="button" class="hidden px-2 py-1 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-300 text-[11px] font-extrabold transition">
                  📍 归位
                </button>
                <button id="btnResetGridParams" type="button" class="reset-pill-btn px-2.5 py-1 rounded-xl text-[11px] flex items-center gap-1" title="重置所有网格区域与倒角参数，回到最开始的 3×3 全屏状态">
                  <span>↺ 网格调整重置</span>
                </button>
              </div>
            </div>

            <!-- 子面板1：A4比例网格涂抹 + 极简 3 款倒角 + 整行铺平网格栏 -->
            <div id="panelGridMode">
              <div class="mb-3 p-3 rounded-2xl bg-amber-50/90 border border-amber-200 space-y-2.5">

                <!-- 第1行：直接把【🔢 网格】这一行拉满铺平！左侧预设网格，右侧自定义 x × y（输入框加宽至 w-14，2~3位数清晰完整显示） -->
                <div class="w-full flex items-center justify-between gap-2 bg-white px-3 py-2 rounded-xl border-2 border-amber-300 text-xs font-extrabold text-amber-950 flex-wrap shadow-2xs">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-rose-900">🔢 网格：</span>
                    <button type="button" data-gridkey="3x3" class="grid-size-btn px-2.5 py-1 rounded-lg click-chip click-chip-active text-xs">✔ 3×3</button>
                    <button type="button" data-gridkey="6x9" class="grid-size-btn px-2.5 py-1 rounded-lg click-chip text-xs">6×9</button>
                    <button type="button" data-gridkey="9x9" class="grid-size-btn px-2.5 py-1 rounded-lg click-chip text-xs">9×9</button>
                  </div>
                  <div class="flex items-center gap-1.5 ml-auto" title="上限 21×21（超出自动锁定为21），单填x或y自动按正方形生成">
                    <span class="text-xs font-extrabold text-rose-800">自定义(≤21)</span>
                    <input id="customGridXInput" type="number" min="2" max="21" placeholder="x" class="no-spin-input w-14 px-1.5 py-1 text-center rounded-lg border-2 border-rose-300 bg-rose-50/60 text-rose-950 font-black text-xs focus:outline-none focus:bg-white focus:border-rose-500" />
                    <span class="text-rose-500 font-black">×</span>
                    <input id="customGridYInput" type="number" min="2" max="21" placeholder="y" class="no-spin-input w-14 px-1.5 py-1 text-center rounded-lg border-2 border-rose-300 bg-rose-50/60 text-rose-950 font-black text-xs focus:outline-none focus:bg-white focus:border-rose-500" />
                    <button id="btnApplyCustomGrid" type="button" class="click-chip px-3 py-1 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-950 border-amber-400 text-xs font-extrabold">确定</button>
                  </div>
                </div>

                <!-- 第2行：边缘平滑开关 + 折叠按钮 + 各组独立开关 -->
                <div class="flex items-center justify-between flex-wrap gap-2">
                  <div class="flex items-center gap-2 flex-wrap">
                    <label class="inline-flex items-center gap-1.5 font-extrabold text-amber-950 text-xs cursor-pointer">
                      <input id="smartMergeBandToggle" type="checkbox" checked class="w-4 h-4 accent-rose-500 rounded cursor-pointer" />
                      <span>🌊 边缘平滑</span>
                    </label>
                    <button
                      id="btnToggleSmoothDrawer"
                      type="button"
                      class="click-chip px-2.5 py-1 rounded-xl text-xs flex items-center gap-1"
                    >
                      <span id="currentSmoothStyleBadge">🌙 b. 内凹倒角</span>
                      <span id="smoothDrawerArrow" class="text-[10px] text-rose-500">▴ 收起</span>
                    </button>
                  </div>

                  <div class="flex items-center gap-2 ml-auto text-[11px]">
                    <label class="inline-flex items-center gap-1 cursor-pointer text-rose-900 font-bold" title="开启后 A/B/C/D 各组可分别选不同倒角">
                      <input id="perGroupSmoothToggle" type="checkbox" checked class="accent-rose-500 rounded" />
                      <span>🔗 分组独立款式</span>
                    </label>
                    <button id="btnSyncSmoothToAllGroups" type="button" class="click-chip px-2 py-0.5 rounded-lg text-[10px]">
                      统配全组
                    </button>
                    <span id="smoothTargetGroupHint" class="hidden"></span>
                  </div>
                </div>

                <!-- 折叠式：极简 3 款倒角按钮（直接简化为 a.顶点直连 / b.内凹倒角 / c.内外双圆角，用醒目异色 + ✔ 标识选中） -->
                <div id="smoothStyleDrawer" class="p-2 rounded-xl bg-white/95 border-2 border-rose-200">
                  <div class="grid grid-cols-3 gap-2">
                    <button type="button" data-sstyle="slope" class="smooth-style-btn click-chip py-2 px-2.5 rounded-xl text-center transition flex items-center justify-center gap-1 text-xs sm:text-sm font-extrabold">
                      <span class="sstyle-check hidden">✔</span>
                      <span>📐 a. 顶点直连</span>
                    </button>

                    <button type="button" data-sstyle="concave" class="smooth-style-btn click-chip click-chip-indigo-active py-2 px-2.5 rounded-xl text-center transition flex items-center justify-center gap-1 text-xs sm:text-sm font-extrabold">
                      <span class="sstyle-check">✔</span>
                      <span>🌙 b. 内凹倒角</span>
                    </button>

                    <button type="button" data-sstyle="allround" class="smooth-style-btn click-chip py-2 px-2.5 rounded-xl text-center transition flex items-center justify-center gap-1 text-xs sm:text-sm font-extrabold">
                      <span class="sstyle-check hidden">✔</span>
                      <span>🫧 c. 内外双圆角</span>
                    </button>
                  </div>
                </div>

                <!-- 第3行：平滑角度（0°~180°，输入框加宽至 w-14 绝不截断 180） + 分组画笔栏 -->
                <div id="smoothConfigRow" class="pt-2 border-t border-amber-200/70 grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-center text-xs">
                  <div class="sm:col-span-6 bg-white px-3 py-2 rounded-xl border border-rose-200">
                    <div class="flex items-center justify-between gap-1 mb-1.5 flex-wrap">
                      <span class="font-extrabold text-rose-950">📐 平滑角度</span>
                      <div class="flex items-center gap-1">
                        <button type="button" data-smooth="45" class="quick-smooth click-chip px-1.5 py-0.5 rounded text-[10px]">45°</button>
                        <button type="button" data-smooth="90" class="quick-smooth click-chip px-1.5 py-0.5 rounded text-[10px]">90°</button>
                        <button type="button" data-smooth="135" class="quick-smooth click-chip px-1.5 py-0.5 rounded text-[10px]">135°</button>
                        <button type="button" data-smooth="180" class="quick-smooth click-chip px-1.5 py-0.5 rounded text-[10px]">180°</button>
                        <div class="flex items-center bg-rose-50 px-1.5 py-0.5 rounded-lg border border-rose-300">
                          <input id="smoothRadiusVal" type="number" min="0" max="180" step="1" value="90" class="no-spin-input w-12 text-right font-black text-rose-700 bg-transparent focus:outline-none text-xs" />
                          <span class="font-bold text-rose-600 ml-0.5">°</span>
                        </div>
                      </div>
                    </div>
                    <input id="smoothRadiusSlider" type="range" min="0" max="180" step="5" value="90" class="kawaii-slider" />
                  </div>

                  <!-- 动态分组画笔条 -->
                  <div id="groupBrushBar" class="sm:col-span-6 flex items-center gap-1.5 flex-wrap bg-white px-3 py-2.5 rounded-xl border border-rose-200">
                    <span class="font-bold text-rose-900 text-[11px] shrink-0">🖌️ 分组:</span>
                    <div id="dynamicGroupButtonsWrap" class="flex items-center gap-1 flex-wrap"></div>
                    <button id="btnAddSmoothGroup" type="button" class="click-chip px-2 py-0.5 rounded-lg bg-amber-50 text-amber-900 border-amber-300 text-[11px] font-extrabold" title="新增平滑分组">
                      ➕ 新增组
                    </button>
                  </div>
                </div>
              </div>

              <!-- A4 比例网格交互区：左【A4比例涂抹网格】 + 右【精简为 全屏/主对角/副对角/X型】 -->
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center">
                <div class="sm:col-span-5 flex flex-col items-center">
                  <!-- A4 比例 (1 : 1.414) 涂抹网格容器 -->
                  <div id="zoneGrid" class="grid grid-cols-3 gap-1.5 w-44 aspect-[1/1.414] p-2 bg-white rounded-2xl border-2 border-rose-200 shadow-inner select-none">
                    <!-- JS 动态渲染 3x3 / 3x4 / 5x7 / 7x10 -->
                  </div>
                  <span class="text-[10px] text-rose-400 mt-1 font-medium">📏 A4 等比例网格 · 按住鼠标连续涂抹</span>
                </div>

                <div class="sm:col-span-7 flex flex-col justify-between gap-2.5">
                  <div class="p-3 rounded-2xl bg-white/90 border border-rose-200 space-y-2.5">
                    <div class="text-xs font-extrabold text-rose-900 flex items-center justify-between">
                      <span>⚡ 快捷选区</span>
                      <div class="flex items-center gap-1.5">
                        <button id="btnInvertZones" type="button" class="click-chip px-2.5 py-0.5 rounded-lg text-[11px]">反选</button>
                        <button id="btnClearZones" type="button" class="click-chip px-2.5 py-0.5 rounded-lg text-[11px]">清空</button>
                      </div>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                      <button type="button" data-preset="all" class="zone-preset-btn click-chip py-2 px-2 rounded-xl text-xs font-extrabold">🐾 全屏</button>
                      <button type="button" data-preset="diagonal" class="zone-preset-btn click-chip py-2 px-2 rounded-xl text-xs font-extrabold">↘ 主对角</button>
                      <button type="button" data-preset="antidiag" class="zone-preset-btn click-chip py-2 px-2 rounded-xl text-xs font-extrabold">↙ 副对角</button>
                      <button type="button" data-preset="xshape" class="zone-preset-btn click-chip py-2 px-2 rounded-xl text-xs font-extrabold">✕ X型</button>
                    </div>
                  </div>

                  <div class="p-3 rounded-xl bg-rose-50/60 border border-rose-200/70 text-[11px] text-rose-800 leading-relaxed">
                    <div id="zoneSummaryText" class="font-extrabold text-rose-700 mb-0.5">
                      ✨ 已点亮 9 / 9 格 · 🌙 b. 内凹倒角 (90°)
                    </div>
                    <div class="text-rose-600">
                      💡 开启「🎯 独章」后点选格子自动居中，随后可在右图直接拖拽微调。
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- 子面板2：自选磁吸区域（合并抬头、尾部、上下页眉页尾、四周包边） -->
            <div id="panelBoxMode" class="hidden">
              <div class="p-3 rounded-xl bg-white border border-rose-200">
                <div class="flex items-center justify-between flex-wrap gap-2 mb-2.5">
                  <div class="flex items-center gap-2">
                    <button id="btnBoxInside" type="button" class="px-2.5 py-1 rounded-lg text-xs font-extrabold bg-rose-500 text-white">
                      🎯 框内盖章 (仅盖选中框内)
                    </button>
                    <button id="btnBoxOutside" type="button" class="px-2.5 py-1 rounded-lg text-xs font-extrabold bg-rose-50 text-rose-800 border border-rose-200">
                      🛡️ 框内留白保护 (只盖框外四周/页眉页尾)
                    </button>
                  </div>
                  <div class="flex items-center gap-2 text-xs font-bold text-rose-800">
                    <label class="inline-flex items-center gap-1 cursor-pointer">
                      <input id="snapGridToggle" type="checkbox" class="accent-rose-500 rounded" />
                      <span>🧲 5%步进吸附</span>
                    </label>
                    <label class="inline-flex items-center gap-1 cursor-pointer">
                      <input id="symLockToggle" type="checkbox" class="accent-rose-500 rounded" />
                      <span>🔒 对称锁</span>
                    </label>
                  </div>
                </div>

                <!-- 合并后的磁吸快捷区域预设（含抬头、尾部、上下页眉页尾、四周包边、正文框） -->
                <div class="flex items-center gap-1.5 flex-wrap mb-3 p-2 rounded-xl bg-rose-50/60 border border-rose-100 text-[11px]">
                  <span class="font-extrabold text-rose-800">⚡ 快捷磁吸区域：</span>
                  <button type="button" data-box="0,86,0,0,0" class="quick-box-btn px-2 py-1 rounded-lg bg-white hover:bg-rose-100 text-rose-800 border border-rose-200 font-bold">⬆️ 仅抬头页眉</button>
                  <button type="button" data-box="86,0,0,0,0" class="quick-box-btn px-2 py-1 rounded-lg bg-white hover:bg-rose-100 text-rose-800 border border-rose-200 font-bold">⬇️ 仅尾部页脚</button>
                  <button type="button" data-box="14,14,0,0,1" class="quick-box-btn px-2 py-1 rounded-lg bg-white hover:bg-rose-100 text-rose-800 border border-rose-200 font-bold">🎀 上下页眉页尾</button>
                  <button type="button" data-box="14,14,10,10,1" class="quick-box-btn px-2 py-1 rounded-lg bg-white hover:bg-rose-100 text-rose-800 border border-rose-200 font-bold">🖼️ 四周包边(留白正文)</button>
                  <button type="button" data-box="15,15,10,10,0" class="quick-box-btn px-2 py-1 rounded-lg bg-white hover:bg-rose-100 text-rose-800 border border-rose-200 font-bold">📄 标准内框</button>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                  <div class="p-2 rounded-xl bg-rose-50/70 border border-rose-200 flex items-center justify-between">
                    <span class="text-xs font-bold text-rose-900">⬆️ 上距</span>
                    <div class="flex items-center">
                      <input id="boxTopInput" type="number" min="0" max="90" value="15" class="w-11 text-right bg-white px-1 py-0.5 rounded border border-rose-200 text-xs font-extrabold text-rose-700" />
                      <span class="text-xs font-bold text-rose-700 ml-0.5">%</span>
                    </div>
                  </div>
                  <div class="p-2 rounded-xl bg-rose-50/70 border border-rose-200 flex items-center justify-between">
                    <span class="text-xs font-bold text-rose-900">⬇️ 下距</span>
                    <div class="flex items-center">
                      <input id="boxBottomInput" type="number" min="0" max="90" value="15" class="w-11 text-right bg-white px-1 py-0.5 rounded border border-rose-200 text-xs font-extrabold text-rose-700" />
                      <span class="text-xs font-bold text-rose-700 ml-0.5">%</span>
                    </div>
                  </div>
                  <div class="p-2 rounded-xl bg-rose-50/70 border border-rose-200 flex items-center justify-between">
                    <span class="text-xs font-bold text-rose-900">⬅️ 左距</span>
                    <div class="flex items-center">
                      <input id="boxLeftInput" type="number" min="0" max="90" value="10" class="w-11 text-right bg-white px-1 py-0.5 rounded border border-rose-200 text-xs font-extrabold text-rose-700" />
                      <span class="text-xs font-bold text-rose-700 ml-0.5">%</span>
                    </div>
                  </div>
                  <div class="p-2 rounded-xl bg-rose-50/70 border border-rose-200 flex items-center justify-between">
                    <span class="text-xs font-bold text-rose-900">➡️ 右距</span>
                    <div class="flex items-center">
                      <input id="boxRightInput" type="number" min="0" max="90" value="10" class="w-11 text-right bg-white px-1 py-0.5 rounded border border-rose-200 text-xs font-extrabold text-rose-700" />
                      <span class="text-xs font-bold text-rose-700 ml-0.5">%</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- 多页 PDF 盖章页码范围控制 -->
            <div class="mt-3 pt-2.5 border-t border-rose-200/70 flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs font-extrabold text-rose-900">📑 盖章页码范围：</span>
                <select id="pageRangeModeSelect" class="px-2.5 py-1 rounded-xl border border-rose-200 bg-white text-xs font-bold text-rose-900 focus:outline-none cursor-pointer">
                  <option value="all">📄 全部页面都盖章</option>
                  <option value="skipFirst">🛡️ 跳过首页封面 (第2页起盖)</option>
                  <option value="onlyFirst">🎯 仅盖第1页 (首页签章)</option>
                  <option value="odd">🔢 仅奇数页 (1, 3, 5...)</option>
                  <option value="even">🔢 仅偶数页 (2, 4, 6...)</option>
                  <option value="custom">✏️ 自定义页码段</option>
                </select>
                <input id="customPageRangeInput" type="text" placeholder="例: 2-5, 8, 10-12" class="hidden w-36 px-2.5 py-1 rounded-xl border border-rose-300 bg-white text-xs font-bold text-rose-950 focus:outline-none" />
              </div>
              <span class="text-[11px] text-rose-500 font-medium">✨ 自动记忆配置</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 模块2：批量文件上传队列 + 方案①②③分流 + 导出 -->
      <section class="kawaii-card washi-tape p-4 sm:p-5">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-3 pb-2.5 border-b-2 border-dashed border-rose-100">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-rose-500 text-white font-black text-xs flex items-center justify-center shadow-sm">2</span>
            <h2 class="text-base font-extrabold text-rose-950">批量文件队列 & 导出设置</h2>
          </div>
          <span id="fileCountBadge" class="text-xs px-3 py-0.5 rounded-full bg-rose-100 text-rose-800 border border-rose-300 font-bold">
            📂 已装填 0 / 20 个文件
          </span>
        </div>

        <!-- 拖拽上传框 -->
        <div
          id="dropZone"
          class="relative rounded-2xl border-[2.5px] border-dashed border-rose-300 bg-rose-50/50 hover:bg-rose-100/50 transition p-4 text-center cursor-pointer group mb-3.5"
        >
          <input id="pdfFileInput" type="file" accept="application/pdf,.pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,.docx" multiple class="sr-only" />
          <div class="flex flex-col items-center justify-center gap-1">
            <div class="text-sm font-extrabold text-rose-950 flex items-center gap-1.5">
              <span>📥 点击挑文件，或把 <span class="text-rose-500 underline">1 ~ 20 个 PDF / Word(.docx)</span> 拖进碗里</span>
            </div>
            <p id="sourceDirBindHint" class="text-[11px] text-rose-700/75">
              不传文件也可直接点下方「批量盖章保存」，直接把右侧 2 页大字版《功能说明与演示样板》（位于同级「系统资源」夹）盖章导出！
            </p>
            <button id="btnImportSourceDir" type="button" class="hidden"></button>
          </div>
        </div>

        <!-- 文件队列列表 -->
        <div id="fileQueueContainer" class="mb-3.5">
          <div class="flex items-center justify-between flex-wrap gap-2 mb-1.5">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-xs font-bold text-rose-900">📋 待盖章队列：</span>
              <button id="btnToggleAllLock" type="button" class="px-2 py-0.5 rounded-lg text-[11px] font-extrabold border transition cursor-pointer bg-rose-500 text-white border-rose-600 shadow-2xs flex items-center gap-1" title="一键全锁 / 全解锁：开启后PDF执行强力像素烧录+权限加密锁，Word执行防删锁定">
                <span>🔒 烧录加密(全锁)</span>
              </button>
              <select id="wordLockModeSelect" class="px-2 py-0.5 rounded-lg text-[11px] font-bold border border-indigo-200 bg-indigo-50 text-indigo-900 focus:outline-none cursor-pointer" title="选择Word文档加锁时的保护方案">
                <option value="sdt">📘 Word锁：仅锁水印(正文可改)</option>
                <option value="readonly">🔐 Word锁：全文只读保护锁</option>
                <option value="pdf">🔥 Word转PDF：烧录加密导出</option>
              </select>
            </div>
            <div class="flex items-center gap-1.5">
              <div id="batchAssignBar" class="hidden items-center gap-1 text-[11px] bg-rose-50 px-2 py-0.5 rounded-lg border border-rose-200">
                <span class="text-rose-700 font-bold">全员套用:</span>
                <button type="button" data-batch-profile="0" class="batch-profile-btn px-1.5 py-0.5 rounded bg-white hover:bg-rose-100 text-rose-800 font-bold border border-rose-200">方案①</button>
                <button type="button" data-batch-profile="1" class="batch-profile-btn px-1.5 py-0.5 rounded bg-white hover:bg-rose-100 text-rose-800 font-bold border border-rose-200">方案②</button>
                <button type="button" data-batch-profile="2" class="batch-profile-btn px-1.5 py-0.5 rounded bg-white hover:bg-rose-100 text-rose-800 font-bold border border-rose-200">方案③</button>
              </div>
              <button id="btnClearQueue" type="button" class="text-xs text-rose-500 hover:text-rose-700 font-semibold hidden">🗑️ 清空全部</button>
            </div>
          </div>
          <div id="fileQueueList" class="max-h-56 overflow-y-auto space-y-2 pr-1"></div>
        </div>

        <!-- 精简后缀与实时输出预览 -->
        <div class="p-3 rounded-2xl bg-rose-50/70 border border-rose-200/80 mb-3.5">
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-center">
            <div class="sm:col-span-6">
              <div class="flex items-center justify-between gap-1.5 mb-1 flex-wrap">
                <label for="customSuffixInput" class="text-xs font-extrabold text-rose-950">
                  🏷️ 导出文件名后缀 <span id="suffixHintText" class="text-[10px] text-rose-400 font-normal">(留空用默认)</span>
                </label>
                <label class="inline-flex items-center gap-1 cursor-pointer px-2 py-0.5 rounded-lg bg-white hover:bg-rose-100 border border-rose-300 text-[11px] font-extrabold text-rose-800 transition shadow-2xs" title="勾选后导出文件不追加任何后缀，直接保持原文件名">
                  <input id="noSuffixToggle" type="checkbox" class="accent-rose-500 rounded cursor-pointer" />
                  <span>🚫 无后缀</span>
                </label>
              </div>
              <input
                id="customSuffixInput"
                type="text"
                placeholder="默认：-西西专属水印版"
                class="w-full px-3 py-1.5 rounded-xl border-2 border-rose-200 bg-white focus:border-rose-400 focus:outline-none text-xs text-rose-950 placeholder:text-slate-400 font-semibold transition"
              />
            </div>
            <div class="sm:col-span-6">
              <div class="p-2 rounded-xl bg-white/90 border border-rose-200 flex flex-col justify-center">
                <div class="text-[10px] font-bold text-rose-500 flex items-center justify-between">
                  <span>📄 输出预览</span>
                  <span id="outputRangeTag" class="px-1.5 py-0.2 rounded bg-emerald-50 text-emerald-700 text-[10px] font-bold">全部页面</span>
                </div>
                <div id="suffixPreviewPill" class="text-xs font-extrabold text-rose-900 truncate font-mono mt-0.5">
                  示例：合同.pdf ➔ 合同-西西专属水印版.pdf
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 一键批量保存与打包压缩区（页面不再冗杂展示文件夹选择，点击按钮后在弹窗内提供快速保存A/B与自定义位置） -->
        <div class="p-3.5 rounded-2xl bg-gradient-to-r from-rose-100/80 via-pink-50 to-amber-50/80 border-2 border-rose-300">
          <!-- 隐藏保留兼容节点 -->
          <button id="btnPickFolder" type="button" class="hidden"></button>
          <div id="selectedFolderText" class="hidden"></div>

          <!-- 进度条 -->
          <div id="batchProgressWrap" class="hidden mb-3 bg-white/90 p-2.5 rounded-xl border border-rose-200">
            <div class="flex justify-between text-xs font-bold text-rose-800 mb-1">
              <span id="batchProgressStatus">正在卖力盖章中...</span>
              <span id="batchProgressPercent">0%</span>
            </div>
            <div class="w-full h-2 bg-rose-100 rounded-full overflow-hidden">
              <div id="batchProgressBar" class="h-full bg-gradient-to-r from-rose-400 to-pink-500 transition-all duration-200" style="width: 0%"></div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-center">
            <button
              id="btnProcessBatch"
              type="button"
              class="sm:col-span-6 jelly-btn py-2.5 px-4 rounded-2xl bg-gradient-to-r from-rose-500 to-pink-500 text-white font-extrabold text-sm flex items-center justify-center gap-1.5"
            >
              <span>🐾 批量盖章保存</span>
            </button>
            <div class="sm:col-span-6 flex items-center gap-1.5">
              <button
                id="btnProcessZip"
                type="button"
                class="flex-1 jelly-btn-secondary py-2.5 px-3 rounded-2xl bg-white hover:bg-amber-50 text-rose-900 border-2 border-rose-300 font-extrabold text-xs sm:text-sm flex items-center justify-center gap-1"
              >
                <span>🎁 打包压缩保存 (ZIP)</span>
              </button>
              <input
                id="virtualFolderName"
                type="text"
                value="功能说明等2页水印压缩包"
                title="默认按『首个文件前4个字+等x个水印压缩包』自动起名，也可手动修改"
                class="w-40 sm:w-48 px-2.5 py-2 rounded-xl border border-rose-300 bg-white text-[11px] font-bold text-rose-950 focus:outline-none shrink-0"
              />
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- 右栏：实时水印预览窗（默认内置 3 页《上手说明书 & 样板 PDF》，合并说明与测试PDF） -->
    <div class="lg:col-span-5 lg:sticky lg:top-4">
      <section class="kawaii-card washi-tape p-4 sm:p-5 flex flex-col">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-2.5 pb-2 border-b-2 border-dashed border-rose-100">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-amber-400 text-amber-950 font-black text-xs flex items-center justify-center shadow-sm">👀</span>
            <div>
              <h2 class="text-sm sm:text-base font-extrabold text-rose-950 leading-tight">实时预览 & 大字版功能说明书</h2>
              <p id="previewSourceLabel" class="text-[11px] text-rose-600 font-medium">
                当前底图：系统资源/预设说明书样板 (第 1 / 2 页 · 可翻页)
              </p>
            </div>
          </div>

          <div class="flex items-center gap-1.5">
            <select
              id="demoTemplateSelect"
              class="px-2 py-1 rounded-xl border border-rose-200 bg-rose-50 text-xs font-bold text-rose-900 focus:outline-none cursor-pointer"
              title="直接切换内置大字版说明书样板页（存于同级『系统资源』夹）"
            >
              <option value="1">📖 P1: 快速盖章与加密说明</option>
              <option value="2">🛠️ P2: 高级网格·子夹与历史说明</option>
            </select>
            <button
              id="btnHoldOriginal"
              type="button"
              class="px-2.5 py-1 rounded-xl bg-amber-100 hover:bg-amber-200 active:bg-amber-300 text-amber-900 border border-amber-300 text-xs font-bold transition"
            >
              👁️ 按住看原图
            </button>
          </div>
        </div>

        <!-- 预览画布外框 -->
        <div class="relative w-full bg-rose-100/60 rounded-2xl p-3 border-2 border-rose-200 flex flex-col items-center justify-center overflow-hidden">
          <div class="w-full flex items-center justify-between text-[11px] text-rose-700 font-semibold mb-2 px-1">
            <label class="inline-flex items-center gap-1.5 cursor-pointer">
              <input id="showGridLinesToggle" type="checkbox" checked class="accent-rose-500 rounded cursor-pointer" />
              <span>显示平滑包络线 / 导轨</span>
            </label>
            <div id="pdfPageControls" class="flex items-center gap-1 bg-white px-2 py-0.5 rounded-lg border border-rose-200">
              <button id="btnPrevPage" type="button" class="hover:text-rose-500 font-bold px-1">◀</button>
              <input id="pageJumpInput" type="number" min="1" value="1" class="w-9 text-center bg-rose-50 rounded border border-rose-200 text-[11px] font-extrabold text-rose-800 focus:outline-none" />
              <span id="pageIndicator" class="text-[11px] font-bold">/ 2 页</span>
              <button id="btnNextPage" type="button" class="hover:text-rose-500 font-bold px-1">▶</button>
            </div>
          </div>

          <!-- A4 比例双层画布容器 -->
          <div id="previewStageWrap" class="relative w-full max-w-[420px] aspect-[1/1.414] bg-white rounded-xl shadow-lg border border-rose-200 overflow-hidden">
            <canvas id="basePageCanvas" width="595" height="842" class="w-full h-full block"></canvas>
            <canvas id="watermarkOverlayCanvas" width="595" height="842" class="w-full h-full block absolute inset-0"></canvas>
          </div>

          <!-- 预览窗底部实时参数摘要条 -->
          <div class="w-full mt-2.5 px-3 py-1.5 rounded-xl bg-white/90 border border-rose-200 flex items-center justify-between text-[11px] text-rose-900 font-medium flex-wrap gap-2">
            <span id="liveSummaryLeft">印章：「西西专属·严禁外传」</span>
            <span id="liveSummaryRight" class="text-rose-500 font-bold">28px · 20%透明 · -30°</span>
          </div>
        </div>
      </section>
    </div>
    </main>
  </div>

  <!-- 盖章完成 · 分场景保存位置选择弹窗 -->
  <div id="resultModal" class="fixed inset-0 bg-rose-950/40 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
    <div class="kawaii-card max-w-xl w-full p-5 sm:p-6 bg-white relative">
      <div class="flex items-center justify-between pb-3 border-b-2 border-dashed border-rose-100 mb-3.5">
        <div class="flex items-center gap-2.5">
          <span class="text-2xl">🎉</span>
          <div>
            <h3 id="resultModalTitle" class="text-base font-extrabold text-rose-950">盖章完成啦！请选择保存位置</h3>
            <p id="resultModalSubtitle" class="text-xs text-rose-600">已全部按你的后缀规矩准备好</p>
          </div>
        </div>
        <button id="btnCloseModal" type="button" class="w-8 h-8 rounded-full bg-rose-100 hover:bg-rose-200 text-rose-700 font-bold">✕</button>
      </div>

      <!-- 场景 1：点击「🐾 批量盖章保存」时显示：左侧 快速保存(直存用户设定的默认存储位置) + 右侧 自定义位置(自选文件夹) -->
      <div id="batchSaveActionBar" class="mb-4 p-3 rounded-2xl bg-gradient-to-r from-rose-50 via-pink-50/70 to-amber-50/70 border-2 border-rose-200 space-y-2">
        <div class="text-xs font-extrabold text-rose-950 flex items-center justify-between flex-wrap gap-1">
          <span>📍 批量保存方式（共 <span id="batchModalCount">1</span> 份文件）：</span>
          <button id="btnQuickChangeDefaultInModal" type="button" class="text-[11px] text-rose-600 hover:text-rose-800 underline font-bold cursor-pointer">
            ⚙️ 更改默认存储位置
          </button>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <button id="btnQuickSaveSourceA" type="button" class="jelly-btn py-2.5 px-4 rounded-xl bg-gradient-to-r from-rose-500 to-pink-500 text-white text-xs font-extrabold flex flex-col items-center justify-center gap-0.5 cursor-pointer" title="零弹窗直接保存到你设定的默认存储位置，并自动记入左侧历史记录">
            <span id="quickSaveBtnTitle">⚡ 快速保存 (默认位置)</span>
            <span id="quickSaveBtnSub" class="text-[10px] opacity-90 font-normal truncate max-w-[230px]">直存默认文件夹 (零弹窗)</span>
          </button>
          <button id="btnQuickSaveBrowserB" type="button" class="hidden"><span>📥 快速保存 B</span></button>
          <button id="btnBatchCustomLocation" type="button" class="jelly-btn-secondary py-2.5 px-4 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-950 border-2 border-amber-300 text-xs font-extrabold flex flex-col items-center justify-center gap-0.5 cursor-pointer" title="打开 Windows 原生文件夹选择框自由选择保存目录（支持直达/撤回/恢复）">
            <span>📂 自定义位置</span>
            <span class="text-[10px] text-amber-800 font-normal">弹出系统窗口自选文件夹保存</span>
          </button>
        </div>
      </div>

      <!-- 场景 2：点击「🎁 打包压缩保存 (ZIP)」时显示：左侧 快速保存(默认位置) + 右侧 自定义位置 -->
      <div id="zipSaveActionBar" class="hidden mb-4 p-3 rounded-2xl bg-gradient-to-r from-amber-50 via-rose-50/70 to-pink-50/70 border-2 border-amber-300 space-y-2">
        <div class="text-xs font-extrabold text-amber-950 flex items-center justify-between">
          <span>🎁 压缩包保存方式（含盖章文件与自定义样式/图片子夹）：</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <button id="btnZipQuickBrowserB" type="button" class="jelly-btn py-2.5 px-4 rounded-xl bg-gradient-to-r from-rose-500 to-pink-500 text-white text-xs font-extrabold flex flex-col items-center justify-center gap-0.5 cursor-pointer" title="直接将打包好的 ZIP 存到默认保存目录">
            <span id="zipQuickSaveBtnTitle">📥 快速保存 (默认位置)</span>
            <span id="zipQuickSaveBtnSub" class="text-[10px] opacity-90 font-normal truncate max-w-[230px]">直存默认文件夹 (零弹窗)</span>
          </button>
          <button id="btnZipCustomLocation" type="button" class="jelly-btn-secondary py-2.5 px-4 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-950 border-2 border-amber-300 text-xs font-extrabold flex flex-col items-center justify-center gap-0.5 cursor-pointer" title="打开系统文件管理器自由选择 ZIP 保存位置">
            <span>📂 自定义位置</span>
            <span class="text-[10px] text-amber-800 font-normal">弹出系统窗口自选位置保存</span>
          </button>
        </div>
      </div>

      <!-- 选择保存方式视图下的单文件列表 -->
      <div id="resultChooseSection">
        <div class="text-[11px] font-bold text-rose-800 mb-1.5 flex items-center justify-between">
          <span>📋 已生成文件清单（点右侧「📂 单独保存」可自选路径）：</span>
        </div>
        <div id="resultFilesList" class="max-h-56 overflow-y-auto space-y-2 mb-4 pr-1"></div>

        <div class="flex items-center justify-between gap-2.5 pt-2.5 border-t border-rose-100">
          <button id="btnDownloadAllZipInModal" type="button" class="text-xs font-bold text-rose-600 hover:underline">
            🎁 切换为打包 ZIP 保存
          </button>
          <button id="btnCloseModalBottom" type="button" class="jelly-btn-secondary px-4 py-2 rounded-xl bg-rose-50 text-rose-800 border border-rose-200 text-xs font-bold">
            继续调教其他文件
          </button>
        </div>
      </div>

      <!-- ==================== 存盘回执与一键撤回专页（快速保存 & 自定义位置通用，仅保留顶栏一键全部撤回 + 下方单文件点击直达与撤回） ==================== -->
      <div id="quickSaveReceiptPanel" class="hidden space-y-3">
        <!-- 顶部汇总条：保存具体路径 + 一键全部撤回（已删去顶栏冗余直达目录和绑定更换目录按钮） -->
        <div class="p-3.5 rounded-2xl bg-emerald-50/90 border-2 border-emerald-300 space-y-2">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <div id="receiptSummaryTitle" class="text-xs sm:text-sm font-black text-emerald-950 flex items-center gap-1.5">
              <span>✅ 保存完成！共存妥 1 份文件</span>
            </div>
            <button id="btnReceiptUndoAll" type="button" class="px-3 py-1.5 rounded-xl bg-rose-100 hover:bg-rose-200 text-rose-800 border-2 border-rose-300 text-xs font-extrabold flex items-center gap-1 cursor-pointer transition shrink-0 ml-auto" title="将本次保存的全部文件一键从磁盘目录中撤回删除">
              <span>↩️ 一键全部撤回</span>
            </button>
          </div>
          <div id="receiptDirSummaryText" class="text-[11px] font-bold text-emerald-900 break-all bg-white/95 px-2.5 py-1.5 rounded-xl border border-emerald-200 font-mono">
            C:\Users\Public\Downloads
          </div>
        </div>

        <!-- 逐个文件的具体存盘地址、点击直达定位文件与单独撤回列表 -->
        <div class="text-[11px] font-extrabold text-rose-900 flex items-center justify-between px-1">
          <span>📋 存盘文件明细（点「📂 点击直达」可直接定位文件，或点「↩️ 撤回」删除）：</span>
          <span id="receiptActiveCountBadge" class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold">已存妥</span>
        </div>
        <div id="receiptFilesList" class="max-h-60 overflow-y-auto space-y-2 pr-1"></div>

        <!-- 底部确认栏：点击「✔ 确认完成」后关闭此居中窗，并在右下角弹出手动关闭的二次保险撤回窗 -->
        <div class="flex items-center justify-between gap-3 pt-3 border-t-2 border-dashed border-rose-100">
          <button id="btnReceiptBackToChoose" type="button" class="px-3 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold cursor-pointer">
            ⬅️ 返回重选保存方式
          </button>
          <button id="btnConfirmReceiptClose" type="button" class="jelly-btn px-6 py-2.5 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 text-white text-sm font-black flex items-center gap-1.5 cursor-pointer shadow-md">
            <span>✔ 确认完成 (关闭窗口)</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 隐藏兼容节点（原右下角弹窗已升级为左侧常驻「📜 历史记录 & 存储位置」） -->
  <div id="secondaryUndoPopup" class="hidden"></div>

  <!-- ==================== 弹窗 A：初次进入全屏引导对话框（选择默认保存文件夹） ==================== -->
  <div id="firstTimeSaveDirModal" class="fixed inset-0 bg-rose-950/60 backdrop-blur-md z-[80] hidden items-center justify-center p-4">
    <div class="kawaii-card max-w-2xl w-full p-6 sm:p-8 bg-white relative border-4 border-rose-300 shadow-2xl space-y-5">
      <div class="flex items-start justify-between gap-3 pb-3 border-b-2 border-dashed border-rose-200">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-rose-500 to-pink-500 text-white text-2xl flex items-center justify-center shadow-md shrink-0">
            📁
          </div>
          <div>
            <h2 class="text-lg sm:text-xl font-black text-rose-950">欢迎使用西西盖章局！请先选择「默认保存位置」</h2>
            <p class="text-xs text-rose-600 font-semibold mt-0.5">
              选好后，日常点击「⚡ 快速保存」将直接零弹窗存到该位置；你随时可在左侧「📜 历史记录 &amp; 存储位置」中更换！
            </p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
        <!-- 选项 1：自己浏览挑选任意文件夹 -->
        <button
          id="btnFirstPickCustomDir"
          type="button"
          class="p-4 rounded-2xl bg-gradient-to-br from-rose-500 via-pink-500 to-rose-600 hover:from-rose-600 hover:to-pink-600 text-white text-left flex flex-col justify-between gap-2 shadow-lg border-2 border-rose-700 cursor-pointer transition transform hover:-translate-y-0.5"
        >
          <div class="flex items-center justify-between w-full">
            <span class="text-sm sm:text-base font-black">📂 1. 浏览自选文件夹</span>
            <span class="px-2 py-0.5 rounded-full bg-white/25 text-[10px] font-black shrink-0">自由指定</span>
          </div>
          <p class="text-xs text-white/90 leading-relaxed">
            唤起 Windows 原生文件夹选择窗口，自由指定桌面、D盘或任意专属文件夹作为默认保存处。
          </p>
          <div class="text-[11px] font-mono bg-black/15 px-2.5 py-1 rounded-lg truncate w-full">
            点击打开文件夹选择器 ➔
          </div>
        </button>

        <!-- 选项 2：同级「默认导出」子文件夹 -->
        <button
          id="btnFirstUsePluginExport"
          type="button"
          class="p-4 rounded-2xl bg-amber-50 hover:bg-amber-100 text-amber-950 text-left flex flex-col justify-between gap-2 border-2 border-amber-300 shadow-sm cursor-pointer transition transform hover:-translate-y-0.5"
        >
          <div class="flex items-center justify-between w-full">
            <span class="text-sm sm:text-base font-black text-amber-950">📁 2. 同级「默认导出」夹</span>
            <span class="px-2 py-0.5 rounded-full bg-amber-200 text-amber-900 text-[10px] font-black shrink-0">整洁便携</span>
          </div>
          <p class="text-xs text-amber-800 leading-relaxed">
            自动保存在本插件同级目录下的「默认导出」文件夹内，随工具包一起移动最整齐。
          </p>
          <div id="firstModalExportPathPreview" class="text-[11px] font-mono text-amber-900 bg-white/90 px-2.5 py-1 rounded-lg border border-amber-200 truncate w-full">
            西西盖章局\默认导出
          </div>
        </button>

        <!-- 选项 3：各文件原所在目录 -->
        <button
          id="btnFirstUseSourceDir"
          type="button"
          class="p-4 rounded-2xl bg-indigo-50/70 hover:bg-indigo-100/80 text-indigo-950 text-left flex flex-col justify-between gap-2 border-2 border-indigo-200 shadow-sm cursor-pointer transition transform hover:-translate-y-0.5"
        >
          <div class="flex items-center justify-between w-full">
            <span class="text-sm sm:text-base font-black text-indigo-950">📍 3. 各文件原所在目录</span>
            <span class="px-2 py-0.5 rounded-full bg-indigo-200 text-indigo-800 text-[10px] font-black shrink-0">就地存回</span>
          </div>
          <p class="text-xs text-indigo-800 leading-relaxed">
            每个 PDF / Word 从哪个文件夹挑进来的，盖完章就自动存回它原本所在的文件夹旁。
          </p>
          <div class="text-[11px] font-mono text-indigo-800 bg-white/90 px-2.5 py-1 rounded-lg border border-indigo-200 truncate w-full">
            自动跟随各源文件所在目录
          </div>
        </button>
      </div>

      <div class="p-3 rounded-2xl bg-emerald-50/80 border border-emerald-200 flex items-center justify-between gap-2 flex-wrap text-xs text-emerald-900">
        <span>✨ <b>同级缓存已就绪：</b>插件参数、历史记录、自定义样式与图片均自动保存在同级固定子文件夹中。</span>
      </div>
    </div>
  </div>

  <!-- ==================== 弹窗 B：左侧常驻「📜 历史记录 & 存储位置」管理中心 ==================== -->
  <div id="historyAndStorageModal" class="fixed inset-0 bg-rose-950/45 backdrop-blur-sm z-[75] hidden items-center justify-center p-4">
    <div class="kawaii-card max-w-4xl w-full p-5 sm:p-6 bg-white relative flex flex-col max-h-[90vh]">
      <!-- 顶部标题栏 -->
      <div class="flex items-center justify-between pb-3 border-b-2 border-dashed border-rose-100 mb-3.5 shrink-0">
        <div class="flex items-center gap-2.5">
          <span class="w-9 h-9 rounded-xl bg-rose-500 text-white text-lg flex items-center justify-center shadow-sm">📜</span>
          <div>
            <h3 class="text-base sm:text-lg font-black text-rose-950">历史记录 &amp; 默认存储位置</h3>
            <p class="text-xs text-rose-500 font-medium">
              所有盖章保存记录默认永久保留（存于同级「历史缓存」子夹），直至你手动删去记录
            </p>
          </div>
        </div>
        <button id="btnCloseHistoryModal" type="button" class="w-8 h-8 rounded-full bg-rose-100 hover:bg-rose-200 text-rose-700 font-bold cursor-pointer">✕</button>
      </div>

      <!-- 模块 1：默认存储位置设置条 -->
      <div class="p-3.5 rounded-2xl bg-gradient-to-r from-rose-50 via-amber-50/60 to-pink-50/60 border-2 border-rose-200 mb-4 shrink-0 space-y-2.5">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-black text-rose-950">📍 当前默认存储位置：</span>
            <span id="historyModalModeBadge" class="px-2 py-0.5 rounded-full bg-rose-500 text-white text-[10px] font-extrabold">
              同级「默认导出」子文件夹
            </span>
          </div>
          <div class="flex items-center gap-1.5 flex-wrap">
            <button id="btnChangeDefaultDirCustom" type="button" class="click-chip px-2.5 py-1 rounded-xl text-xs font-extrabold">
              📂 浏览自选默认文件夹
            </button>
            <button id="btnChangeDefaultDirExport" type="button" class="click-chip px-2.5 py-1 rounded-xl text-[11px] font-bold">
              📁 设为「默认导出」子夹
            </button>
            <button id="btnChangeDefaultDirSource" type="button" class="click-chip px-2.5 py-1 rounded-xl text-[11px] font-bold">
              📍 设为原文件目录
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between gap-2 bg-white px-3 py-2 rounded-xl border border-rose-200">
          <div id="historyModalDefaultDirPath" class="text-xs font-mono font-bold text-emerald-900 break-all">
            D:\西西工具包\西西盖章局\默认导出
          </div>
          <button
            id="btnOpenDefaultDirInExplorer"
            type="button"
            class="px-3 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-900 border border-emerald-300 text-xs font-extrabold shrink-0 cursor-pointer"
            title="在真实 Windows 资源管理器中打开当前默认保存文件夹"
          >
            🚀 打开默认文件夹
          </button>
        </div>
      </div>

      <!-- 模块 2：历史保存记录列表（对齐提供：直达 / 撤回 / 恢复 / 删去） -->
      <div class="flex items-center justify-between flex-wrap gap-2 mb-2 px-1 shrink-0">
        <div class="flex items-center gap-2">
          <span class="text-xs font-black text-rose-950">📋 历史保存文件清单</span>
          <span id="historyModalTotalBadge" class="px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 border border-rose-200 text-[11px] font-extrabold">
            共 0 条
          </span>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="btnHistoryRevokeAll"
            type="button"
            class="px-2.5 py-1 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-[11px] font-extrabold cursor-pointer transition"
            title="将列表中所有处于「已存妥」状态的文件从磁盘撤回"
          >
            ↩️ 一键全部撤回
          </button>
          <button
            id="btnHistoryClearAll"
            type="button"
            class="px-2.5 py-1 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 text-[11px] font-extrabold cursor-pointer transition"
            title="清空所有历史记录与备份缓存（不会删除磁盘上已保存的文件）"
          >
            🗑️ 清空历史记录
          </button>
        </div>
      </div>

      <!-- 列表表头（严格网格列对齐） -->
      <div class="hidden sm:grid sm:grid-cols-12 gap-2 px-3 py-1.5 rounded-t-xl bg-rose-100/70 border border-rose-200 text-[11px] font-extrabold text-rose-900 shrink-0">
        <div class="col-span-7">文件名称 &amp; 具体磁盘保存位置</div>
        <div class="col-span-5 text-right pr-2">对齐操作（直达资源管理器 / 撤回 / 恢复 / 删去记录）</div>
      </div>

      <div id="historyRecordsListContainer" class="flex-1 min-h-[220px] max-h-[46vh] overflow-y-auto space-y-2 p-2 rounded-b-xl bg-rose-50/40 border border-t-0 border-rose-200">
        <!-- JS 动态渲染 -->
      </div>

      <div class="flex items-center justify-between pt-3 mt-3 border-t border-rose-100 shrink-0 text-[11px] text-rose-500">
        <span>💡 提示：哪怕勾选了「🚫 无后缀」覆盖原文件，点击「↩️ 撤回」也会自动从缓存帮你还原最初未盖章的原文件！</span>
        <button id="btnCloseHistoryModalBottom" type="button" class="jelly-btn-secondary px-5 py-1.5 rounded-xl bg-rose-50 text-rose-900 border border-rose-200 text-xs font-extrabold cursor-pointer">
          关闭窗口
        </button>
      </div>
    </div>
  </div>

  <!-- 右上角轻提示 Toast（避开右下角二次保险弹窗） -->
  <div id="toastContainer" class="fixed top-5 right-5 z-[70] flex flex-col gap-2"></div>

  <script>
    if (window.pdfjsLib) {
      window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }

    const CODE_DEFAULT_WATERMARK_TEXT = '西西专属·严禁外传';
    const CODE_DEFAULT_FILENAME_SUFFIX = '-西西专属水印版';

    // 内置小猫矢量图案
    const MASCOT_SVG_SOURCE = (window.KITTY_PRESETS && window.KITTY_PRESETS.mascotSvg) || `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFE4E8"/><stop offset="100%" stop-color="#FDE68A"/>
    </linearGradient>
    <linearGradient id="stampGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FB7185"/><stop offset="100%" stop-color="#E11D48"/>
    </linearGradient>
  </defs>
  <rect width="200" height="200" rx="36" fill="url(#bgGrad)"/>
  <g>
    <path d="M145 148 Q175 142 172 118 Q169 102 155 112" fill="none" stroke="#57363B" stroke-width="8" stroke-linecap="round"/>
    <path d="M54 84 L46 38 Q72 42 86 54 Q100 50 114 54 Q128 42 154 38 L146 84 Q162 104 148 130 L146 158 Q100 168 54 158 L52 130 Q38 104 54 84 Z" fill="#FFF9F5" stroke="#57363B" stroke-width="4.5" stroke-linejoin="round"/>
    <path d="M55 72 L52 46 Q68 49 78 58 Z" fill="#FDA4AF"/>
    <path d="M145 72 L148 46 Q132 49 122 58 Z" fill="#FDA4AF"/>
    <ellipse cx="76" cy="95" rx="10.5" ry="11.5" fill="#4A2C32"/><circle cx="73" cy="91" r="4" fill="#FFFFFF"/>
    <ellipse cx="124" cy="95" rx="10.5" ry="11.5" fill="#4A2C32"/><circle cx="121" cy="91" r="4" fill="#FFFFFF"/>
    <ellipse cx="58" cy="106" rx="8" ry="4.5" fill="#FB7185" opacity="0.55"/>
    <ellipse cx="142" cy="106" rx="8" ry="4.5" fill="#FB7185" opacity="0.55"/>
    <polygon points="100,101 96,106 104,106" fill="#F43F5E"/>
    <path d="M90 110 Q95 116 100 109 Q105 116 110 110" fill="none" stroke="#57363B" stroke-width="3.5" stroke-linecap="round"/>
    <g transform="translate(100, 142) rotate(-14)">
      <path d="M-12 -32 C-16 -48, 16 -48, 12 -32 L16 -8 L-16 -8 Z" fill="url(#stampGrad)" stroke="#57363B" stroke-width="4" stroke-linejoin="round"/>
      <rect x="-34" y="-10" width="68" height="26" rx="8" fill="#FDA4AF" stroke="#57363B" stroke-width="4"/>
      <rect x="-30" y="6" width="60" height="14" rx="5" fill="#E11D48" stroke="#57363B" stroke-width="3.5"/>
      <circle cx="0" cy="-26" r="4" fill="#FFE4E8"/>
    </g>
    <ellipse cx="74" cy="132" rx="12" ry="9" transform="rotate(15 74 132)" fill="#FFF9F5" stroke="#57363B" stroke-width="4"/>
    <ellipse cx="122" cy="128" rx="12" ry="9" transform="rotate(-15 122 128)" fill="#FFF9F5" stroke="#57363B" stroke-width="4"/>
  </g>
</svg>`;

    function createBuiltinStampImage(svgStr) {
      const img = new Image();
      img.src = 'data:image/svg+xml;utf8,' + encodeURIComponent(svgStr);
      return img;
    }

    const builtinStampCache = new Map();
    const builtinMascotImg = createBuiltinStampImage(MASCOT_SVG_SOURCE);

    function getTintedBuiltinStamp(type, colorHex) {
      const hex = (colorHex || '#F43F5E').trim();
      const key = `${type}:${hex}`;
      if (builtinStampCache.has(key)) return builtinStampCache.get(key);
      let svg = '';
      if (type === 'paw') {
        svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
          <circle cx="60" cy="60" r="54" fill="none" stroke="${hex}" stroke-width="5" stroke-dasharray="8 5"/>
          <circle cx="60" cy="60" r="46" fill="${hex}" fill-opacity="0.14" stroke="${hex}" stroke-width="2.5"/>
          <ellipse cx="60" cy="72" rx="20" ry="16" fill="${hex}"/>
          <ellipse cx="36" cy="48" rx="8" ry="11" transform="rotate(-20 36 48)" fill="${hex}"/>
          <ellipse cx="51" cy="40" rx="8" ry="11" transform="rotate(-6 51 40)" fill="${hex}"/>
          <ellipse cx="69" cy="40" rx="8" ry="11" transform="rotate(6 69 40)" fill="${hex}"/>
          <ellipse cx="84" cy="48" rx="8" ry="11" transform="rotate(20 84 48)" fill="${hex}"/>
        </svg>`;
      } else if (type === 'sakura') {
        svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="120" height="120">
          <circle cx="60" cy="60" r="52" fill="none" stroke="${hex}" stroke-width="4"/>
          <g transform="translate(60,60)" fill="${hex}" fill-opacity="0.35" stroke="${hex}" stroke-width="2.5">
            <path d="M0 -8 C-12 -28, -22 -42, 0 -46 C22 -42, 12 -28, 0 -8 Z"/>
            <path d="M0 -8 C-12 -28, -22 -42, 0 -46 C22 -42, 12 -28, 0 -8 Z" transform="rotate(72)"/>
            <path d="M0 -8 C-12 -28, -22 -42, 0 -46 C22 -42, 12 -28, 0 -8 Z" transform="rotate(144)"/>
            <path d="M0 -8 C-12 -28, -22 -42, 0 -46 C22 -42, 12 -28, 0 -8 Z" transform="rotate(216)"/>
            <path d="M0 -8 C-12 -28, -22 -42, 0 -46 C22 -42, 12 -28, 0 -8 Z" transform="rotate(288)"/>
            <circle cx="0" cy="0" r="9" fill="#FDE68A" stroke="${hex}" stroke-width="2.5"/>
          </g>
        </svg>`;
      }
      const img = createBuiltinStampImage(svg);
      img.onload = () => { renderWatermarkOverlay(); };
      builtinStampCache.set(key, img);
      return img;
    }

    // 动态分组配色表（支持 A组 ~ H组 + 99号独立不平滑格）
    const GROUP_PALETTE = [
      null,
      { id: 1, name: '🍓 A组', short: 'A', bg: 'linear-gradient(135deg, #FFE4E8 0%, #FECDD3 100%)', border: '#FB7185', text: '#E11D48', fillRgba: 'rgba(244, 63, 94, 0.055)', strokeRgba: 'rgba(244, 63, 94, 0.45)', dot: '#F43F5E' },
      { id: 2, name: '🍇 B组', short: 'B', bg: 'linear-gradient(135deg, #F3E8FF 0%, #E9D5FF 100%)', border: '#A855F7', text: '#7E22CE', fillRgba: 'rgba(168, 85, 247, 0.06)', strokeRgba: 'rgba(168, 85, 247, 0.48)', dot: '#9333EA' },
      { id: 3, name: '🍊 C组', short: 'C', bg: 'linear-gradient(135deg, #FFEDD5 0%, #FED7AA 100%)', border: '#F97316', text: '#C2410C', fillRgba: 'rgba(249, 115, 22, 0.06)', strokeRgba: 'rgba(249, 115, 22, 0.48)', dot: '#EA580C' },
      { id: 4, name: '🍋 D组', short: 'D', bg: 'linear-gradient(135deg, #FEF9C3 0%, #FEF08A 100%)', border: '#EAB308', text: '#A16207', fillRgba: 'rgba(234, 179, 8, 0.07)', strokeRgba: 'rgba(202, 138, 4, 0.48)', dot: '#CA8A04' },
      { id: 5, name: '🍏 E组', short: 'E', bg: 'linear-gradient(135deg, #DCFCE7 0%, #BBF7D0 100%)', border: '#22C55E', text: '#15803D', fillRgba: 'rgba(34, 197, 94, 0.06)', strokeRgba: 'rgba(22, 163, 74, 0.48)', dot: '#16A34A' },
      { id: 6, name: '💎 F组', short: 'F', bg: 'linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%)', border: '#3B82F6', text: '#1D4ED8', fillRgba: 'rgba(59, 130, 246, 0.06)', strokeRgba: 'rgba(37, 99, 235, 0.48)', dot: '#2563EB' },
      { id: 7, name: '🌸 G组', short: 'G', bg: 'linear-gradient(135deg, #FCE7F3 0%, #FBCFE8 100%)', border: '#EC4899', text: '#BE185D', fillRgba: 'rgba(236, 72, 153, 0.06)', strokeRgba: 'rgba(219, 39, 119, 0.48)', dot: '#DB2777' },
      { id: 8, name: '🐳 H组', short: 'H', bg: 'linear-gradient(135deg, #E0E7FF 0%, #C7D2FE 100%)', border: '#6366F1', text: '#4338CA', fillRgba: 'rgba(99, 102, 241, 0.06)', strokeRgba: 'rgba(79, 70, 229, 0.48)', dot: '#4F46E5' }
    ];
    const INDEPENDENT_GROUP_VAL = 99;

    // 3 档常用对称网格定义：3×3 / 6×9 / 9×9（其余任意 x*y 走自定义网格）
    const GRID_SPECS = {
      '3x3': { cols: 3, rows: 3, label: '3×3' },
      '6x9': { cols: 6, rows: 9, label: '6×9' },
      '9x9': { cols: 9, rows: 9, label: '9×9' }
    };

    // 精简 3 款核心平滑/倒角样式元数据（a.顶点直连 / b.内凹倒角 / c.内外双圆角）
    const SMOOTH_STYLE_META = {
      slope:    { id: 'slope',    icon: '📐', code: 'a', short: 'a. 顶点直连',   label: '📐 a. 顶点直连' },
      concave:  { id: 'concave',  icon: '🌙', code: 'b', short: 'b. 内凹倒角',   label: '🌙 b. 内凹倒角' },
      allround: { id: 'allround', icon: '🫧', code: 'c', short: 'c. 内外双圆角', label: '🫧 c. 内外双圆角' }
    };

    function createDefaultStyleConfig() {
      return {
        watermarkText: '',
        defaultWatermarkText: CODE_DEFAULT_WATERMARK_TEXT,
        enableText: true,
        hollowText: false,
        enableStamp: false,
        stampType: 'paw',
        stampScale: 100,
        customStampImageEl: null,
        customStampName: '',
        fontFamily: "'ZCOOL KuaiLe', 'YouYuan', 'PingFang SC', sans-serif",
        color: '#F43F5E',
        colorName: '草莓',
        fontSize: 28,
        opacity: 20,
        angle: -30,
        gap: 150,
        offsetX: 0,
        offsetY: 0,
        rowGapScale: 100,
        staggerRow: true,
        simpleRecActive: 'fullscreen', // 'fullscreen' | 'centerbig' | 'headerfooter' | ''
        coverageMode: 'grid', // 'grid' | 'box'
        gridKey: '3x3',       // '3x3' | '3x6' | '6x9' | '9x9' | '9x12'
        gridCols: 3,
        gridRows: 3,
        groupCount: 1,
        gridCells: new Array(9).fill(1),
        smartMergeBand: true,
        smoothStyle: 'concave', // 精选 3 款: 'slope' (①顶点直连) | 'concave' (②内凹圆弧) | 'allround' (③内外双圆角)
        perGroupSmooth: true,   // 允许 A/B/C/D 各组独立指定不同倒角款式
        groupSmoothStyles: { 1: 'concave', 2: 'slope', 3: 'allround', 4: 'concave', 5: 'slope', 6: 'allround', 7: 'concave', 8: 'slope' },
        smoothRadius: 90,     // 倒角平滑角度开放至 0°~180°
        singlePerZone: false,
        boxTop: 14,
        boxBottom: 14,
        boxLeft: 10,
        boxRight: 10,
        boxInvert: false,
        snapGrid: false,
        symLock: false,
        pageRangeMode: 'all',
        customPageRange: ''
      };
    }

    function cloneStyleConfig(cfg) {
      const cols = cfg.gridCols || 3;
      const rows = cfg.gridRows || 3;
      return {
        ...cfg,
        gridCells: [...(cfg.gridCells || new Array(cols * rows).fill(1))],
        groupSmoothStyles: { ...(cfg.groupSmoothStyles || { 1: cfg.smoothStyle || 'concave' }) }
      };
    }

    // 支持任意 (oldCols × oldRows) 切换到 (newCols × newRows) 的二维重采样
    function resampleGridRect(oldCells, oldCols, oldRows, newCols, newRows) {
      if (oldCols === newCols && oldRows === newRows && Array.isArray(oldCells) && oldCells.length === newCols * newRows) {
        return [...oldCells];
      }
      const next = new Array(newCols * newRows).fill(0);
      for (let r = 0; r < newRows; r++) {
        for (let c = 0; c < newCols; c++) {
          const srcR = Math.min(oldRows - 1, Math.floor(((r + 0.5) / newRows) * oldRows));
          const srcC = Math.min(oldCols - 1, Math.floor(((c + 0.5) / newCols) * oldCols));
          next[r * newCols + c] = (oldCells && oldCells[srcR * oldCols + srcC]) || 0;
        }
      }
      return next;
    }

    const PROFILE_LABELS = ['方案 ①', '方案 ②', '方案 ③'];

    // 全局状态（问题8：高级版贴纸槽初始清空，只留用户自命名保存的位置，并支持存入文件夹 JSON）
    const state = {
      uiMode: 'simple',
